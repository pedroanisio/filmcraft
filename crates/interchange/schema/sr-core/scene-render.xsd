<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.7.0">
  <xs:annotation>
    <xs:documentation>
      scene-render scene format 1.1. This schema is the interchange contract
      shared by every scene-render engine. Its
      canonical copy is sr-core/schema/; it changes only through an accepted
      SREP (sr-core/srep/). Every document valid under 1.0 is valid
      under 1.1 (with one exception: colour channels above 1, which 1.0 matched
      by accident, are now rejected). New sections, elements and asset kinds
      require version="1.1"; new attributes on 1.0 elements are accepted in both
      versions. The companion Schematron rules (scene-render.sch) enforce the
      version gate and the cross-field rules XSD 1.0 cannot express.

      Conventions used everywhere:
        time      seconds (xs:double) on the composition timeline unless stated;
        space     2D pixels, origin top-left, +x right, +y down;
        angles    degrees, positive = clockwise on screen;
        physics   metres, +y up, mapped to pixels by physics/@pixelsPerMeter;
        colour    straight (non-premultiplied) alpha in the working space;
        lengths   a lengthType accepts pixels or %, vw, vh, vmin, vmax
                  (percent is relative to the parent box; vw/vh to the output frame).
      Determinism: every random, noise, wiggle, generated or transcribed value is
      a pure function of project/@seed, the element's own seed and the frame
      time. Anything that needs an external service is resolved from a declared
      cache whose content hash is part of the document.
    </xs:documentation>
  </xs:annotation>

  <!-- ===================================================== numeric types -->
  <xs:simpleType name="positiveDecimal">
    <xs:restriction base="xs:double"><xs:minExclusive value="0"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="unitDecimal">
    <xs:restriction base="xs:double"><xs:minInclusive value="0"/><xs:maxInclusive value="1"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="unitTripleType">
    <xs:annotation><xs:documentation>Three numbers in [0, 1] (SREP 71).</xs:documentation></xs:annotation>
    <xs:restriction><xs:simpleType><xs:list itemType="unitDecimal"/></xs:simpleType><xs:length value="3"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="signedUnitDecimal">
    <xs:restriction base="xs:double"><xs:minInclusive value="-1"/><xs:maxInclusive value="1"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="percentType">
    <xs:restriction base="xs:double"><xs:minInclusive value="-100"/><xs:maxInclusive value="100"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="durationType">
    <xs:restriction base="xs:double"><xs:minExclusive value="0"/><xs:maxInclusive value="1000000"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="lightIntensityType">
    <xs:restriction base="xs:double"><xs:minInclusive value="0"/><xs:maxInclusive value="1000000"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="spotAngleType">
    <xs:restriction base="xs:double"><xs:minInclusive value="0.5"/><xs:maxInclusive value="179"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="effectOffsetType">
    <xs:restriction base="xs:double"><xs:minInclusive value="-100000"/><xs:maxInclusive value="100000"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="effectRadiusType">
    <xs:restriction base="xs:double"><xs:minInclusive value="0"/><xs:maxInclusive value="4096"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="nonNegativeDecimal">
    <xs:restriction base="xs:double"><xs:minInclusive value="0"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="decibelType">
    <xs:restriction base="xs:double"><xs:minInclusive value="-120"/><xs:maxInclusive value="24"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="lufsType">
    <xs:restriction base="xs:double"><xs:minInclusive value="-70"/><xs:maxInclusive value="0"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="kelvinType">
    <xs:restriction base="xs:double"><xs:minInclusive value="1000"/><xs:maxInclusive value="40000"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="gridSizeType">
    <xs:restriction base="xs:positiveInteger"><xs:minInclusive value="2"/><xs:maxInclusive value="16"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fpsType">
    <xs:restriction base="xs:string"><xs:pattern value="[1-9][0-9]*(/[1-9][0-9]*)?"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="aspectType">
    <xs:restriction base="xs:string"><xs:pattern value="[1-9][0-9]*:[1-9][0-9]*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="sha256Type">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9a-f]{64}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="timecodeType">
    <xs:restriction base="xs:string"><xs:pattern value="[0-9]{2}:[0-5][0-9]:[0-5][0-9][:;][0-9]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="languageTagType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="35"/><xs:pattern value="[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="numberListType">
    <xs:list itemType="xs:double"/>
  </xs:simpleType>
  <xs:simpleType name="pointType">
    <xs:annotation><xs:documentation>"x,y" pair, e.g. a bezier handle or tangent.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="-?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?,-?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="connectorAnchorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/><xs:enumeration value="center"/>
      <xs:enumeration value="top"/><xs:enumeration value="right"/>
      <xs:enumeration value="bottom"/><xs:enumeration value="left"/>
      <xs:enumeration value="top-left"/><xs:enumeration value="top-right"/>
      <xs:enumeration value="bottom-right"/><xs:enumeration value="bottom-left"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="pointListType">
    <xs:list itemType="pointType"/>
  </xs:simpleType>

  <!-- ===================================================== length types -->
  <xs:simpleType name="relativeLength">
    <xs:restriction base="xs:string"><xs:pattern value="-?([0-9]+(\.[0-9]*)?|\.[0-9]+)(%|vw|vh|vmin|vmax)"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveRelativeLength">
    <xs:restriction base="xs:string"><xs:pattern value="([0-9]*[1-9][0-9]*(\.[0-9]*)?|[0-9]*\.[0-9]*[1-9][0-9]*)(%|vw|vh|vmin|vmax)"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="lengthType">
    <xs:union memberTypes="xs:double relativeLength"/>
  </xs:simpleType>
  <xs:simpleType name="positiveLengthType">
    <xs:union memberTypes="positiveDecimal positiveRelativeLength"/>
  </xs:simpleType>

  <!-- ===================================================== colour and paint -->
  <xs:simpleType name="colorType">
    <xs:annotation><xs:documentation>
      #RRGGBB, #RRGGBBAA, 3-4 normalised channels in [0,1] ("1,0.5,0,1"), or a
      style token reference var(--name) resolved from styles/token. The shorthand #RGB and #RGBA is not accepted.
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)(,(0(\.[0-9]+)?|1(\.0+)?|\.[0-9]+)){2,3}|var\(--[A-Za-z0-9_\-]+\)"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="paintRefType">
    <xs:restriction base="xs:string"><xs:pattern value="url\(#[A-Za-z_][A-Za-z0-9_.\-]*\)"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="colorListType">
    <xs:annotation><xs:documentation>Whitespace-separated colours, as a palette.</xs:documentation></xs:annotation>
    <xs:list itemType="colorType"/>
  </xs:simpleType>
  <xs:simpleType name="latitudeType">
    <xs:annotation><xs:documentation>Degrees north, in [-90, 90].</xs:documentation></xs:annotation>
    <xs:restriction base="xs:double"><xs:minInclusive value="-90"/><xs:maxInclusive value="90"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="longitudeType">
    <xs:annotation><xs:documentation>Degrees east, in [-180, 180].</xs:documentation></xs:annotation>
    <xs:restriction base="xs:double"><xs:minInclusive value="-180"/><xs:maxInclusive value="180"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="geoPointsType">
    <xs:annotation><xs:documentation>"lon,lat lon,lat ..." in degrees: at least two points.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*[\-+]?[0-9]*\.?[0-9]+([eE][\-+]?[0-9]+)?,[\-+]?[0-9]*\.?[0-9]+([eE][\-+]?[0-9]+)?(\s+[\-+]?[0-9]*\.?[0-9]+([eE][\-+]?[0-9]+)?,[\-+]?[0-9]*\.?[0-9]+([eE][\-+]?[0-9]+)?)+\s*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="paintType">
    <xs:annotation><xs:documentation>A colour or url(#id) of a paints/* gradient, pattern or noise.</xs:documentation></xs:annotation>
    <xs:union memberTypes="colorType paintRefType"/>
  </xs:simpleType>
  <xs:simpleType name="colorSpaceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="srgb"/><xs:enumeration value="linear-srgb"/>
      <xs:enumeration value="rec709"/><xs:enumeration value="display-p3"/>
      <xs:enumeration value="dci-p3"/><xs:enumeration value="rec2020"/>
      <xs:enumeration value="acescg"/><xs:enumeration value="aces2065-1"/>
      <xs:enumeration value="acescct"/><xs:enumeration value="xyz-d65"/>
      <xs:enumeration value="raw"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="colorProfileType">
    <xs:annotation><xs:documentation>
      Which colour description of a still image file applies. embedded: an ICC profile
      (matrix/TRC) or H.273 code points (HEIF nclx, ICC cicp) in the file take precedence over
      colorSpace and transfer, which apply to files without one. declared: colorSpace and
      transfer always apply (data textures, mis-tagged files).
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="embedded"/><xs:enumeration value="declared"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="transferType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/><xs:enumeration value="srgb"/>
      <xs:enumeration value="linear"/><xs:enumeration value="bt1886"/>
      <xs:enumeration value="gamma22"/><xs:enumeration value="gamma26"/>
      <xs:enumeration value="pq"/><xs:enumeration value="hlg"/>
      <xs:enumeration value="slog3"/><xs:enumeration value="logc3"/>
      <xs:enumeration value="logc4"/><xs:enumeration value="vlog"/>
      <xs:enumeration value="clog3"/><xs:enumeration value="redlog3g10"/>
      <xs:enumeration value="flog2"/><xs:enumeration value="nlog"/>
      <xs:enumeration value="acescc"/><xs:enumeration value="acescct"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="alphaModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="auto"/><xs:enumeration value="none"/>
      <xs:enumeration value="straight"/><xs:enumeration value="premultiplied"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================================================== enumerations -->
  <xs:simpleType name="blendType">
    <xs:annotation><xs:documentation>
      The 1.0 modes plus the full separable/non-separable set used by After
      Effects, Lottie, SVG/CSS compositing and Synfig. Stencil and silhouette
      modes cut through every layer below within the isolated parent buffer.
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/><xs:enumeration value="dissolve"/>
      <xs:enumeration value="add"/><xs:enumeration value="plus-lighter"/>
      <xs:enumeration value="multiply"/><xs:enumeration value="screen"/>
      <xs:enumeration value="overlay"/><xs:enumeration value="difference"/>
      <xs:enumeration value="exclusion"/><xs:enumeration value="subtract"/>
      <xs:enumeration value="divide"/><xs:enumeration value="darken"/>
      <xs:enumeration value="lighten"/><xs:enumeration value="darker-color"/>
      <xs:enumeration value="lighter-color"/><xs:enumeration value="color-dodge"/>
      <xs:enumeration value="color-burn"/><xs:enumeration value="linear-dodge"/>
      <xs:enumeration value="linear-burn"/><xs:enumeration value="soft-light"/>
      <xs:enumeration value="hard-light"/><xs:enumeration value="linear-light"/>
      <xs:enumeration value="vivid-light"/><xs:enumeration value="pin-light"/>
      <xs:enumeration value="hard-mix"/><xs:enumeration value="hue"/>
      <xs:enumeration value="saturation"/><xs:enumeration value="color"/>
      <xs:enumeration value="luminosity"/><xs:enumeration value="stencil-alpha"/>
      <xs:enumeration value="stencil-luma"/><xs:enumeration value="silhouette-alpha"/>
      <xs:enumeration value="silhouette-luma"/><xs:enumeration value="alpha-add"/>
      <xs:enumeration value="behind"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="curveType">
    <xs:annotation><xs:documentation>
      1.0 curves plus hold (alias of step), steps (uses key/@steps), catmull-rom,
      tcb (key/@tension, @continuity, @bias), spring (key/@stiffness, @damping,
      @mass) and the Penner family. cubic-bezier uses key/@bezier "x1,y1,x2,y2"
      or key/@easeOut + next key/@easeIn handles.
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="step"/><xs:enumeration value="hold"/>
      <xs:enumeration value="steps"/><xs:enumeration value="linear"/>
      <xs:enumeration value="ease-in"/><xs:enumeration value="ease-out"/>
      <xs:enumeration value="ease-in-out"/><xs:enumeration value="cubic-bezier"/>
      <xs:enumeration value="catmull-rom"/><xs:enumeration value="tcb"/>
      <xs:enumeration value="spring"/>
      <xs:enumeration value="sine-in"/><xs:enumeration value="sine-out"/><xs:enumeration value="sine-in-out"/>
      <xs:enumeration value="quad-in"/><xs:enumeration value="quad-out"/><xs:enumeration value="quad-in-out"/>
      <xs:enumeration value="cubic-in"/><xs:enumeration value="cubic-out"/><xs:enumeration value="cubic-in-out"/>
      <xs:enumeration value="quart-in"/><xs:enumeration value="quart-out"/><xs:enumeration value="quart-in-out"/>
      <xs:enumeration value="quint-in"/><xs:enumeration value="quint-out"/><xs:enumeration value="quint-in-out"/>
      <xs:enumeration value="expo-in"/><xs:enumeration value="expo-out"/><xs:enumeration value="expo-in-out"/>
      <xs:enumeration value="circ-in"/><xs:enumeration value="circ-out"/><xs:enumeration value="circ-in-out"/>
      <xs:enumeration value="back-in"/><xs:enumeration value="back-out"/><xs:enumeration value="back-in-out"/>
      <xs:enumeration value="elastic-in"/><xs:enumeration value="elastic-out"/><xs:enumeration value="elastic-in-out"/>
      <xs:enumeration value="bounce-in"/><xs:enumeration value="bounce-out"/><xs:enumeration value="bounce-in-out"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="extrapolationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="hold"/><xs:enumeration value="linear"/>
      <xs:enumeration value="loop"/><xs:enumeration value="ping-pong"/>
      <xs:enumeration value="offset"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/><xs:enumeration value="contain"/>
      <xs:enumeration value="cover"/><xs:enumeration value="fill"/>
      <xs:enumeration value="scale-down"/><xs:enumeration value="contain-blur"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="matteModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="alpha"/><xs:enumeration value="alpha-inverted"/>
      <xs:enumeration value="luma"/><xs:enumeration value="luma-inverted"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="triStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="inherit"/><xs:enumeration value="on"/><xs:enumeration value="off"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="strokeCapType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="butt"/><xs:enumeration value="round"/><xs:enumeration value="square"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="strokeJoinType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="miter"/><xs:enumeration value="round"/><xs:enumeration value="bevel"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="strokePositionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="center"/><xs:enumeration value="inside"/><xs:enumeration value="outside"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fillRuleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nonzero"/><xs:enumeration value="evenodd"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="expressionString">
    <xs:annotation><xs:documentation>
      A deterministic expression in the scene-render expression language (see
      expressionType). Used by @condition attributes and expression elements.
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:maxLength value="65536"/></xs:restriction>
  </xs:simpleType>

  <!-- ===================================================== shared attribute groups -->
  <xs:attributeGroup name="assetProvenance">
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 digest of the source file, in hex. A local file is hashed when the scene is validated and a different digest is an error; a remote URL is not checked.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="license" type="xs:string"/>
    <xs:attribute name="credit" type="xs:string"/>
    <xs:attribute name="proxy" type="xs:anyURI"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="strokeStyle">
    <xs:attribute name="strokeCap" type="strokeCapType" default="butt">
      <xs:annotation><xs:documentation>Shape of the ends of open stroke segments and dashes: butt (flat, default), round, or square (extends half the stroke width past the end).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeJoin" type="strokeJoinType" default="miter">
      <xs:annotation><xs:documentation>Shape of stroke corners: miter (sharp, default), round, or bevel (cut flat).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="miterLimit" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Longest allowed miter, as a ratio of miter length to stroke width; sharper corners are bevelled. Defaults to 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dash" type="numberListType">
      <xs:annotation><xs:documentation>Dash pattern as alternating dash and gap lengths in scene units; an odd count is repeated to make pairs. Absent or all-zero draws a solid stroke.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dashOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Distance in scene units into the dash pattern at which the outline starts, shifting the dashes along the path. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokePosition" type="strokePositionType" default="center">
      <xs:annotation><xs:documentation>For a shape: where the stroke sits relative to the outline: center (default), inside (only the part within the shape) or outside (only the part beyond it). Vector assets always stroke centred.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paintOrder" default="fill-stroke">
      <xs:annotation><xs:documentation>For a shape: drawing order of fill and stroke: fill-stroke (default) paints the stroke over the fill, stroke-fill paints the fill over the stroke. Vector assets always paint the stroke over the fill.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="fill-stroke"/><xs:enumeration value="stroke-fill"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="trimPath">
    <xs:annotation><xs:documentation>Trim paths (draw-on): visible fraction of the outline.</xs:documentation></xs:annotation>
    <xs:attribute name="trimStart" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Start of the visible part of the outline as a fraction 0-1 of its length; default 0. If start exceeds end, the two are swapped. A shape's fill is cut to the trimmed outline too.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trimEnd" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>End of the visible part of the outline as a fraction 0-1 of its length; default 1 (the full length). If end is below start, the two are swapped. A shape's fill is cut to the trimmed outline too.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trimOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Shifts the visible range along the outline in degrees, where 360 is one full length; the range wraps past the end. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trimMode" default="simultaneous">
      <xs:annotation><xs:documentation>How trimming treats several subpaths: simultaneous (default) trims each by the same fractions, sequential trims across them as one continuous path.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="simultaneous"/><xs:enumeration value="sequential"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:simpleType name="strokeMarkerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/><xs:enumeration value="arrow"/><xs:enumeration value="open-arrow"/>
      <xs:enumeration value="circle"/><xs:enumeration value="square"/><xs:enumeration value="diamond"/>
      <xs:enumeration value="bar"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:attributeGroup name="strokeMarkers">
    <xs:annotation><xs:documentation>
      Markers drawn at the start and end of an open outline, in the stroke's paint, pointing along it
      (the start marker points backwards). markerSize is in multiples of strokeWidth. With trim paths,
      markers sit at the ends of the visible part.
    </xs:documentation></xs:annotation>
    <xs:attribute name="markerStart" type="strokeMarkerType" default="none">
      <xs:annotation><xs:documentation>Marker drawn at the start of an open outline, in the stroke's paint and pointing backwards along it: none (default), arrow, open-arrow, circle, square, diamond or bar. On a shape it needs shape path or line.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="markerEnd" type="strokeMarkerType" default="none">
      <xs:annotation><xs:documentation>Marker drawn at the end of an open outline, in the stroke's paint and pointing along it: none (default), arrow, open-arrow, circle, square, diamond or bar. On a shape it needs shape path or line.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="markerSize" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Marker size as a multiple of the stroke width; default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:complexType name="paramValueType">
    <xs:annotation><xs:documentation>Generic named value (shader uniforms, plugin params).</xs:documentation></xs:annotation>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required">
      <xs:annotation><xs:documentation>Name of the parameter being set, such as a shader uniform or program parameter; for a numeric shader parameter it is also the property an animate element can drive.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The parameter's value as text: a number, numbers separated by spaces or commas, a node id for an effect input, or a string for a program. A compute node reads its params by position as numbers and ignores the name.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="overrideType">
    <xs:annotation><xs:documentation>
      Sets attribute @property of the element whose id is @target (resolved in
      the scope of the enclosing instance, layout or variant) to @value.
    </xs:documentation></xs:annotation>
    <xs:attribute name="target" type="xs:NCName" use="required">
      <xs:annotation><xs:documentation>Id of the element whose attribute is changed: inside the instance or include for its own overrides, anywhere in the scene for layout and variant overrides. An id that matches no element is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="property" type="xs:NMTOKEN" use="required">
      <xs:annotation><xs:documentation>Name of the target element's attribute that the override sets; a name the element does not accept is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The new value for the property, written as the attribute would be in the document.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== animation -->
  <xs:complexType name="keyType">
    <xs:annotation><xs:documentation>
      value is parsed with the type of the animated property (number, "x,y",
      colour, paint, path data, string). easeIn/easeOut are After Effects-style
      temporal handles "influence,speed" normalised to [0,1]; spatialIn/Out are
      motion-path tangents in pixels relative to the key value.
    </xs:documentation></xs:annotation>
    <xs:attribute name="time" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time of the key in seconds on the animation's time base (see timeBase); with a marker, an offset from it. Times must not decrease.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The value at the key, written in the form of the animated property (number, x,y pair, colour, path data, string); keys of one animation must not mix units or shapes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interpolation" type="curveType">
      <xs:annotation><xs:documentation>Curve used for the segment from this key to the next; keys without one take the animation's defaultInterpolation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bezier" type="xs:string">
      <xs:annotation><xs:documentation>Control points x1,y1,x2,y2 of a cubic Bezier as in CSS easing, x1 and x2 in 0-1; used for a cubic-bezier segment, over easeIn and easeOut. A key set to cubic-bezier needs it or a handle.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="easeIn" type="pointType">
      <xs:annotation><xs:documentation>Handle "influence,speed" (as in keyframe editors) where the previous segment arrives at this key; with the previous key's easeOut it shapes a cubic-bezier segment that has no bezier.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="easeOut" type="pointType">
      <xs:annotation><xs:documentation>Handle "influence,speed" (as in keyframe editors) leaving this key; it shapes the cubic-bezier segment to the next key when no bezier is given (default influence 1/3, speed 1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spatialIn" type="pointType">
      <xs:annotation><xs:documentation>Tangent of a motion path arriving at this key, in pixels relative to the key's position; with the previous key's spatialOut it bends the path between two pixel positions.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spatialOut" type="pointType">
      <xs:annotation><xs:documentation>Tangent of a motion path leaving this key, in pixels relative to the key's position; with the next key's spatialIn it bends the path between two pixel positions.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="roving" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, the key's time is recomputed between the nearest non-roving keys in proportion to the distance travelled in value, giving constant speed on linear segments; first and last keys never rove. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="carry" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>On a key whose segment is a spring: start the spring with the velocity the previous
      segment arrives at this key with (its rate of change at the end), instead of from rest, so a hit that follows another
      keeps its momentum. Needs a previous key and a following key.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="steps" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Number of jumps of a steps segment from this key to the next; 1 when absent. A key whose interpolation is steps must set it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stepPosition" default="end">
      <xs:annotation><xs:documentation>For a steps segment, whether each jump happens at the start of its interval (start) or at the end (end, default).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="end"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tension" type="signedUnitDecimal" default="0">
      <xs:annotation><xs:documentation>Kochanek-Bartels tension of the tcb spline at this key, from -1 to 1; the tangent is scaled by (1 - tension), so 0 is the default and 1 flattens the tangent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="continuity" type="signedUnitDecimal" default="0">
      <xs:annotation><xs:documentation>Kochanek-Bartels continuity of the tcb spline at this key, from -1 to 1; 0 (default) gives a smooth tangent, other values weight the incoming and outgoing directions differently.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bias" type="signedUnitDecimal" default="0">
      <xs:annotation><xs:documentation>Kochanek-Bartels bias of the tcb spline at this key, from -1 to 1; 0 (default) is even, other values weight the tangent toward the previous or next key.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stiffness" type="positiveDecimal" default="100">
      <xs:annotation><xs:documentation>Spring stiffness of a spring segment from this key; larger values make it oscillate faster. Default 100.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="damping" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Spring damping of a spring segment from this key; larger values make it settle with less overshoot. Default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mass" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Mass of the spring segment from this key; larger values make it respond more slowly. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="overshoot" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>The constant of a back-in, back-out or back-in-out segment (default 1.70158, about 10 % overshoot; 0 is the plain cubic). Read from the key the segment leaves.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="period" type="positiveDecimal">
      <xs:annotation><xs:documentation>The ringing period of an elastic-in, elastic-out or elastic-in-out segment as a fraction of the segment (default 0.3; 0.45 for elastic-in-out). Read from the key the segment leaves.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="marker" type="xs:NCName">
      <xs:annotation><xs:documentation>Snap the key time to a marker; @time becomes an offset from it. A marker of the scene, or a beat.N or bar.N id generated by its beatGrid.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="animateType">
    <xs:sequence><xs:element name="key" type="keyType" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="property" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the parent element's attribute that the keys drive; an unknown name is an error. Inside a motion path only progress can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="defaultInterpolation" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Curve for every segment whose key has no interpolation of its own. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="extrapolateBefore" type="extrapolationType" default="hold">
      <xs:annotation><xs:documentation>What the property does before the first key: hold the first value (default), continue linearly (a hold segment stays still), loop, ping-pong, or offset (loop while adding the value gained per cycle).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="extrapolateAfter" type="extrapolationType" default="hold">
      <xs:annotation><xs:documentation>What the property does after the last key: hold the last value (default), continue linearly (a hold segment stays still), loop, ping-pong, or offset (loop while adding the value gained per cycle).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="additive" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, the animated value is added to the value the property would otherwise have when both are numbers, same-unit lengths or pairs, colours or equal-length lists; otherwise it replaces it. False (default) replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeBase" default="composition">
      <xs:annotation><xs:documentation>Key times are measured against: composition (default) is seconds on the node's container timeline (scene time unless a container retimes it), local is seconds from the node's start, normalized is 0-1 over its duration.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="composition"/><xs:enumeration value="local"/>
        <xs:enumeration value="normalized"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="expressionType">
    <xs:annotation><xs:documentation>
      Computes @property every frame; @property names an attribute the element's own type declares (or position,
      scale, anchor, skew): a text layer's text, for one, is not an animatable property. The language is a pure, side-effect-free
      subset of ECMAScript expressions with these built-ins: time, frame, value,
      index, count, seed, param(name), prop("id.property"), propAtTime("id.property", t),
      valueAtTime(t), penner("curve", u),
      wiggle(freq, amp[, octaves, ampMult, t, hold]), noise(x[,y,z]), random([min,max]),
      loopIn/loopOut(type, n), linear/ease/easeIn/easeOut(t, t0, t1, v0, v1),
      clamp, lerp, smoothstep, spring(t, stiffness, damping, mass),
      audioAmplitude(trackId[, band]), beat(), markerTime(id), textIndex,
      textTotal, geo(mapId, lon, lat) (where a place lands on a map asset now, in map
      pixels) and geoVisible(mapId, lon, lat) (1 on the near side of a globe and inside the
      map frame, else 0). random and noise are seeded; no I/O or wall clock exists.
    </xs:documentation></xs:annotation>
    <xs:simpleContent>
      <xs:extension base="expressionString">
        <xs:attribute name="property" type="xs:string" use="required">
          <xs:annotation><xs:documentation>Name of the parent element's attribute (or position, scale, anchor, skew on a node) the expression computes each frame; an unknown name is an error.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="seed" type="xs:unsignedLong">
          <xs:annotation><xs:documentation>Seed for the expression's random and noise functions; the project's seed is used when absent.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="enabled" type="xs:boolean" default="true">
          <xs:annotation><xs:documentation>If false, the expression does not drive its property (a text selector expression is still used). Default true.</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="motionPathType">
    <xs:annotation><xs:documentation>
      Moves the node's position along an SVG path over [start, end]. progress
      (0..1) may be animated with a nested animate on "progress".
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="animate" type="animateType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="path" type="xs:string" use="required">
      <xs:annotation><xs:documentation>SVG path data the node's position follows; with additive true the node starts at its own position and moves by the path's displacement from its first point. Unparsable data is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds at which the node starts moving along the path. Default 0. Unused when progress is animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds at which the node reaches the end of the path; when absent, the node's own end or the scene's end. Unused when progress is animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interpolation" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Curve that eases progress along the path between start and end. Default linear. Unused when progress is animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoOrient" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, the node also turns to follow the path's direction. Default false; not allowed on a camera.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="orientOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Degrees added to the path-direction rotation when autoOrient is true. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="constantSpeed" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>If true (default), progress is a fraction of the path's length so the node moves at constant speed; if false each path segment gets an equal share of progress.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="additive" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>true: the path is an offset. The node's position is its own x and y (keys, link,
      expression) plus the path's point at the progress minus the path's first point, so the node starts where it would
      without the path. false: the path's point is the position.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="linkType">
    <xs:annotation><xs:documentation>
      Drives @property from another value without writing an expression:
      source is "nodeId.property", "param:name", "audio:trackId[:low|mid|high]"
      or "marker:id". output = clamp(source * scale + offset, min, max), delayed
      by @delay seconds and smoothed over @smoothing seconds.
    </xs:documentation></xs:annotation>
    <xs:attribute name="property" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the parent element's attribute (or position, scale, anchor, skew on a node) the link drives each frame; an unknown name is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Value that drives the property: nodeId.property, param:name, audio:trackId[:low|mid|high|full], or marker:id (0 before the marker, rising to 1 over its duration).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Multiplier applied to the source value before the offset is added. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Value added to the scaled source value. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:double">
      <xs:annotation><xs:documentation>Lower limit of the output, applied after scale and offset; no limit when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:double">
      <xs:annotation><xs:documentation>Upper limit of the output, applied after scale and offset; no limit when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="delay" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds by which the output lags the source: the property reads the source's value from that long ago. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="smoothing" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Seconds over which the source is averaged (trailing window) before use; 0 (default) means no smoothing. When set it takes precedence over follow.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="follow" default="none">
      <xs:annotation><xs:documentation>Lag filter applied to the source: none (default), exponential (first-order, see timeConstant) or spring (see stiffness, damping, mass). Ignored when smoothing is set.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="exponential"/><xs:enumeration value="spring"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="timeConstant" type="positiveDecimal" default="0.1">
      <xs:annotation><xs:documentation>Time constant in seconds of the exponential follow; read only when follow is exponential. Default 0.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stiffness" type="positiveDecimal" default="100">
      <xs:annotation><xs:documentation>Spring stiffness of the spring follow; read only when follow is spring. Default 100.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="damping" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Spring damping of the spring follow; read only when follow is spring. Default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mass" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Spring mass of the spring follow; read only when follow is spring. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:group name="animationElements">
    <xs:choice>
      <xs:element name="animate" type="animateType"/>
      <xs:element name="expression" type="expressionType"/>
      <xs:element name="motionPath" type="motionPathType"/>
      <xs:element name="link" type="linkType"/>
    </xs:choice>
  </xs:group>
  <xs:complexType name="animatedType">
    <xs:annotation><xs:documentation>Base for elements whose only children are animation elements.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>

  <xs:complexType name="timeRemapType">
    <xs:annotation><xs:documentation>
      Maps layer-local time (key/@time) to source time (key/@value, seconds).
      Replaces speed/reverse/loop when present; speed ramps, freezes and
      reversals are expressed as keys.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="key" type="keyType" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="defaultInterpolation" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Curve for time-remap key segments that have no interpolation of their own. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frameBlend" default="none">
      <xs:annotation><xs:documentation>How video frames are blended when the remapped source time falls between two frames: none (default), frame-mix (cross-fade) or optical-flow (along motion). A layer's own frameBlend other than none takes precedence.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="frame-mix"/>
        <xs:enumeration value="optical-flow"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== masks and constraints -->
  <xs:complexType name="maskType">
    <xs:annotation><xs:documentation>
      Masks combine in document order using @mode; the 1.0 behaviour (product of
      coverages) is mode="intersect", the default. Coverage is anti-aliased,
      then expanded/contracted by @expansion and blurred by @feather pixels.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Shape of the mask: rect, ellipse, rounded-rect, path (from path data), polygon (points evenly spaced on the box's inscribed ellipse) or star (alternating outer and inner points on it, see innerRadius).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="rect"/><xs:enumeration value="ellipse"/>
        <xs:enumeration value="rounded-rect"/><xs:enumeration value="path"/>
        <xs:enumeration value="polygon"/><xs:enumeration value="star"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="x" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Horizontal position of the mask's box (or path origin) in the node's own coordinates, in pixels or other length units. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Vertical position of the mask's box (or path origin) in the node's own coordinates, in pixels or other length units. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveLengthType">
      <xs:annotation><xs:documentation>Width of the mask's box in pixels or other length units; when absent, the node's own width, or the width of the area it is drawn into if the node has no size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveLengthType">
      <xs:annotation><xs:documentation>Height of the mask's box in pixels or other length units; when absent, the node's own height, or the height of the area it is drawn into if the node has no size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Corner radius in pixels of a rounded-rect mask, limited to half the shorter side. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="invert" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, the mask keeps what is outside its shape instead of what is inside. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>SVG path data of a path mask, in the node's own coordinates and offset by x and y. Required when type is path.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="points" type="xs:positiveInteger" default="5">
      <xs:annotation><xs:documentation>Number of vertices of a polygon mask, or of tips of a star mask (minimum 3). Default 5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerRadius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>For a star mask, the radius of the inner vertices as a fraction of the outer radius. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillRule" type="fillRuleType" default="nonzero">
      <xs:annotation><xs:documentation>Which regions of a path, polygon or star mask count as inside: nonzero winding (default) or evenodd.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="feather" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Softens the mask's edge with a Gaussian blur of this standard deviation, in pixels. Default 0 (sharp, anti-aliased).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="expansion" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Grows (positive) or shrinks (negative) the mask's outline by this many pixels before feathering. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Strength of this mask from 0 to 1, multiplying its coverage after any inversion. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" default="intersect">
      <xs:annotation><xs:documentation>How the mask combines with the masks before it: intersect (default), add, subtract, lighten, darken or difference; none ignores the mask.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="intersect"/><xs:enumeration value="add"/>
        <xs:enumeration value="subtract"/><xs:enumeration value="lighten"/>
        <xs:enumeration value="darken"/><xs:enumeration value="difference"/>
        <xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="transformConstraintType">
    <xs:annotation><xs:documentation>
      Kinematic constraints evaluated after keyframes and before physics.
      parent: inherit @target's transform (After Effects parenting across the
      tree). look-at: rotate toward @target. follow-path: ride @path.
      copy-*: copy @target's world component. distance: keep within
      [minDistance, maxDistance]. ik: two-bone IK toward @target with @bendPositive.
      track: attach to point @point of tracking data @target.
      influence blends the constrained result with the unconstrained one.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of constraint: parent, look-at, follow-path, copy-position, copy-rotation, copy-scale, copy-transform, distance, ik or track.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="parent"/><xs:enumeration value="look-at"/>
        <xs:enumeration value="follow-path"/><xs:enumeration value="copy-position"/>
        <xs:enumeration value="copy-rotation"/><xs:enumeration value="copy-scale"/>
        <xs:enumeration value="copy-transform"/><xs:enumeration value="distance"/>
        <xs:enumeration value="ik"/><xs:enumeration value="track"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="target" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the node, skeleton bone (skeleton/bone) or tracking data that drives the constraint; a constraint whose target is not found does nothing, except follow-path, which needs none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="targetJoint" type="xs:string">
      <xs:annotation><xs:documentation>With a @target that is an object3D drawing an imported model: the name of a node of
      that model whose pose is the target's transform (parent, copy-position, copy-rotation, copy-scale, copy-transform,
      look-at and distance).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>SVG path data followed by a follow-path constraint, taken as one continuous track through all its subpaths. Required for follow-path.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="point" type="xs:string">
      <xs:annotation><xs:documentation>Name of the tracked point to follow when the target is tracking data; the data's first point when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="influence" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>How strongly the constraint applies, from 0 (none) to 1 (fully constrained); in between blends the constrained and unconstrained results. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="space" default="world">
      <xs:annotation><xs:documentation>For copy-position, copy-rotation, copy-scale and copy-transform: world (default) copies the target's world values, local copies its values relative to its own parent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="world"/><xs:enumeration value="local"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="offsetX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal offset in pixels added to the target position (look-at, follow-path, copy-position, copy-transform, track). For ik it shifts the target on a bone, and the effector from the anchor on a node.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical offset in pixels added to the target position (look-at, follow-path, copy-position, copy-transform, track). For ik it shifts the target on a bone, and the effector from the anchor on a node.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetRotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Degrees added to the rotation the constraint produces (look-at, follow-path with autoOrient, copy-rotation, copy-transform, track on planar tracking data). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minDistance" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>For a distance constraint, the nearest the node's pivot may be to the target's, in pixels; no lower limit (0) when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxDistance" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>For a distance constraint, the farthest the node's pivot may be from the target's, in pixels; no upper limit when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bendPositive" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>For ik on a two-bone or two-joint chain, which way the middle joint bends: true (default) or false for the opposite side; a pole not on the line to the target overrides it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pole" type="xs:IDREF">
      <xs:annotation><xs:documentation>type="ik" on a chain of two bones or joints: a node or bone whose position the middle joint
      bends toward; it replaces @bendPositive (which stays the choice when the pole lies on the line to the target).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="softness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>type="ik" on a chain of two bones or joints: the fraction of the chain's full reach, counted
      from its end, over which the reach eases toward full extension, so the chain does not snap straight as the target
      leaves its reach.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>For follow-path, how far along the path the node sits as a fraction 0-1 of its length. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoOrient" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>For follow-path, if true the node also rotates to the path's direction (plus offsetRotation). Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== paints -->
  <xs:complexType name="stopType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="offset" type="unitDecimal" use="required">
      <xs:annotation><xs:documentation>Position of the stop along the gradient, from 0 to 1; must not be below the previous stop's offset. An animated value that falls below it is moved up to it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" use="required">
      <xs:annotation><xs:documentation>Colour of the gradient at this stop.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the stop's colour, from 0 to 1, multiplied into its alpha. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="midpoint" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Where the halfway blend between this stop and the next falls, as a fraction 0-1 of the span; 0.5 (default) is even. Gradient-map and gradient-overlay effects ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:attributeGroup name="gradientCommon">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the gradient; a fill or stroke paints with it by writing url(#id).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spread" default="pad">
      <xs:annotation><xs:documentation>What a linear or radial gradient does beyond its end points: pad holds the end colours (default), reflect mirrors it, repeat tiles it. A conic gradient is not affected.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="pad"/><xs:enumeration value="reflect"/><xs:enumeration value="repeat"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="units" default="object">
      <xs:annotation><xs:documentation>object: coordinates are fractions of the painted box; user: pixels in the painted node's space.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="object"/><xs:enumeration value="user"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="interpolationSpace" default="linear">
      <xs:annotation><xs:documentation>Colour space in which stops are blended: linear (default), srgb, oklab or oklch; gradient-map and gradient-overlay effects ignore it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="srgb"/>
        <xs:enumeration value="oklab"/><xs:enumeration value="oklch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dither" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>If true (default), adds sub-step noise to the gradient to hide banding; gradient-map and gradient-overlay effects ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotates the gradient clockwise by this many degrees about the centre of the painted box. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="gradientBaseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="stop" type="stopType"/>
      <xs:group ref="animationElements"/>
    </xs:choice>
    <xs:attributeGroup ref="gradientCommon"/>
  </xs:complexType>
  <xs:complexType name="linearGradientType">
    <xs:complexContent><xs:extension base="gradientBaseType">
      <xs:attribute name="x1" type="xs:double" default="0">
        <xs:annotation><xs:documentation>Horizontal coordinate of the gradient's start point (offset 0), as a fraction of the painted box or in pixels depending on units. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y1" type="xs:double" default="0">
        <xs:annotation><xs:documentation>Vertical coordinate of the gradient's start point (offset 0), as a fraction of the painted box or in pixels depending on units. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="x2" type="xs:double" default="1">
        <xs:annotation><xs:documentation>Horizontal coordinate of the gradient's end point (offset 1), as a fraction of the painted box or in pixels depending on units. Default 1.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="y2" type="xs:double" default="0">
        <xs:annotation><xs:documentation>Vertical coordinate of the gradient's end point (offset 1), as a fraction of the painted box or in pixels depending on units. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="radialGradientType">
    <xs:complexContent><xs:extension base="gradientBaseType">
      <xs:attribute name="cx" type="xs:double" default="0.5">
        <xs:annotation><xs:documentation>Horizontal coordinate of the gradient's centre circle, as a fraction of the painted box or in pixels depending on units. Default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="cy" type="xs:double" default="0.5">
        <xs:annotation><xs:documentation>Vertical coordinate of the gradient's centre circle, as a fraction of the painted box or in pixels depending on units. Default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="r" type="positiveDecimal" default="0.5">
        <xs:annotation><xs:documentation>Radius of the gradient's outer circle (offset 1), as a fraction of the painted box or in pixels depending on units. Default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="fx" type="xs:double">
        <xs:annotation><xs:documentation>Horizontal coordinate of the focal point where offset 0 sits; the centre's x when absent.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="fy" type="xs:double">
        <xs:annotation><xs:documentation>Vertical coordinate of the focal point where offset 0 sits; the centre's y when absent.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="fr" type="nonNegativeDecimal" default="0">
        <xs:annotation><xs:documentation>Radius of the focal circle, in the same units as r; with pad spread the gradient stays at offset 0 inside it. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="aspect" type="positiveDecimal" default="1">
        <xs:annotation><xs:documentation>Multiplier on the gradient's x extent about its centre, applied after the units are mapped. 1 is no stretch. With units="object" the gradient already follows the painted box, so a radial gradient on a wide shape is an ellipse without any aspect; &gt; 1 widens it further, &lt; 1 narrows it.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="conicGradientType">
    <xs:complexContent><xs:extension base="gradientBaseType">
      <xs:attribute name="cx" type="xs:double" default="0.5">
        <xs:annotation><xs:documentation>Horizontal coordinate of the gradient's centre, as a fraction of the painted box or in pixels depending on units. Default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="cy" type="xs:double" default="0.5">
        <xs:annotation><xs:documentation>Vertical coordinate of the gradient's centre, as a fraction of the painted box or in pixels depending on units. Default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="angle" type="xs:double" default="0">
        <xs:annotation><xs:documentation>Degrees clockwise from straight up at which the sweep starts (offset 0); in object units the angle is taken in the box fractions, so it skews on a non-square box. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="meshPointType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="row" type="xs:nonNegativeInteger" use="required">
      <xs:annotation><xs:documentation>Zero-based row of this point in the mesh gradient's grid; points outside the grid are ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="col" type="xs:nonNegativeInteger" use="required">
      <xs:annotation><xs:documentation>Zero-based column of this point in the mesh gradient's grid; points outside the grid are ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" use="required">
      <xs:annotation><xs:documentation>Colour at this grid point; grid points without a point element take the colour of the nearest defined one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double"/>
    <xs:attribute name="y" type="xs:double"/>
  </xs:complexType>
  <xs:complexType name="meshGradientType">
    <xs:annotation><xs:documentation>Freeform / mesh gradient: bicubic colour patch grid.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="point" type="meshPointType"/>
      <xs:group ref="animationElements"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the gradient; a fill or stroke paints with it by writing url(#id).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rows" type="gridSizeType" default="2">
      <xs:annotation><xs:documentation>Number of rows of colour points in the grid, from 2 to 16. Default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cols" type="gridSizeType" default="2">
      <xs:annotation><xs:documentation>Number of columns of colour points in the grid, from 2 to 16. Default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interpolationSpace" default="oklab">
      <xs:annotation><xs:documentation>Colour space in which the grid's colours are blended: linear, srgb or oklab (default).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="srgb"/><xs:enumeration value="oklab"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="patternPaintType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the pattern; a fill or stroke paints with it by writing url(#id).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="asset" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the image asset whose picture is repeated as the pattern tile; any other kind of asset is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tileWidth" type="positiveDecimal">
      <xs:annotation><xs:documentation>Width of one tile in pixels; the asset's own width when absent. Multiplied by scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tileHeight" type="positiveDecimal">
      <xs:annotation><xs:documentation>Height of one tile in pixels; the asset's own height when absent. Multiplied by scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal shift in pixels of the tiling's origin. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical shift in pixels of the tiling's origin. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotates the tiling by this many degrees about its origin. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier on the tile size. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="paintsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="linearGradient" type="linearGradientType"/>
      <xs:element name="radialGradient" type="radialGradientType"/>
      <xs:element name="conicGradient" type="conicGradientType"/>
      <xs:element name="meshGradient" type="meshGradientType"/>
      <xs:element name="pattern" type="patternPaintType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== styles and tokens -->
  <xs:simpleType name="fontWeightType">
    <xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fontStyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/><xs:enumeration value="italic"/><xs:enumeration value="oblique"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:attributeGroup name="characterStyle">
    <xs:annotation><xs:documentation>
      Character-level text styling shared by text assets, spans and text styles.
      variation: variable-font axes, e.g. "wght 720, wdth 90, opsz 48".
      features: OpenType features, e.g. "liga, tnum, -kern, ss01".
    </xs:documentation></xs:annotation>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation><xs:documentation>Comma-separated font family names for the text, tried in order; characters a family lacks fall back to later families.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontFile" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of a font file used for the text instead of an installed family; a remote URL is not fetched and is ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontAsset" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a font asset whose font file is used for the text.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fallback" type="xs:string">
      <xs:annotation><xs:documentation>Comma-separated family names tried after the primary (first) font; replaces every later family, inherited or listed in font. A pinned font policy requires each to name a font asset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="weight" type="fontWeightType">
      <xs:annotation><xs:documentation>Font weight from 1 (thinnest) to 1000 (heaviest); 400 is regular and 700 bold. Default 400.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontStyle" type="fontStyleType">
      <xs:annotation><xs:documentation>Slant of the text: normal (upright), or italic or oblique, both of which select the italic face. Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stretch" type="positiveDecimal">
      <xs:annotation><xs:documentation>Font width as a ratio of normal (1 = normal, below 1 condensed, above 1 expanded); a value above 4 is read as a percentage. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="variation" type="xs:string">
      <xs:annotation><xs:documentation>Variable-font axis settings as tag and value pairs, e.g. "wght 720, wdth 90".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="features" type="xs:string">
      <xs:annotation><xs:documentation>Comma-separated OpenType feature tags to apply, e.g. "liga, tnum, ss01"; a leading minus turns a feature off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeColor" type="paintType">
      <xs:annotation><xs:documentation>Paint of the outline drawn around each glyph; an inherited colour is kept, else black when a stroke width or position is given. A colour alone gives a width of 6 percent of the font size unless one is inherited.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Width in pixels of the glyph outline; 0 removes it. If a stroke colour or position is given without a width, 6 percent of the font size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokePosition" type="strokePositionType">
      <xs:annotation><xs:documentation>Where the glyph outline sits relative to the glyph edge: center (default), inside or outside.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowColor" type="colorType">
      <xs:annotation><xs:documentation>Colour of the drop shadow behind the glyphs. When absent, an inherited shadow colour is kept, else black at 60 percent opacity; any single shadow attribute switches the shadow on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowOffsetX" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal offset in pixels of the drop shadow from the glyphs; positive moves it right. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowOffsetY" type="xs:double">
      <xs:annotation><xs:documentation>Vertical offset in pixels of the drop shadow from the glyphs; positive moves it down. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowBlur" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Softness of the drop shadow in pixels; 0 gives a hard-edged shadow. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="baselineShift" type="xs:double">
      <xs:annotation><xs:documentation>Raises the text above its baseline by this many pixels (negative lowers it); has no effect in vertical writing. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tracking" type="xs:double">
      <xs:annotation><xs:documentation>Extra space after each character in thousandths of the font size (negative tightens). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="textTransform">
      <xs:annotation><xs:documentation>Case transformation of the displayed text: none (default), uppercase, lowercase, capitalize (first letter of each word) or small-caps (the font's own small-capital glyphs, if it has them).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="uppercase"/>
        <xs:enumeration value="lowercase"/><xs:enumeration value="capitalize"/>
        <xs:enumeration value="small-caps"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="decoration">
      <xs:annotation><xs:documentation>Line drawn on the text: none (default), underline, line-through or overline, in the text colour.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="underline"/>
        <xs:enumeration value="line-through"/><xs:enumeration value="overline"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="highlight" type="paintType">
      <xs:annotation><xs:documentation>Paint of a box drawn behind each line of text carrying this style. Default none.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="tokenType">
    <xs:attribute name="name" use="required">
      <xs:annotation><xs:documentation>Name of the brand token, referenced from colour values as var(--name).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_\-]+"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The token's colour value, or var(--other) to alias another token (followed up to 8 levels).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="textStyleType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which text assets and spans reference this reusable text style.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="basedOn" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of another text style this one inherits from; its own attributes override the inherited ones (chains up to 16 deep).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="positiveDecimal">
      <xs:annotation><xs:documentation>Font size in pixels used by spans, captions and other text that name this style; a text asset that names the style takes its own required size instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType">
      <xs:annotation><xs:documentation>Text fill paint applied by this style.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineHeight" type="positiveDecimal">
      <xs:annotation><xs:documentation>Line spacing as a multiple of the font size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="characterStyle"/>
  </xs:complexType>
  <xs:complexType name="stylesType">
    <xs:annotation><xs:documentation>Brand kit: colour/number tokens referenced as var(--name), and reusable text styles.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="token" type="tokenType"/>
      <xs:element name="textStyle" type="textStyleType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== assets -->
  <xs:complexType name="representationType">
    <xs:annotation><xs:documentation>
      Alternate encodings of the same media (proxy, high-res, per-language
      audio, HDR/SDR grade). The renderer picks the representation named by
      the output's or command line's representation preference, else the
      asset's own src (OTIO media_references, FCPXML media-rep, AAF EssenceGroup).
    </xs:documentation></xs:annotation>
    <xs:attribute name="name" type="xs:NMTOKEN" use="required">
      <xs:annotation><xs:documentation>Name of this alternate encoding of the asset; it is used when the render requests a representation of that name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the alternate file that replaces the asset's own file when this representation is chosen; a remote URL is not fetched when rendering.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger"/>
    <xs:attribute name="height" type="xs:positiveInteger"/>
    <xs:attribute name="colorSpace" type="colorSpaceType">
      <xs:annotation><xs:documentation>Colour primaries of the alternate file, replacing the asset's own colorSpace when this representation is chosen.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transfer" type="transferType">
      <xs:annotation><xs:documentation>Transfer curve of the alternate file, replacing the asset's own transfer when this representation is chosen.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType"/>
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>Expected SHA-256 digest of the alternate file; when the scene is validated, a different digest of a local file is an error. A remote URL is not checked.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="imageAssetType">
    <xs:sequence><xs:element name="representation" type="representationType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers and other elements (pattern paints, materials, particles, heightmaps) refer to this image.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the image file; a remote URL is not fetched when rendering and is reported as an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels that layout uses for the image. If the declared width and height differ from a local file's, validation warns, and a different aspect ratio distorts the picture.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels that layout uses for the image. If the declared width and height differ from a local file's, validation warns, and a different aspect ratio distorts the picture.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorSpace" type="colorSpaceType" default="srgb">
      <xs:annotation><xs:documentation>Colour primaries of the image's pixels, used to convert them to the working space; a usable embedded profile overrides it unless colorProfile is declared. Default srgb.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transfer" type="transferType" default="auto">
      <xs:annotation><xs:documentation>Transfer curve that decodes the image's pixel values; auto picks the usual curve for the colour space (linear for linear files). A usable embedded profile overrides it unless colorProfile is declared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorProfile" type="colorProfileType" default="embedded">
      <xs:annotation><xs:documentation>Whether a colour profile embedded in the file (embedded, default) overrides colorSpace and transfer, or the declared values always apply (declared); a missing, unusable or raw-space case uses the declared values.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="alphaModeType" default="auto">
      <xs:annotation><xs:documentation>How the file's alpha channel is read: straight or premultiplied, none to ignore it and treat the image as opaque; auto (default) treats it as straight.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="layer" type="xs:string">
      <xs:annotation><xs:documentation>Layer or channel set inside multi-layer files (PSD layer, EXR part).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="videoAssetType">
    <xs:sequence><xs:element name="representation" type="representationType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers refer to this video; an audio track may also name it when hasAudio is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the video file; a remote URL is not fetched when rendering and is reported as an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels that layout uses for the video frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels that layout uses for the video frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType" use="required">
      <xs:annotation><xs:documentation>Frame rate of the video in frames per second, an integer or a fraction such as 30000/1001; source time is turned into frame numbers with it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Length of the video in seconds; the layer's playable source length runs from its clipIn to its clipOut, or to this duration.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorSpace" type="colorSpaceType" default="srgb">
      <xs:annotation><xs:documentation>Colour primaries of the video's frames, used to convert them to the working space. Default srgb.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transfer" type="transferType" default="auto">
      <xs:annotation><xs:documentation>Transfer curve of the video's frames; auto uses the curve tagged in the file, else the usual curve for the colour space.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="alphaModeType" default="auto">
      <xs:annotation><xs:documentation>How the video's alpha is read; ignored (opaque) when the file has no alpha channel. Default auto.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="hasAudio" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, the video's audio track is mixed into the output; an audio track may name this video only when this is true. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioStream" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Index, counted from 0, of the file's audio stream to mix when hasAudio is true. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timecodeStart" type="timecodeType"/>
    <xs:attribute name="pixelAspect" type="positiveDecimal" default="1"/>
    <xs:attribute name="rotation" default="0">
      <xs:annotation><xs:documentation>Clockwise rotation in degrees (0, 90, 180 or 270) applied to the decoded frames; 0 uses the orientation recorded in the file.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:integer">
        <xs:enumeration value="0"/><xs:enumeration value="90"/>
        <xs:enumeration value="180"/><xs:enumeration value="270"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="imageSequenceAssetType">
    <xs:annotation><xs:documentation>
      Numbered frames, src uses printf padding ("logo_%04d.png") or ####.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers refer to this image sequence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Pattern of the numbered frame files, with printf padding such as logo_%04d.png or # characters for the digits.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="first" type="xs:integer" use="required">
      <xs:annotation><xs:documentation>Number of the first frame file.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="last" type="xs:integer" use="required">
      <xs:annotation><xs:documentation>Upper limit of the frame file numbers; frames run from first in steps of step up to the last number not above this. It must not precede first.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="step" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Increment between consecutive frame file numbers. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType" use="required">
      <xs:annotation><xs:documentation>Playback rate of the sequence in frames per second (integer or fraction); sets how fast it advances through the files.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels that layout uses for the sequence frames.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels that layout uses for the sequence frames.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorSpace" type="colorSpaceType" default="srgb">
      <xs:annotation><xs:documentation>Colour primaries of the frames, used to convert them to the working space. A profile embedded in a frame file overrides it unless colorProfile is declared. Default srgb.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transfer" type="transferType" default="auto">
      <xs:annotation><xs:documentation>Transfer curve that decodes the frame values; auto picks the usual curve for the colour space. A profile embedded in a frame file overrides it unless colorProfile is declared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorProfile" type="colorProfileType" default="embedded">
      <xs:annotation><xs:documentation>embedded (default): a profile or colour code points in the frame file take precedence over colorSpace and transfer, unless colorSpace is raw; declared: colorSpace and transfer always apply.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="alphaModeType" default="auto">
      <xs:annotation><xs:documentation>How the file's alpha channel is read: straight or premultiplied, none to ignore it and treat the image as opaque; auto (default) treats it as straight.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="missingFrame" default="error">
      <xs:annotation><xs:documentation>What a missing frame file shows: error (default) reports it, hold repeats the nearest earlier frame (nothing if none exists), black shows black, transparent shows nothing.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="error"/><xs:enumeration value="hold"/><xs:enumeration value="black"/>
        <xs:enumeration value="transparent"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="audioAssetType">
    <xs:sequence><xs:element name="representation" type="representationType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which audio tracks refer to this audio file.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the audio file, relative to the scene file; a file: URL also works. Other URLs are not fetched, so such a file cannot be mixed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="positiveDecimal"/>
    <xs:attribute name="sampleRate" type="xs:positiveInteger"/>
    <xs:attribute name="channels" type="xs:positiveInteger"/>
    <xs:attribute name="language" type="languageTagType"/>
    <xs:attribute name="bpm" type="positiveDecimal">
      <xs:annotation><xs:documentation>Tempo of the audio in beats per minute; required by a track that fits the audio to a duration (fitToDuration).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="spanType">
    <xs:annotation><xs:documentation>A styled run of text; unset attributes inherit from the text asset.</xs:documentation></xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="style" type="xs:IDREF">
          <xs:annotation><xs:documentation>Id of a text style applied to this run of text before its own attributes.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="size" type="positiveDecimal">
          <xs:annotation><xs:documentation>Font size in pixels for this run; when absent, the size from the run's style, else the text asset's size.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="color" type="paintType">
          <xs:annotation><xs:documentation>Fill paint of this run; when absent, the colour from the run's style, else the text asset's colour.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="role" type="xs:NMTOKEN">
          <xs:annotation><xs:documentation>Addressable name for text animators and overrides (e.g. "price").</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="characterStyle"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="textAssetType">
    <xs:annotation><xs:documentation>
      Text content comes from @text or from span children (exactly one).
      {{name}} inside text is replaced by the value of parameter "name".
      autoFit shrinks and/or grows size within [minSize, maxSize] so the text
      fits width x height. background draws a box behind each block, line or word.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="span" type="spanType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers refer to this text.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text">
      <xs:annotation><xs:documentation>The text to show. {{name}} is replaced by the parameter or repeat variable of that name and left as written if none exists. Used instead of span children when not empty.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="1048576"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels of the text box. In horizontal text, lines wrap at it and are aligned within it; in vertical writing modes it is the extent across which columns are placed and overflow is measured.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels of the text box. In horizontal text, vertical alignment and overflow are measured against it; in vertical writing modes lines wrap at it and are aligned within it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" use="required">
      <xs:annotation><xs:documentation>Base font size in pixels, from just above 0 to 4096; autoFit may scale it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minExclusive value="0"/><xs:maxInclusive value="4096"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="style" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a text style whose settings this text starts from; its own attributes override them, except colour and line height left at their defaults.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Text fill paint. Default white; a named style's colour is used when this is left at the default.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" default="start">
      <xs:annotation><xs:documentation>Alignment of each line along its length within the box: start (default), center, end or justify, which widens the spaces to fill every line except the last of a paragraph. Start and end follow the text direction.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="center"/>
        <xs:enumeration value="end"/><xs:enumeration value="justify"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lineHeight" default="1.2">
      <xs:annotation><xs:documentation>Line spacing as a multiple of the font size, from 0.1 to 10. Default 1.2; with a named style, a value left at 1.2 defers to the style's line height.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="0.1"/><xs:maxInclusive value="10"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="letterSpacing" default="0">
      <xs:annotation><xs:documentation>Extra space in pixels added after every character (negative tightens), from minus the font size to 4 times the font size. Default 0.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="-4096"/><xs:maxInclusive value="16384"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="direction" default="auto">
      <xs:annotation><xs:documentation>Base text direction: ltr, rtl, or auto (default) to detect it from the text.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="auto"/><xs:enumeration value="ltr"/><xs:enumeration value="rtl"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType">
      <xs:annotation><xs:documentation>Language tag of the text, used to pick language-specific glyph forms when shaping.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="verticalAlign" default="top">
      <xs:annotation><xs:documentation>Placement of the lines across the box: top (default), middle or bottom. In vertical writing modes it moves the columns sideways, with top at the side where the columns begin.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="top"/><xs:enumeration value="middle"/><xs:enumeration value="bottom"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="writingMode" default="horizontal-tb">
      <xs:annotation><xs:documentation>Line direction: horizontal-tb (default) lays lines out horizontally, vertical-rl and vertical-lr run text top to bottom with lines advancing right-to-left or left-to-right.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="horizontal-tb"/><xs:enumeration value="vertical-rl"/>
        <xs:enumeration value="vertical-lr"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="wrap" default="word">
      <xs:annotation><xs:documentation>How lines break at the box width: word (default), character (anywhere), none (only at explicit line breaks) or balance (evens out line lengths).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="word"/><xs:enumeration value="character"/><xs:enumeration value="none"/>
        <xs:enumeration value="balance"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="hyphenate" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>If true, a word of at least five letters that overflows a line may break at an English hyphenation point, with a hyphen added. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoFit" default="none">
      <xs:annotation><xs:documentation>Scales the text to the box: shrink only makes it smaller, and only if it overflows; grow only larger, while it fits; fit does both. minSize and maxSize bound the scaling. Default none.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="shrink"/>
        <xs:enumeration value="grow"/><xs:enumeration value="fit"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="minSize" type="positiveDecimal">
      <xs:annotation><xs:documentation>Smallest font size in pixels that autoFit shrink or fit may reach; 5 percent of the size when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxSize" type="positiveDecimal">
      <xs:annotation><xs:documentation>Largest font size in pixels that autoFit grow or fit may reach; 8 times the size when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxLines" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Maximum number of lines shown; later lines are cut off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="overflow" default="visible">
      <xs:annotation><xs:documentation>What happens to lines that do not fit in the box: visible (default) draws them anyway, clip cuts them at the box edge, ellipsis drops the lines that do not fit and ends the last kept line with an ellipsis.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="visible"/><xs:enumeration value="clip"/><xs:enumeration value="ellipsis"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="background" type="paintType">
      <xs:annotation><xs:documentation>Paint of a box drawn behind the text. Default none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="backgroundMode" default="block">
      <xs:annotation><xs:documentation>Shape of the background: block (default) one box around all the text, line one per line, or word one per word.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="block"/><xs:enumeration value="line"/><xs:enumeration value="word"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="backgroundPadding" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Padding in pixels added around each background box on every side. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="backgroundRadius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Corner radius in pixels of each background box. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emoji" default="color">
      <xs:annotation><xs:documentation>color (default) prefers a colour emoji font for emoji characters; text does not, so they come from the text's own font or the usual fallback.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="color"/><xs:enumeration value="text"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="characterStyle"/>
  </xs:complexType>
  <xs:complexType name="vectorAssetType">
    <xs:annotation><xs:documentation>shape="svg" renders the SVG file at @src (static SVG 2 subset, no script).</xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers refer to this vector shape.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" use="required">
      <xs:annotation><xs:documentation>Kind of shape drawn: rect, rounded-rect, ellipse, polygon, star, line, path (from path data) or svg (the file at src).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="rect"/><xs:enumeration value="ellipse"/>
        <xs:enumeration value="path"/><xs:enumeration value="rounded-rect"/>
        <xs:enumeration value="polygon"/><xs:enumeration value="star"/>
        <xs:enumeration value="line"/><xs:enumeration value="svg"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of the SVG file drawn when shape is svg (required then), relative to the scene file. Remote URLs are not fetched; other shapes do not draw it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels of the shape's box; an SVG is stretched to fill the box, without keeping its aspect ratio.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels of the shape's box; an SVG is stretched to fill the box, without keeping its aspect ratio.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Fill paint of the shape. Default white. Not used when shape is svg, which draws with the colours inside the file.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>SVG path data in the shape's box coordinates; required when shape is path.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillRule" type="fillRuleType" default="evenodd">
      <xs:annotation><xs:documentation>Which regions count as inside for filling: evenodd (default) or nonzero winding. Not used when shape is svg.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#00000000">
      <xs:annotation><xs:documentation>Paint of the outline. Default transparent, so no outline is drawn. Not used when shape is svg.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Width in pixels of the outline, centred on the edge; 0 (default) draws none. Not used when shape is svg.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Corner radius in pixels of a rect or rounded-rect. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="points" type="xs:positiveInteger" default="5">
      <xs:annotation><xs:documentation>Number of vertices of a polygon (minimum 3) or tips of a star (minimum 2). Default 5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerRadius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>For a star, the radius in pixels of the inner vertices from the centre; half the outer radius when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="strokeStyle"/>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="meshAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which 3D scenes refer to this mesh.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the 3D model or splat file, relative to the scene file. Remote URLs are not fetched.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format">
      <xs:annotation><xs:documentation>File format of the mesh (gltf, glb, obj, usd, usdz, fbx, ply or splat); taken from the file extension when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="gltf"/><xs:enumeration value="glb"/><xs:enumeration value="obj"/>
        <xs:enumeration value="usd"/><xs:enumeration value="usdz"/><xs:enumeration value="fbx"/>
        <xs:enumeration value="ply"/><xs:enumeration value="splat"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="slotType">
    <xs:annotation><xs:documentation>Overrides a Lottie slot (sid) or a named text/colour layer inside the animation.</xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Id (sid) of the Lottie slot whose value this overrides.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="lottieAssetType">
    <xs:sequence><xs:element name="slot" type="slotType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which layers refer to this Lottie animation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the Lottie animation file, relative to the scene file. Remote URLs are not fetched.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels of the animation's box; the animation is stretched to fill it, without keeping its aspect ratio.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels of the animation's box; the animation is stretched to fill it, without keeping its aspect ratio.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animation" type="xs:string">
      <xs:annotation><xs:documentation>Animation id inside a .lottie container.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="segment" type="xs:string">
      <xs:annotation><xs:documentation>Marker name to play, or "startFrame,endFrame".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="strokeFontAssetType">
    <xs:annotation><xs:documentation>A single-line font: glyphs as pen strokes. format="jhf" is the Hershey font file
    format; the n-th glyph of the file (counting from 0) is the character U+0020 + n. Version 1.2.</xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which stroke-text shapes refer to this single-line font.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the single-line (Hershey) font file, relative to the scene file. Remote URLs are not fetched.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" default="jhf">
      <xs:annotation><xs:documentation>File format of the font; jhf (Hershey), the only value, is the default.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="jhf"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="fontAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which text styles and text refer to this font file (fontAsset).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the font file, relative to the scene file. Remote URLs are not fetched, so such a font is not loaded.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="family" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Family name the font answers to when a document pins its fonts; text asking for that family gets this file.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="weight" type="fontWeightType" default="400">
      <xs:annotation><xs:documentation>Weight of the font file from 1 to 1000, used to match requested weights when fonts are pinned. Default 400.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontStyle" type="fontStyleType" default="normal">
      <xs:annotation><xs:documentation>Slant of the font file (normal, italic or oblique), used to match requested styles when fonts are pinned. Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collectionIndex" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Index, counted from 0, of the face to use inside a font collection file. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <!-- ===================================================== SREP 75: fractal assets with deep-zoom precision -->
  <xs:complexType name="fractalAssetType">
    <xs:annotation><xs:documentation>Escape-time fractal image of width x height pixels. Each pixel shows the escape count
  of its centre in exact arithmetic (up to 2^-20 of a pixel; SREP 75), whatever the zoom.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this fractal image.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>Which set is drawn: the Mandelbrot set, or the Julia set of the constant given by juliaX and juliaY, which julia requires and mandelbrot does not allow.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mandelbrot"/><xs:enumeration value="julia"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the fractal image in pixels; every pixel is computed individually, without anti-aliasing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the fractal image in pixels; every pixel is computed individually, without anti-aliasing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerX" type="xs:decimal" default="0">
      <xs:annotation><xs:documentation>Real part of the point at the centre of the image, an exact decimal read at full length whatever its number of digits. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerY" type="xs:decimal" default="0">
      <xs:annotation><xs:documentation>Imaginary part of the point at the centre of the image, an exact decimal read at full length whatever its number of digits. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="juliaX" type="xs:decimal">
      <xs:annotation><xs:documentation>Real part of the Julia constant. Required together with juliaY for kind julia; a mandelbrot must not have both.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="juliaY" type="xs:decimal">
      <xs:annotation><xs:documentation>Imaginary part of the Julia constant. Required together with juliaX for kind julia; a mandelbrot must not have both.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="span" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Width of the view in the complex plane at zoom 0, so one pixel covers span divided by the image width; larger values show more. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Magnification as a power of ten: the view is 10 to the zoom times narrower than span, so 2 shows a hundredth of the width. Can be animated; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Turns the picture about its centre by this many degrees, counterclockwise on screen (the sampling grid turns clockwise). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxIterations" default="1000">
      <xs:annotation><xs:documentation>Iteration limit per pixel, 1 to 100,000,000; points that have not escaped by then count as inside and take insideColor. Default 1000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="100000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bailout" type="positiveDecimal" default="2">
      <xs:annotation><xs:documentation>Escape radius: a pixel escapes at the first iteration where the orbit's distance from the origin exceeds it. Default 2; smooth colouring is measured against it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorMode" default="smooth">
      <xs:annotation><xs:documentation>bands picks a palette colour by the escape count; smooth interpolates between neighbouring palette colours using a fractional count. Default smooth.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="bands"/><xs:enumeration value="smooth"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="palette" type="xs:string" default="#000764FF #206BCBFF #EDFFFFFF #FFAA00FF #000200FF">
      <xs:annotation><xs:documentation>Space-separated list of colours cycled through by escape count; a token that is not a colour is an error. Default: dark blue, blue, white, orange and near black.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paletteScale" type="positiveDecimal" default="0.05">
      <xs:annotation><xs:documentation>Smooth mode only: palette steps per escape iteration, so 0.05 moves one colour along every 20 iterations. Default 0.05.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paletteOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Smooth mode only: shift added to the scaled palette position, where 1 moves one colour along the palette. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="insideColor" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Colour of the points that never escape. Default opaque black.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="generatorAssetType">
    <xs:annotation><xs:documentation>Procedural image source; all parameters animate; noise kinds are seeded.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this generated image; a material map written #id can also name it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>Pattern drawn: solid, gradient, noise, fractal-noise, cells, checkerboard, grid, stripes, film-grain or light-rays.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="solid"/><xs:enumeration value="gradient"/>
        <xs:enumeration value="noise"/><xs:enumeration value="fractal-noise"/>
        <xs:enumeration value="cells"/><xs:enumeration value="checkerboard"/>
        <xs:enumeration value="grid"/><xs:enumeration value="stripes"/>
        <xs:enumeration value="film-grain"/><xs:enumeration value="light-rays"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the generated image in pixels; a value above 8192 (or the device texture limit, if lower) is cut to that limit.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the generated image in pixels; a value above 8192 (or the device texture limit, if lower) is cut to that limit.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>First paint: the solid fill, the gradient start, the grid lines, the first stripe or square, and the high side of noise, fractal-noise, cells, film-grain and light-rays. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint2" type="paintType" default="#000000FF">
      <xs:annotation><xs:documentation>Second paint: the gradient end, the grid background, the second stripe or square, and the low side of noise, fractal-noise, cells, film-grain and light-rays. Default opaque black.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="positiveDecimal" default="100">
      <xs:annotation><xs:documentation>Size of the pattern in asset pixels: noise feature size, cell, square or grid pitch, stripe width; film-grain size is scale/100 px, at least 0.25 px. Ignored by solid and gradient. Default 100.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="octaves" type="xs:positiveInteger" default="4">
      <xs:annotation><xs:documentation>Number of noise layers stacked in fractal-noise (at most 16), each twice as fine and half as strong; other kinds ignore it. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="evolution" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Moves the pattern over time: drifts the noise field, cells and light rays, scrolls checkerboard, grid and stripes by that many periods. Film grain changes every frame anyway; this also changes its seed. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="contrast" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scales the difference between paint and paint2 around their midpoint: 1 leaves it unchanged, below 1 blends them, above 1 sharpens; on light-rays it scales ray brightness. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angle" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees, clockwise on screen: the gradient direction (0 runs left to right), the turn of noise, cells and patterns, and the light-ray direction (0 points down). Solid and film-grain ignore it. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the random draws of noise, fractal-noise, cells, film-grain and light-rays. It is mixed with the project seed and the asset id, which alone supply it when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineWidth" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Grid only: the line width in asset pixels, whatever @scale says; the pitch stays @scale. Absent, the lines are about 4 % of @scale wide (at least 1 px). Animates like @scale.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="chartSeriesType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="values" type="numberListType" use="required">
      <xs:annotation><xs:documentation>Whitespace-separated numbers. Bar, column, line and area take one per category; pie and donut slices come from the first series; scatter reads x y pairs; counter uses one or two values; progress one (above 1 is percent).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType">
      <xs:annotation><xs:documentation>Colour of the series. When absent, a built-in palette colour is chosen by series position; a pie uses palette colours by slice and this colour only when it has a single slice.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="chartAssetType">
    <xs:annotation><xs:documentation>Data-driven chart; @progress (animatable 0..1) draws it on.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="series" type="chartSeriesType"/>
      <xs:group ref="animationElements"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this chart.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>Chart type: bar, column, line, area, pie, donut, scatter, counter (a number counting from the first value to the second, or from 0 to a single value) or progress (a fill bar). An unknown kind draws a column chart.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="bar"/><xs:enumeration value="column"/><xs:enumeration value="line"/>
        <xs:enumeration value="area"/><xs:enumeration value="pie"/><xs:enumeration value="donut"/>
        <xs:enumeration value="scatter"/><xs:enumeration value="counter"/><xs:enumeration value="progress"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the chart image in pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the chart image in pixels; the default label size is one eighteenth of it, limited to 10 to 28 pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labels" type="xs:string">
      <xs:annotation><xs:documentation>Comma-separated category labels, one per position along the category axis of bar, column, line, area and scatter charts; pie, donut, counter and progress draw none. Absent: taken from src.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Local CSV (first column labels, header row series names) or JSON (labels, and series with name and values). Supplies labels when labels is absent and series when no series children are given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="textStyle" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the text style used for axis labels, category labels and values; by default white text sized from the chart height.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>How much of the data is drawn, from 0 (none) to 1 (all); bars grow, lines trace, slices sweep, scatter points appear, counters run from their start value, a progress bar fills. Axes and labels stay. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="showAxes" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the axis lines of cartesian charts are drawn, with value ticks on every kind except bar. Default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="showValues" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the numeric value is printed on each bar, line or area point and pie or donut slice, and on a progress bar. Scatter points get none. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" type="xs:string">
      <xs:annotation><xs:documentation>Number pattern for values and axis ticks such as 0.0, #,##0, 0% or $#,##0.00 (or %.2f); decimals follow the pattern, a comma groups thousands, a trailing % scales by 100. Absent: whole numbers or up to two decimals.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="audiogramAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this audiogram.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the audio track whose loudness drives the audiogram.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the audiogram image in pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the audiogram image in pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" default="bars">
      <xs:annotation><xs:documentation>Drawing style: bars, line, wave or circle show the recent loudness history; spectrum shows low, mid and high band levels across the bars. Default bars.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="bars"/><xs:enumeration value="line"/><xs:enumeration value="wave"/>
        <xs:enumeration value="circle"/><xs:enumeration value="spectrum"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bars" type="xs:positiveInteger" default="48">
      <xs:annotation><xs:documentation>Number of bars or points, at least 2: recent loudness samples, or positions along the spectrum. Default 48.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour or paint of everything drawn: the bars, line, wave or circle rays. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="smoothing" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Smoothing of the loudness history from 0 (none) to 1 (strongest, capped just below 1); higher values react more slowly. The spectrum style ignores it. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="codeAssetType">
    <xs:annotation><xs:documentation>Machine-readable code (QR for CTA landing pages, retail barcodes).</xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this code.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>Symbology: qr, datamatrix, pdf417, ean13, upc-a or code128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="qr"/><xs:enumeration value="datamatrix"/><xs:enumeration value="pdf417"/>
        <xs:enumeration value="ean13"/><xs:enumeration value="upc-a"/><xs:enumeration value="code128"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="data" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The text encoded in the code; it must be valid for the chosen kind.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the code image in pixels, including the quiet zone.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the code image in pixels; 2D codes keep square modules and are centred, linear codes are stretched to the full height.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="foreground" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Colour of the dark modules or bars. Default opaque black.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour filling the whole image behind the code, including the quiet zone. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="errorCorrection" default="M">
      <xs:annotation><xs:documentation>Error-correction level L, M, Q or H for QR and PDF417 (higher recovers more damage); other kinds ignore it. Default M.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="L"/><xs:enumeration value="M"/><xs:enumeration value="Q"/><xs:enumeration value="H"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="quietZone" type="xs:nonNegativeInteger" default="4">
      <xs:annotation><xs:documentation>Empty margin around the code in modules; linear codes get it left and right only. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="formulaAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier that layers use to show this formula.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tex" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The formula in TeX math notation (a supported subset with fractions, roots, scripts, big operators, delimiters, matrices and Greek letters).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the formula image in pixels; the formula is centred and scaled down to fit but never enlarged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the formula image in pixels; the formula is centred and scaled down to fit but never enlarged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="positiveDecimal" default="48">
      <xs:annotation><xs:documentation>Font size of the formula in pixels before fitting. Default 48.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour or paint of the formula. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="generatedAssetType">
    <xs:annotation><xs:documentation>
      Media produced by an external generator (text-to-speech, image, video or
      music model, transcription). The renderer never calls the provider while
      rendering: it reads @cache and fails unless the file's SHA-256 equals
      @cacheSha256. A resolve step, run before rendering, fills the cache from
      @provider/@model/@prompt/@voice/@seed and pins @cacheSha256. This keeps
      renders deterministic.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier by which layers and audio tracks refer to the generated media.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>What the generator produces: image, video, speech, music or sound-effect. Images and videos draw as visuals; the audio kinds play on audio tracks.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="image"/><xs:enumeration value="video"/><xs:enumeration value="speech"/>
        <xs:enumeration value="music"/><xs:enumeration value="sound-effect"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="provider" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the generator that makes the media. It is called only by the resolve step, never while rendering.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="model" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Model, voice or cue name handed to the provider; what it selects depends on the provider.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt" type="xs:string">
      <xs:annotation><xs:documentation>Text the provider generates from: the words to speak for speech; for other kinds a description or parameters, as the provider defines. Required for every kind except speech, though built-in speech providers need it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="voice" type="xs:string">
      <xs:annotation><xs:documentation>Voice the provider uses for speech: a voice name, voice id or speaker number depending on the provider. Some providers require it; others fall back to a default voice.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType">
      <xs:annotation><xs:documentation>Language of the generated speech, as a tag such as en or pt-BR, sent with the request; a provider that uses it reads only the primary subtag.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Whole-number seed sent with the request; only some providers use it. It is part of what identifies a cached result.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>File holding the generated media. Rendering reads this file and never calls the provider; the resolve step writes it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cacheSha256" type="sha256Type" use="required">
      <xs:annotation><xs:documentation>SHA-256 of the cache file, 64 lowercase hex digits. A mismatch is a validation error, and the resolve step rewrites it after generating.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Requested width in pixels of a generated image or video; only together with height is it also the media's size when laid out.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Requested height in pixels of a generated image or video; only together with width is it also the media's size when laid out.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType">
      <xs:annotation><xs:documentation>Frame rate of a generated video, in frames per second (an integer or a ratio such as 30000/1001). If absent it is read from the file, or taken as 25 when the file cannot be probed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="positiveDecimal">
      <xs:annotation><xs:documentation>Requested length in seconds, sent to the provider with the request; whether a provider uses it depends on the provider.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="license" type="xs:string"/>
  </xs:complexType>
  <!-- ===================================================== maps -->
  <xs:simpleType name="projectionType">
    <xs:annotation><xs:documentation>
      Map projections (d3-geo formulas). Cylindrical, pseudo-cylindrical and conic projections
      cut the globe along the antimeridian opposite the centre; orthographic and the azimuthal
      projections clip to the visible cap (the near hemisphere for orthographic).
      web-mercator is spherical Mercator with MapLibre zoom levels (a 512-pixel world at zoom 0).
    </xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="mercator"/><xs:enumeration value="web-mercator"/>
      <xs:enumeration value="equirectangular"/><xs:enumeration value="equal-earth"/>
      <xs:enumeration value="natural-earth"/><xs:enumeration value="albers"/>
      <xs:enumeration value="lambert-conformal"/><xs:enumeration value="orthographic"/>
      <xs:enumeration value="stereographic"/><xs:enumeration value="azimuthal-equal-area"/>
      <xs:enumeration value="azimuthal-equidistant"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="geoAssetType">
    <xs:annotation><xs:documentation>
      Geographic data: GeoJSON, TopoJSON, KML or GPX (format from the extension, then the
      content). @object picks one TopoJSON object (all objects by default). Polygon edges are
      great-circle arcs; rings wound either way are accepted (a polygon larger than a
      hemisphere is turned round).
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier by which geo layers, routes and a map's fit list refer to this data.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path or URI of the geographic data file (GeoJSON, TopoJSON, KML or GPX). It must be a local file at render time; remote data is not fetched.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" default="auto">
      <xs:annotation><xs:documentation>File format of the data: geojson, topojson, kml or gpx. With auto (the default) it is detected from the extension, then the content.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="auto"/><xs:enumeration value="geojson"/><xs:enumeration value="topojson"/>
        <xs:enumeration value="kml"/><xs:enumeration value="gpx"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="object" type="xs:string">
      <xs:annotation><xs:documentation>Name of the one TopoJSON object to read. Absent means all objects; other formats ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="featureStyleType">
    <xs:annotation><xs:documentation>
      Overrides the style of the features of a geoLayer whose key (the layer's @keyBy property)
      equals @key; animatable, so single countries can light up.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Optional unique identifier of this style override.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="key" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Value that selects the features this style applies to: those whose property named by the layer's keyBy equals it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType">
      <xs:annotation><xs:documentation>Fill paint for the matching features, replacing the layer's fill and any choropleth colour. Absent keeps the layer's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType">
      <xs:annotation><xs:documentation>Stroke paint for the matching features' outlines, replacing the layer's stroke. Absent keeps the layer's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Outline width in map pixels for the matching features, replacing the layer's. Absent keeps the layer's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the matching features from 0 to 1, multiplied with the layer's opacity (default 1).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="geoLayerType">
    <xs:annotation><xs:documentation>
      The features of a geo asset: polygons filled and stroked, lines and outlines stroked (drawn on by @progress: each line or
      ring from its first vertex; the fill stays whole), points as dots. @filter keeps features whose property equals (prop=value) or
      differs from (prop!=value) a value. Choropleth: @fillBy names a numeric property mapped
      through @domain (data range by default) and @scale onto @palette (colours interpolated in
      sRGB; quantize picks one colour per equal step); features without a value use @noData.
      @label names a property drawn at each feature's centre.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="featureStyle" type="featureStyleType"/>
      <xs:group ref="animationElements"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Optional unique identifier of this layer; animated values of the layer are looked up under it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="geo" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the geo asset whose features the layer draws.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="filter" type="xs:string">
      <xs:annotation><xs:documentation>Keeps features meeting every condition, separated by semicolons: prop=value or prop!=value (a feature lacking prop fails = and passes !=). Numeric values compare as numbers. A condition with no = or != is ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType" default="#D9D9D9">
      <xs:annotation><xs:documentation>Fill paint of polygons and points (default light grey), and of lines that have no stroke. A choropleth colour replaces it, as does noData for features without a value, if set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType">
      <xs:annotation><xs:documentation>Paint for polygon outlines, lines and point outlines. Absent draws no outline on polygons; lines then take the fill paint.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="0.5">
      <xs:annotation><xs:documentation>Width of outlines and lines in map pixels (default 0.5); lines are drawn at least 0.5 wide.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the layer's fills and strokes from 0 (transparent) to 1 (opaque, default).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillBy" type="xs:string">
      <xs:annotation><xs:documentation>Name of a numeric feature property that sets each feature's fill colour through palette, domain and scale. Features without a number use noData, else the fill.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="palette" type="colorListType">
      <xs:annotation><xs:documentation>Space-separated colours the choropleth maps values onto, first colour at the low end. Absent uses a light-to-dark blue pair.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="domain" type="numberListType">
      <xs:annotation><xs:documentation>Increasing numbers mapping property values to the palette: the first and last are the ends, and as many values as colours (more than two) place one colour per value. Absent uses the data's range.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" default="linear">
      <xs:annotation><xs:documentation>How values map along the domain: linear (default), log, sqrt or quantize (one colour per equal step; unused with over two colours and one domain value each). Log needs positive values, sqrt non-negative.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="log"/><xs:enumeration value="sqrt"/>
        <xs:enumeration value="quantize"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="noData" type="paintType">
      <xs:annotation><xs:documentation>Paint for features whose fillBy value is missing or cannot be placed on the scale (such as zero or negative values on a log scale). Absent falls back to the layer's fill.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyBy" type="xs:string" default="id">
      <xs:annotation><xs:documentation>Name of the feature property matched against each featureStyle's key. Default id: the feature identifier, unless a property is named id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation><xs:documentation>Name of a feature property whose value is drawn as text at the centre of the feature's largest polygon, or at a point feature's first point. Line features get no label. Absent draws no labels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="textStyle" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the text style used for the labels; absent uses white text whose size is the map height divided by 40, limited to 10 to 24 pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pointRadius" type="nonNegativeDecimal" default="3">
      <xs:annotation><xs:documentation>Radius in map pixels of the dots that mark point features (default 3).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of each outline or line drawn, from its first vertex; fills stay whole. Default 1 draws everything.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="graticuleType">
    <xs:annotation><xs:documentation>Meridians and parallels every @step degrees.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Optional unique identifier of this graticule; its animated values are looked up under it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="step" type="positiveDecimal" default="10">
      <xs:annotation><xs:documentation>Spacing in degrees between meridians and parallels (default 10; values below 0.1 act as 0.1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#FFFFFF40">
      <xs:annotation><xs:documentation>Paint of the grid lines (default translucent white).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="0.5">
      <xs:annotation><xs:documentation>Width of the grid lines in map pixels (default 0.5).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the grid lines from 0 to 1 (default 1).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pinType">
    <xs:annotation><xs:documentation>
      A marker at a longitude and latitude, with an optional label beside it; hidden on the far
      side of a globe or outside the frame.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Optional unique identifier of this pin; its animated values are looked up under it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lon" type="longitudeType" use="required">
      <xs:annotation><xs:documentation>Longitude of the pin in degrees east, from -180 to 180.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lat" type="latitudeType" use="required">
      <xs:annotation><xs:documentation>Latitude of the pin in degrees north, from -90 to 90.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal" default="6">
      <xs:annotation><xs:documentation>Radius in map pixels of the marker dot (default 6).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType" default="#FF3B30">
      <xs:annotation><xs:documentation>Fill paint of the marker dot (default red).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#FFFFFF">
      <xs:annotation><xs:documentation>Paint of the marker dot's outline (default white).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="2">
      <xs:annotation><xs:documentation>Width of the marker dot's outline in map pixels (default 2).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the marker dot from 0 to 1 (default 1); the label is not affected.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation><xs:documentation>Text drawn beside the marker. Absent draws no label.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="textStyle" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the text style used for the label; absent uses white text sized to the map's height.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labelDx" type="xs:double" default="10">
      <xs:annotation><xs:documentation>Horizontal offset in map pixels from the marker's centre to the label (default 10). A negative value puts the label to the left, ending at that point.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labelDy" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical offset in map pixels added to the label's position (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="routeType">
    <xs:annotation><xs:documentation>
      A path along great circles through @points ("lon,lat lon,lat …") or the lines of @geo,
      drawn on by @progress measured along the ground, so it advances at constant ground speed
      whatever the projection; @headRadius puts a dot at its tip.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Identifier that animations and expressions use to address this route's attributes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="points" type="geoPointsType">
      <xs:annotation><xs:documentation>The route's vertices as space-separated "lon,lat" pairs in degrees; malformed pairs are skipped. May be combined with geo, in which case both are drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="geo" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a geo asset whose line features are drawn as routes; polygon, point and mixed-geometry features are not drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="filter" type="xs:string">
      <xs:annotation><xs:documentation>Restricts the geo asset's features to those matching all of its "property=value" or "property!=value" conditions, separated by semicolons. Only used with geo.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of each path's length on the ground that is drawn from its start; 1 draws the whole route.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#FFFFFF">
      <xs:annotation><xs:documentation>Colour or paint of the route line; white when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="3">
      <xs:annotation><xs:documentation>Width of the route line in map pixels; 3 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dash" type="numberListType">
      <xs:annotation><xs:documentation>Dash pattern of the line as alternating on and off lengths in map pixels (an odd list repeats); the line is solid when absent or when no length is positive.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the route line and its head dot, from 0 (transparent) to 1 (opaque); 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="headRadius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Radius in map pixels of a dot drawn at the tip of the drawn part of the route; 0, the default, draws no dot.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="headFill" type="paintType">
      <xs:annotation><xs:documentation>Paint of the head dot; the route's stroke paint when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="flyToType">
    <xs:annotation><xs:documentation>
      A camera move to a centre and zoom beginning at @begin (composition seconds), along van
      Wijk and Nuij's smooth zoom-and-pan path; @rho is its curvature (how far out it zooms)
      and @duration defaults to the path's natural length. The first move starts from the
      map's own centerLon/centerLat/zoom; each later one from the previous target. Once a move
      has begun it decides centre and zoom (animate rotation freely).
    </xs:documentation></xs:annotation>
    <xs:attribute name="begin" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds at which this camera move starts; before the first move begins the map shows its own centre and zoom.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="durationType">
      <xs:annotation><xs:documentation>Length of the move in seconds, greater than 0; when absent it takes the natural length of the zoom path between the two views.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lon" type="longitudeType" use="required">
      <xs:annotation><xs:documentation>Longitude in degrees of the view centre the move ends on; it travels the short way round the antimeridian.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lat" type="latitudeType" use="required">
      <xs:annotation><xs:documentation>Latitude in degrees of the view centre the move ends on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Zoom the move ends at, counted in doublings of scale like the map's own zoom; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rho" type="positiveDecimal" default="1.4142135623730951">
      <xs:annotation><xs:documentation>Curvature of the zoom-and-pan path: larger values zoom further out on the way, smaller ones travel more directly; default is the square root of 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="easing" type="curveType" default="ease-in-out">
      <xs:annotation><xs:documentation>Easing curve applied to the move's progress over time; ease-in-out when absent. The latest move to have begun decides the curve.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:simpleType name="tileZoomType">
    <xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="24"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="tilesAssetType">
    <xs:annotation><xs:documentation>
      Map tiles: a PMTiles archive (@src) of vector (MVT) or raster (PNG, JPEG, WebP) tiles; or
      an online tile service (@url, a template with {z}, {x} and {y}, or {s} for a subdomain),
      whose tiles a resolve step, run before rendering, downloads for the views the document's
      maps show into @cache (a PMTiles archive pinned by @cacheSha256). Rendering never fetches tiles.
      @sha256 pins @src. @tileSize is the pixel size tiles are drawn at (default 512 for vector
      tiles, 256 for raster); @minZoom and @maxZoom (minZoom &lt;= maxZoom) bound the zooms fetched
      from a service. @attribution is the tiles' credit line.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier by which basemaps, and the terrain of a 3D map object, name this tile source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path or URI of a local PMTiles archive of vector or raster tiles that is read when rendering; used in preference to the cache.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 digest that the file named by src must match; a mismatch is reported as an error when the document is checked.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="url" type="xs:string">
      <xs:annotation><xs:documentation>Template of an online tile service with {z}, {x} and {y} (and {s}, which takes a, b or c); the resolve step downloads the needed tiles into cache, and rendering never does. Without src it needs cache and cacheSha256.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of the PMTiles archive the resolve step writes from url; it is read for rendering when src is absent. Required with url unless src is given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cacheSha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 digest that pins the cache archive; a mismatch is reported as an error when assets are verified, and the resolve step writes it. Required with url unless src is given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tileSize" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Pixel size at which a basemap draws these tiles and at which zooms to fetch are chosen; 512 for vector tiles and 256 for raster when absent. Not used for 3D terrain or buildings.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minZoom" type="tileZoomType" default="0">
      <xs:annotation><xs:documentation>Lowest zoom level (0 to 24) fetched from the online service; 0 when absent. It does not limit tiles read from src.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxZoom" type="tileZoomType" default="19">
      <xs:annotation><xs:documentation>Highest zoom level (0 to 24) fetched from the online service; 19 when absent, and not below minZoom. It does not limit tiles read from src.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="attribution" type="xs:string">
      <xs:annotation><xs:documentation>Credit line for the tiles, drawn in the map's corner by a basemap that shows its attribution; the archive's own credit is used when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="basemapType">
    <xs:annotation><xs:documentation>
      A basemap from a tiles asset. Vector tiles are drawn with a MapLibre style (@mapStyle: a
      style JSON file, or protomaps-light / protomaps-dark, the Protomaps basemap styles, the
      default); raster tiles are drawn as images, warped into the map's projection. Raster
      basemaps paint beneath all of the map's other content, its background included. @detail
      shifts the tile zoom (positive: finer tiles); @labels="false" leaves out the style's text.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Identifier that animations and expressions use to address this basemap's attributes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tiles" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the tiles asset whose tiles this basemap draws.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mapStyle" type="xs:string">
      <xs:annotation><xs:documentation>Style for vector tiles: protomaps-light (the default), protomaps-dark, or the path of a style JSON file. Raster tiles ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the basemap from 0 (transparent) to 1 (opaque); 1 when absent. The attribution is still shown at 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="detail" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Number of tile zoom levels added to the zoom chosen for the view; positive values draw finer tiles, negative ones coarser. 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labels" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the style's text labels are drawn on a vector basemap; the value false leaves them out and the default is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="attribution" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Draws the tiles' credit (their @attribution, or the archive's) in the map's corner.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="mapAssetType">
    <xs:annotation><xs:documentation>
      A projected map drawn as vectors: geoLayer, graticule, route and pin children paint in
      document order over @background (the globe or world outline filled), with @outline
      stroking that outline. zoom counts doublings from the fitted view: zoom 0 shows @fit
      (the whole sphere when absent) inside the frame less @fitPadding, centred on
      centerLon/centerLat (default: the middle of the fit target). centerLon, centerLat, zoom
      and rotation (degrees, clockwise on screen) are animatable; flyTo children make smooth
      camera moves. Tilt a map in perspective with its layer's 3D rotation.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="basemap" type="basemapType"/>
      <xs:element name="geoLayer" type="geoLayerType"/>
      <xs:element name="graticule" type="graticuleType"/>
      <xs:element name="route" type="routeType"/>
      <xs:element name="pin" type="pinType"/>
      <xs:element name="flyTo" type="flyToType"/>
      <xs:group ref="animationElements"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier by which layers and expressions refer to this map; its animated attributes are addressed by it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the map's drawing frame in pixels. A map that textures a globe is drawn over the whole world at twice its height instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the map's drawing frame in pixels.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="projection" type="projectionType" default="equal-earth">
      <xs:annotation><xs:documentation>Map projection, default equal-earth; the cylindrical, pseudo-cylindrical, conic (albers, lambert-conformal) and azimuthal (including orthographic) families are supported. Not used when the map textures a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parallels" type="numberListType">
      <xs:annotation><xs:documentation>Two standard parallels in degrees for the albers and lambert-conformal projections (defaults 29.5 and 45.5, and 30 and 30); ignored by other projections and when fewer than two values are given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerLon" type="longitudeType">
      <xs:annotation><xs:documentation>Longitude in degrees the view is centred on; defaults to the middle of the fit target (0 for the whole sphere). May be animated. Not used when the map textures a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerLat" type="latitudeType">
      <xs:annotation><xs:documentation>Latitude in degrees the view is centred on; defaults to the middle of the fit target (0 for the whole sphere). May be animated. Not used when the map textures a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Zoom counted in doublings of scale; 0 shows the fit target with other projections and a 512 px wide world with web-mercator, 1 magnifies twice. May be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Turn of the map on screen in degrees, clockwise; 0 when absent. May be animated. Not used when the map textures a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fit" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of geo assets that the map's zoom 0 fits inside the frame; the whole sphere when absent. With web-mercator it only sets the default centre.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fitPadding" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Margin in pixels kept free on each side of the frame when fitting the map; 0 when absent. Has no effect with the web-mercator projection. Not used when the map textures a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="paintType">
      <xs:annotation><xs:documentation>Paint that fills the map's outline (the globe, or the whole world on flat projections), below the vector layers and above raster basemaps; nothing is filled when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outline" type="paintType">
      <xs:annotation><xs:documentation>Paint of the stroke drawn around the map's outline (the globe or the whole world) over the layers; nothing is stroked when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outlineWidth" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Width in pixels of the outline stroke; 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="precision" type="positiveDecimal" default="0.7071">
      <xs:annotation><xs:documentation>Resampling precision in pixels for projected lines, greater than 0; smaller values follow curves more closely. Default 0.7071.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pdfRegionType">
    <xs:annotation><xs:documentation>
      A box on the page, in the cache image's pixels (origin top-left, +y down). With @text, the resolve
      step finds the occurrence-th match of the phrase in the page's text and writes x, y, width and
      height; without it, the box is given by hand.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier that shapes name in region to be placed on this box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation><xs:documentation>Phrase whose position the resolve step finds on the page; the match is case-sensitive, and whitespace, soft hyphens and line-end hyphens are normalised. Without it the box is given by hand.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="occurrence" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Which match of the phrase to use, counting from 1 from the start of the page's text; matches do not overlap and 1 is the default.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Left edge of the box in pixels of the page's cache image, measured from its left edge; written by the resolve step when text is set, but required even then, so give a value first.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Top edge of the box in pixels of the page's cache image, measured downward from its top; written by the resolve step when text is set, but required even then, so give a value first.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="nonNegativeDecimal" use="required">
      <xs:annotation><xs:documentation>Width of the box in pixels of the page's cache image; written by the resolve step when text is set, but required even then, so give a value first.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="nonNegativeDecimal" use="required">
      <xs:annotation><xs:documentation>Height of the box in pixels of the page's cache image; written by the resolve step when text is set, but required even then, so give a value first.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pdfAssetType">
    <xs:annotation><xs:documentation>
      One page of a PDF, drawn as an image. The renderer never reads the PDF: it reads @cache and fails
      unless its SHA-256 equals @cacheSha256. A resolve step, run before rendering, renders page @page at
      @dpi over @background into the cache, writes width, height and cacheSha256, and resolves the
      regions' text. @sha256 pins the source file.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="region" type="pdfRegionType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the PDF page asset; layers name it in @asset, and a shape's @region names one of its regions, placed through the layer that shows it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the source PDF file; only the resolve step parses it, and only a local file, checking it against @sha256. Rendering draws the cache image instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="page" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Page of the PDF to show, counted from 1; a number beyond the page count is an error. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dpi" default="150">
      <xs:annotation><xs:documentation>Resolution at which the page is rendered, 18 to 1200; 72 dpi is one pixel per PDF point, and the image is the page size in points times dpi/72, rounded up. Default 150.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="18"/><xs:maxInclusive value="1200"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="background" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Color the page is composited over when it is rendered; may be translucent. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="annotations" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the page's annotations are drawn through their normal appearance streams; when false they are left out. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the page image (PNG) written by the resolve step; rendering draws this file and never reads the PDF. Required, so give a value before the first resolve.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cacheSha256" type="sha256Type" use="required">
      <xs:annotation><xs:documentation>SHA-256 digest of the cache image, written by the resolve step; a cache file whose digest differs is an error. Required, so give a value before the first resolve.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the cache image in pixels, written by the resolve step; the asset is drawn as an image of this size. Required, so give a value before the first resolve.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the cache image in pixels, written by the resolve step; the asset is drawn as an image of this size. Required, so give a value before the first resolve.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>

  <xs:complexType name="assetsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="image" type="imageAssetType"/>
      <xs:element name="video" type="videoAssetType"/>
      <xs:element name="imageSequence" type="imageSequenceAssetType"/>
      <xs:element name="audio" type="audioAssetType"/>
      <xs:element name="text" type="textAssetType"/>
      <xs:element name="vector" type="vectorAssetType"/>
      <xs:element name="mesh" type="meshAssetType"/>
      <xs:element name="lottie" type="lottieAssetType"/>
      <xs:element name="font" type="fontAssetType"/>
      <xs:element name="strokeFont" type="strokeFontAssetType"/>
      <xs:element name="generator" type="generatorAssetType"/>
      <xs:element name="chart" type="chartAssetType"/>
      <xs:element name="audiogram" type="audiogramAssetType"/>
      <xs:element name="code" type="codeAssetType"/>
      <xs:element name="formula" type="formulaAssetType"/>
      <xs:element name="generated" type="generatedAssetType"/>
      <xs:element name="geo" type="geoAssetType"/>
      <xs:element name="tiles" type="tilesAssetType"/>
      <xs:element name="map" type="mapAssetType"/>
      <xs:element name="pdf" type="pdfAssetType"/>
      <xs:element name="meshSequence" type="meshSequenceAssetType"/>
      <xs:element name="volume" type="volumeAssetType"/>
      <xs:element name="voxelAsset" type="voxelAssetType"/>
      <!-- SREP 75, version 1.6 -->
      <xs:element name="fractal" type="fractalAssetType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== materials -->
  <xs:complexType name="materialType">
    <xs:annotation><xs:documentation>
      glTF 2.0 metallic-roughness plus the ratified KHR_materials_* extensions
      (clearcoat, transmission, ior, sheen, volume, specular, iridescence,
      anisotropy, dispersion, emissive_strength, unlit). @materialX points to a
      MaterialX/OpenPBR document that replaces these parameters when present.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the material; nodes select it with @material.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="baseColor" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Base color of the surface. Its alpha is the opacity under alphaMode blend and is tested against alphaCutoff under mask. A base color map multiplies it. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="metallic" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Metalness from 0 (dielectric) to 1 (metal); the blue channel of the metallic-roughness map multiplies it. Default 0. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="roughness" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Surface roughness from 0 (mirror-like) to 1 (fully diffuse highlights); the green channel of the metallic-roughness map multiplies it. Default 0.5. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissive" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Color of light the surface gives off regardless of lighting; an emissive map multiplies it. Default black (no emission). A loaded materialX document replaces it when drawing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissiveStrength" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier on the emissive color, which can exceed 1 for a brighter glow. Default 1. A loaded materialX document replaces it when drawing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity from 0 to 1, multiplied with the base color alpha to give the surface alpha that alphaMode mask or blend uses. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alphaMode" default="opaque">
      <xs:annotation><xs:documentation>How alpha is used: mask discards pixels whose alpha is below alphaCutoff, blend composites the surface with its alpha, opaque does neither (a node opacity below 1 still fades it). Default opaque.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="opaque"/><xs:enumeration value="mask"/><xs:enumeration value="blend"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alphaCutoff" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Alpha threshold from 0 to 1 for alphaMode mask: pixels with alpha below it are discarded. Default 0.5; unused in other modes. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="doubleSided" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>In the rasterized renderer, when true back faces are drawn too, shaded with the flipped normal; when false they are culled. Default false. The path-traced renderer does not apply it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="unlit" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the surface shows its base color without any lighting or shading. Default false. A loaded materialX document replaces it when drawing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clearcoat" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Strength from 0 to 1 of a glossy clear layer over the surface. Default 0 (none). Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clearcoatRoughness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Roughness from 0 to 1 of the clear-coat layer; used only when clearcoat is above 0. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transmission" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Share from 0 to 1 of light that passes through the surface, showing a refracted view of what is behind. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ior" type="positiveDecimal" default="1.5">
      <xs:annotation><xs:documentation>Index of refraction: sets how strongly dielectrics reflect and how much transmitted light bends; values below 1 count as 1. Default 1.5. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="thickness" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Thickness of the transmissive volume: the world-space distance the refracted ray travels inside before the scene behind is sampled. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="attenuationColor" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Color that light has after travelling attenuationDistance through a transmissive volume. Default white (no tint); has no effect without attenuationDistance.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="attenuationDistance" type="positiveDecimal">
      <xs:annotation><xs:documentation>Distance, in world units, over which light travelling through a transmissive volume is tinted to attenuationColor; longer paths through the volume tint more. When absent there is no attenuation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sheenColor" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Color of the soft sheen seen at grazing angles, as on cloth. Default black (no sheen). Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sheenRoughness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Roughness from 0 to 1 of the sheen lobe. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="specular" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Strength from 0 to 1 of the specular reflection of non-metal surfaces; metals are unaffected. Default 1. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="specularColor" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Tint of the specular reflection of non-metal surfaces; the path tracer uses only its brightness. Default white (untinted).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="iridescence" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Strength from 0 to 1 of a thin-film rainbow shift in the reflection. Default 0 (none). Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="iridescenceIor" type="positiveDecimal" default="1.3">
      <xs:annotation><xs:documentation>Index of refraction of the thin iridescent film. Default 1.3; used only when iridescence is above 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anisotropy" type="signedUnitDecimal" default="0">
      <xs:annotation><xs:documentation>Strength of stretched, direction-dependent highlights, from -1 to 1; 0 gives ordinary isotropic highlights. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anisotropyRotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the anisotropic stretch direction in the surface's tangent plane, in degrees; used only when anisotropy is not 0. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dispersion" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Strength of color separation in refraction for transmissive surfaces; 0 is none, larger values spread red and blue further. Default 0. Not applied by the path tracer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <!-- a map attribute that begins with # names a generator or image asset of the document (SREP 71, MTX1) -->
    <xs:attribute name="baseColorMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Texture, by file URI or by #id of an image or generator asset, that multiplies the base color; read as sRGB color. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Tangent-space normal map, by file URI or #id of an image or generator asset, that perturbs the shading normal; read as linear data. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalScale" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Multiplier on the x and y components of the normal map's tilt: 1 is as authored, 0 flattens it. Default 1. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="metallicRoughnessMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Texture, by file URI or #id, whose green channel multiplies roughness and blue channel multiplies metallic; read as linear data. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="occlusionMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Texture, by file URI or #id, whose red channel darkens ambient and environment lighting (not direct lights) where it is dark; read as linear data. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissiveMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Texture, by file URI or #id, that multiplies the emissive color; read as sRGB color. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="displacementMap" type="xs:anyURI">
      <xs:annotation><xs:documentation>Texture, by file URI or #id, whose red channel moves vertices along their normals by displacementScale; read as linear data. No map when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="displacementScale" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Distance, in the mesh's own model units, that a displacement map value of 1 moves a vertex along its normal. Default 0 (no displacement). A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="uvScaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Multiplier on the horizontal (U) texture coordinate of all the material's maps. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="uvScaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Multiplier on the vertical (V) texture coordinate of all the material's maps. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="unevenness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Amount of procedural surface unevenness: a smooth noise fixed to the object that tilts the
      shading normal and varies the roughness, for a hand-made (clay) look. 0 is off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="unevennessScale" type="positiveDecimal" default="8">
      <xs:annotation><xs:documentation>Size of the largest features of the unevenness, in scene units (pixels at the object's
      scale).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="unevennessSeed" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Integer seed of the unevenness noise; different seeds give different patterns. No effect while unevenness is 0, and the path-traced renderer does not apply unevenness.</xs:documentation></xs:annotation>
    </xs:attribute>
    <!-- SREP 71: subsurface scattering, after OpenPBR -->
    <xs:attribute name="subsurface" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Weight from 0 to 1 of light scattering beneath the surface in the diffuse shading, softening the light terminator for a waxy or skin look. Default 0 (off). A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="subsurfaceColor" type="colorType" default="#CCCCCCFF">
      <xs:annotation><xs:documentation>Color of the light scattered beneath the surface (its scattering albedo). Default #CCCCCC; used when subsurface is above 0. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="subsurfaceRadius" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Mean free path in scene units (pixels), multiplied per channel by subsurfaceRadiusScale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="subsurfaceRadiusScale" type="unitTripleType" default="1 0.5 0.25">
      <xs:annotation><xs:documentation>Three factors from 0 to 1 that scale the subsurface radius for red, green and blue, so colors spread differently. Default 1 0.5 0.25. A loaded materialX document replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="materialX" type="xs:anyURI">
      <xs:annotation><xs:documentation>URI of a MaterialX document whose parameters replace this material's own; uvScale and doubleSided are kept, as are maps the document does not supply. An unreadable document is reported as an error.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="materialsType">
    <xs:sequence><xs:element name="material" type="materialType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== node attributes -->
  <xs:attributeGroup name="transformAttributes">
    <xs:annotation><xs:documentation>
      anchorX and anchorY are in the node's local layout coordinates. On a fitted
      layer this is the fit box, not the source image's pixel coordinates: the
      centre of a 1920 by 1080 box is anchorX="960", anchorY="540".
    </xs:documentation></xs:annotation>
    <xs:attribute name="x" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Horizontal position of the node's anchor point in its parent's box, in pixels or a relative length (% of parent width, vw, vh, vmin, vmax); 0 when absent. alignX takes over on a node that has a box size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Vertical position of the node's anchor point in its parent's box, in pixels or a relative length (% of parent height, vw, vh, vmin, vmax), growing downward; 0 when absent. alignY takes over on a node that has a box size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation about the anchor point, in degrees, clockwise on screen; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Horizontal scale factor about the anchor point, applied before skew and rotation; 1 leaves the size unchanged and is used when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Vertical scale factor about the anchor point, applied before skew and rotation; 1 leaves the size unchanged and is used when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anchorX" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Horizontal pivot of the node's rotation, skew and scale, in the node's local layout coordinates (pixels or relative length, % of the parent's width); 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anchorY" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Vertical pivot of the node's rotation, skew and scale, in the node's local layout coordinates (pixels or relative length, % of the parent's height); 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skewX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal shear angle in degrees (the tangent of the angle shifts x in proportion to y); 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skewY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical shear angle in degrees (the tangent of the angle shifts y in proportion to x); 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="nodeCoreAttributes">
    <xs:annotation><xs:documentation>The attributes every node takes, with no placement: identity, visibility, time window, condition, motion blur and track matte. A connector takes only this group.</xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="tags" type="xs:NMTOKENS">
      <xs:annotation><xs:documentation>Space-separated free-form labels on the node. With safeArea enforcement on, a node tagged cta or logo is checked to stay inside the safe region unless safeAreaForce exempts it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="safeAreaForce" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        true exempts this node and everything it contains (for a symbol: every instance of it, and what it draws)
        from the safeArea enforce check (SA01); validate lists every node that carries it (SA02), so a deliberate
        placement outside the safe region is never silent.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:int" default="0">
      <xs:annotation><xs:documentation>Stacking order among siblings: nodes with a higher integer draw above lower ones; 0 when absent. Not used for stacking by 3D objects, 3D particle nodes, ocean nodes and cameras.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When false, the node and everything it contains are not drawn; true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Node opacity from 0 (transparent) to 1 (opaque), multiplied with the opacity of its ancestors; 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the node first appears; 0 when absent. Added to the marker time when startMarker is set. A transition on the node can make it appear earlier.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the node disappears (exclusive); when absent it stays until its parent ends. Added to the marker time when endMarker is set. A transition can keep it longer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shutterAngle">
      <xs:annotation><xs:documentation>The shutter angle, in degrees, of this node's motion blur, instead of the project's: the
      nearest node up its parents that sets it, else project/@shutterAngle. 0 draws the node sharp; 360 blurs over the
      whole frame interval. Only where motion blur is on for the node.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="0"/><xs:maxInclusive value="720"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="startMarker" type="xs:NCName">
      <xs:annotation><xs:documentation>Name of a scene marker, or a beat.N or bar.N id of the beat grid, whose time is added to start to give the node's appearance time.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="endMarker" type="xs:NCName">
      <xs:annotation><xs:documentation>Name of a scene marker, or a beat.N or bar.N id of the beat grid, whose time plus end (0 if absent) gives the node's disappearance time.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="condition" type="expressionString">
      <xs:annotation><xs:documentation>Node is rendered only when the expression is truthy (e.g. "param('showPrice')").</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="triStateType" default="inherit">
      <xs:annotation><xs:documentation>Turns motion blur on or off for this node and the nodes it contains; inherit (the default) takes the nearest ancestor's setting, then the project's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="matte" type="xs:IDREF">
      <xs:annotation><xs:documentation>Track matte: any node whose alpha or luma gates this node. The matte node is not drawn itself unless matteVisible="true".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="matteMode" type="matteModeType" default="alpha">
      <xs:annotation><xs:documentation>How the matte node gates this node: alpha or luma takes the matte's alpha or brightness as coverage, and the -inverted modes use one minus it; alpha when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="matteVisible" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>On a node that names a matte: when true the matte node is also drawn; by default (false) the matte is hidden and only gates this node.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="edgeBlend" default="inherit">
      <xs:annotation><xs:documentation>The space in which this node's own pixels (their colour C and coverage x opacity a)
      composite onto what lies beneath (B): linear, out = a C + (1 - a) B in the linear working space; encoded, the same
      on display-encoded values (the sRGB transfer function), decoded back; inherit, linear when project/@linearLight is
      true and encoded when it is false. A group's value applies when its offscreen composites; children do not inherit
      it. SREP 72.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="inherit"/><xs:enumeration value="linear"/><xs:enumeration value="encoded"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="nodeAttributes">
    <xs:attributeGroup ref="nodeCoreAttributes"/>
    <xs:attribute name="parent" type="xs:IDREF">
      <xs:annotation><xs:documentation>Transform parent outside the XML tree (After Effects parenting); shorthand for a transformConstraint type="parent".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="threeD" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>2.5D: place this 2D node in camera space at depth zDepth with rotationX/rotationY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zDepth" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Depth of the node in the frame's 2.5D camera space, in frame pixels, used only when threeD is true; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation about the horizontal axis through the node's pivot, in degrees, used only when threeD is true; positive values turn the top edge away.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation about the vertical axis through the node's pivot, in degrees, used only when threeD is true; positive values turn the right edge away.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alignX">
      <xs:annotation><xs:documentation>Responsive anchoring: overrides x so the node's box aligns within alignTo.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="left"/><xs:enumeration value="center"/><xs:enumeration value="right"/>
        <xs:enumeration value="stretch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alignY">
      <xs:annotation><xs:documentation>Responsive vertical placement of the node's box within the alignTo rectangle: top, middle or bottom, or stretch to fill it minus margin; unset leaves y alone, as does a node with no box size.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="top"/><xs:enumeration value="middle"/><xs:enumeration value="bottom"/>
        <xs:enumeration value="stretch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alignTo" default="parent">
      <xs:annotation><xs:documentation>Rectangle that alignX and alignY align within: the parent's box, the output frame, or the frame's safe area; parent when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="parent"/><xs:enumeration value="frame"/><xs:enumeration value="safe-area"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="margin" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Inset in pixels or a relative length (a percentage is of the parent's width on both axes) kept from the alignTo edge for left, right, top, bottom and stretch alignment; 0 when absent, unused without alignX or alignY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="transformAttributes"/>
  </xs:attributeGroup>

  <!-- ===================================================== deformation and rigging -->
  <xs:complexType name="warpPointType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="row" type="xs:nonNegativeInteger" use="required">
      <xs:annotation><xs:documentation>Zero-based row of the mesh-warp control point to move; points outside the modifier's rows by cols grid are ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="col" type="xs:nonNegativeInteger" use="required">
      <xs:annotation><xs:documentation>Zero-based column of the mesh-warp control point to move; points outside the modifier's rows by cols grid are ignored.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal displacement of this mesh-warp control point from its undeformed grid position, in the node's local pixels; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical displacement of this mesh-warp control point from its undeformed grid position, in the node's local pixels; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="puppetPinType">
    <xs:annotation><xs:documentation>Puppet pin at rest position restX/restY; x/y animate its displacement.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="name" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>Optional label for the pin; it has no effect on the deformation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" default="position">
      <xs:annotation><xs:documentation>How the pin acts: position moves its point to the rest position plus x/y; bend also turns the surrounding area by rotation; starch moves nothing and stiffens the area around it. Default position.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="position"/><xs:enumeration value="bend"/><xs:enumeration value="starch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="restX" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Horizontal rest position of the pin, in pixels in the node's local space (origin at the top-left of its box).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="restY" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Vertical rest position of the pin, in pixels in the node's local space (origin at the top-left of its box).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal displacement of the pin from its rest position, in pixels; animate it to move the pin. Default 0. Not used by starch pins.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical displacement of the pin from its rest position, in pixels; animate it to move the pin. Default 0. Not used by starch pins.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Bend pins only: the angle in degrees the area around the pin is held at. Default 0; ignored by position and starch pins.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amount" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Starch pins only: how far the stiffening reaches around the pin, as a multiple (at least 1, default 1) of one eighth of the box's longer side.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="modifierType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="point" type="warpPointType"/>
      <xs:element name="pin" type="puppetPinType"/>
    </xs:choice>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>The deformation: bend, twist, wave, squash, stretch, mesh-warp, puppet, skin (needs skeleton), bulge, pinch, spherize, ripple, turbulence or corner-pin (needs corners).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="bend"/><xs:enumeration value="twist"/>
        <xs:enumeration value="wave"/><xs:enumeration value="squash"/>
        <xs:enumeration value="stretch"/><xs:enumeration value="mesh-warp"/>
        <xs:enumeration value="puppet"/><xs:enumeration value="skin"/>
        <xs:enumeration value="bulge"/><xs:enumeration value="pinch"/>
        <xs:enumeration value="spherize"/><xs:enumeration value="ripple"/>
        <xs:enumeration value="turbulence"/><xs:enumeration value="corner-pin"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="amount" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Strength of the effect, default 0 (none): degrees for bend and twist, pixels for wave, ripple and turbulence, a fraction for squash, stretch, bulge, pinch and spherize (spherize clamps to -1..1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frequency" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Wave: number of cycles across the box. Ripple and turbulence: waves or noise features per 100 pixels. Default 1; ignored by other types.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="phase" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Shifts the pattern: a phase in degrees for wave and ripple, a scroll of the noise field for turbulence. Default 0; ignored by other types.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="axis" type="xs:string" default="y">
      <xs:annotation><xs:documentation>Direction, x or y (default y; any other value acts as y), along which bend and wave displace points and squash and stretch scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rows" type="gridSizeType" default="4">
      <xs:annotation><xs:documentation>Mesh-warp: number of control-point rows in the warp grid (2 to 16, default 4); the point children address them by row.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cols" type="gridSizeType" default="4">
      <xs:annotation><xs:documentation>Mesh-warp: number of control-point columns in the warp grid (2 to 16, default 4); the point children address them by col.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerX" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal centre of the effect in pixels from the left of the node's box; defaults to the middle of the box. Used by bend, twist, squash, stretch, bulge, pinch, spherize and ripple.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerY" type="xs:double">
      <xs:annotation><xs:documentation>Vertical centre of the effect in pixels from the top of the node's box; defaults to the middle of the box. Used by bend, twist, squash, stretch, bulge, pinch, spherize and ripple.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Reach in pixels around the centre, fading to nothing at the edge (twist, bulge, pinch, spherize, ripple). Defaults to half the shorter box side; for ripple, absent means no fade.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Turbulence only: seed of the noise field; the same seed gives the same displacement. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skeleton" type="xs:IDREF">
      <xs:annotation><xs:documentation>Skin only: the id of the skeleton whose bones deform the node. A reference that names no skeleton leaves the node undeformed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="corners" type="numberListType">
      <xs:annotation><xs:documentation>corner-pin: 8 numbers x0 y0 x1 y1 x2 y2 x3 y3 (TL, TR, BR, BL).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="deformType">
    <xs:sequence><xs:element name="modifier" type="modifierType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="boneType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the bone; child bones name it in parent, skin weights use it, and constraints can target it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parent" type="xs:IDREF">
      <xs:annotation><xs:documentation>The id of the parent bone in the same skeleton; this bone is posed in the parent's space. Absent or unknown: the bone hangs directly on the skeleton.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal offset of the bone's origin from its parent's origin, in the parent bone's space (x runs along the parent bone). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical offset of the bone's origin from its parent's origin, in the parent bone's space (y runs across the parent bone). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the bone relative to its parent, in degrees, clockwise on screen. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Length of the bone along its own x axis, in the bone's own units (its scaleX and its ancestors' scales stretch it); its tip is where inverse kinematics reaches and where automatic skin weights measure from. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the bone, and of its children, along its own x axis. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the bone, and of its children, along its own y axis. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="skeletonType">
    <xs:annotation><xs:documentation>2D bone hierarchy; bind to a node with a deform modifier type="skin" skeleton="id". Bones accept transformConstraint type="ik".</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="bone" type="boneType"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the skeleton; a skin modifier's skeleton attribute refers to it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="weights" type="xs:anyURI">
      <xs:annotation><xs:documentation>JSON file {points, weights} of per-point bone weights in skeleton space; each weights entry maps bone ids to weights (an unknown id is an error). A point takes the nearest sample; absent: automatic weights.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== physics per node -->
  <xs:complexType name="rigidBodyType">
    <xs:attribute name="type" default="dynamic">
      <xs:annotation><xs:documentation>static: fixed at its start pose; kinematic: follows its animation and pushes other bodies; dynamic (default): moved by the simulation.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="static"/><xs:enumeration value="kinematic"/>
        <xs:enumeration value="dynamic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shape" type="xs:string" default="box">
      <xs:annotation><xs:documentation>box, circle, capsule, polygon, convex-hull (from alpha) or path.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>SVG path data, in the node's own pixels from the top-left of its box, outlining the collider when shape is polygon (convex hull) or path (concave outline). Without it a box is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mass" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Mass of a dynamic body in kilograms. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="friction" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Surface friction from 0 (frictionless) to 1; against the world bounds the body's own value is used. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="restitution" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Bounciness from 0 (no bounce) to 1 (fully elastic); against the world bounds the body's own value is used. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="linearDamping" type="unitDecimal" default="0.01">
      <xs:annotation><xs:documentation>Damping that gradually slows the body's linear motion, from 0 (none) to 1. Default 0.01.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularDamping" type="unitDecimal" default="0.01">
      <xs:annotation><xs:documentation>Damping that gradually slows the body's rotation, from 0 (none) to 1. Default 0.01.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial horizontal velocity in pixels per second, positive to the right; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial vertical velocity in pixels per second, positive downward; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocity" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation speed in degrees per second, clockwise on screen; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Circle collider radius in pixels (scaled with the node); used only when shape is circle. Absent or 0: half the shorter side of the node's box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collisionGroup" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Collision group number of the body, 0 to 31 (larger values act as 31). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collidesWith" type="xs:string" default="all">
      <xs:annotation><xs:documentation>Groups the body collides with: all (default) or group numbers separated by spaces or commas. Two bodies collide only if each lists the other's group.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sensor" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body is not solid: it exerts no contact forces and others pass through it. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixedRotation" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body cannot rotate, whatever hits it. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bullet" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body uses continuous collision detection, so fast motion does not tunnel through thin colliders. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="activateAt" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds from which a dynamic body is simulated; before it, the body follows its animation, ignoring gravity, forces and contacts. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="rigidBody3DType">
    <xs:annotation><xs:documentation>
      A rigid body in 3D on an object3D: the simulation moves the object from its pose at
      physics@start (its position and rotations, in its parent's frame); from then on the
      simulation, not its own attributes, places it (a kinematic body follows its animation).
      shape="auto" takes the primitive's own form (box, sphere, cylinder, cone, capsule; a plane
      is a box one unit deep; text is a box) and the convex hull of the triangles of any other
      primitive; convex-hull, trimesh (exact triangles, for static and kinematic scenery) and
      decomposition (convex parts of a closed mesh) use the object's triangles. Sizes follow the
      object's scale at the start. Velocities are pixels per second in scene axes (y down, z away
      from the camera), angular velocities degrees per second about the scene axes.
    </xs:documentation></xs:annotation>
    <xs:attribute name="type" default="dynamic">
      <xs:annotation><xs:documentation>static: keeps its start pose; kinematic: follows its animation and pushes other bodies; dynamic (default): moved by the simulation.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="static"/><xs:enumeration value="kinematic"/>
        <xs:enumeration value="dynamic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shape" default="auto">
      <xs:annotation><xs:documentation>Collider: auto uses the primitive's own box, sphere, cylinder, cone or capsule where it fits, else a hull or mesh of its triangles; other values force that form (trimesh: static or kinematic only; voxels: the cells).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="auto"/><xs:enumeration value="box"/>
        <xs:enumeration value="sphere"/><xs:enumeration value="capsule"/>
        <xs:enumeration value="cylinder"/><xs:enumeration value="cone"/>
        <xs:enumeration value="convex-hull"/><xs:enumeration value="trimesh"/>
        <xs:enumeration value="decomposition"/><xs:enumeration value="voxels"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mass" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Total mass of the body in kilograms; default 1. A body of cells takes its mass from density instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="density" type="positiveDecimal">
      <xs:annotation><xs:documentation>
        Kilograms per cubic metre, for a body of cells (VOX9, VOX10): its mass is the number of cells times the volume of one (cellSize times the object's
        scale, over the scene's pixelsPerMeter, cubed) times this. Required with cells as the collider, and `mass` is then not given.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxFragments">
      <xs:annotation><xs:documentation>
        A body of cells that a crater or a fracture can break gets this many slots (bodies that wait, one cell each, until a cut frees a part of it): 1 to 4096; the
        engine's value is 64, and it is not an XSD default so that it can be refused where there is nothing to cut (VOX11). The world refuses more fragments
        than slots (see fragmentOverflow).
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fragmentMinCells" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>
        Loose parts of a cut with fewer cells than this are dust: they leave the body and become particles (VOX11). The engine's value is 1.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fragmentOverflow">
      <xs:annotation><xs:documentation>
        What a cut does when it frees more parts than there are slots (VOX11): `error` names both numbers, `dust` makes the smallest parts dust. The engine's value is error.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="error"/><xs:enumeration value="dust"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="anchor">
      <xs:annotation><xs:documentation>
        Which part of what a crater's cut leaves stays the body (VOX12): `base`, every part that touches the base layer (the cells of the greatest y key, the lowest
        layer in the scene's axes, y down), the way ground is held by what is under it, or `largest`, the largest connected part. Only an owner with a crater has it, and
        that owner is static or kinematic (CRT5), so the engine's value when it is not given is `base`: a dynamic body, whose cut would leave its largest part, has no
        anchor to give.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="largest"/><xs:enumeration value="base"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="friction" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Surface friction from 0 (frictionless) to 1; between two bodies the average of their values is used. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="restitution" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Bounciness from 0 (no bounce) to 1; between two bodies the average of their values is used. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="linearDamping" type="unitDecimal" default="0.01">
      <xs:annotation><xs:documentation>Linear damping coefficient in 1/s (0 to 1): each step divides the linear velocity by 1 plus this value times the step length. Default 0.01.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularDamping" type="unitDecimal" default="0.01">
      <xs:annotation><xs:documentation>Angular damping coefficient in 1/s (0 to 1): each step divides the angular velocity by 1 plus this value times the step length. Default 0.01.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial horizontal velocity in pixels per second (scene axes), positive to the right; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial vertical velocity in pixels per second (scene axes), positive downward; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial depth velocity in pixels per second (scene axes), positive away from the camera; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation speed about the scene x axis in degrees per second; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation speed about the scene y axis in degrees per second; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation speed about the scene z axis in degrees per second; applies only to dynamic bodies, when they start to be simulated. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collisionGroup" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Collision group number of the body, 0 to 31 (larger values act as 31). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collidesWith" type="xs:string" default="all">
      <xs:annotation><xs:documentation>Groups the body collides with: all (default) or group numbers separated by spaces or commas. Two bodies collide only if each lists the other's group.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sensor" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body is not solid: it exerts no contact forces and others pass through it. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixedRotation" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body cannot rotate, whatever hits it. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bullet" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true the body uses continuous collision detection, so fast motion does not tunnel through thin colliders. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="activateAt" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds from which a dynamic body is simulated; before it, the body follows its animation, ignoring gravity, forces and contacts. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="softBodyType">
    <xs:attribute name="mass" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Total mass of the soft body in kilograms, shared equally among its simulated points (a rope simulates only its chain points). Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stiffness" type="positiveDecimal" default="20">
      <xs:annotation><xs:documentation>Stiffness in newtons per metre of the lattice springs (a cloth's shear and bend springs use weaker fractions of it); higher values hold the shape more rigidly. Default 20.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="damping" type="unitDecimal" default="0.1">
      <xs:annotation><xs:documentation>Damping along each spring, as a fraction of 2*sqrt(spring stiffness * point mass); 0 adds none and larger values resist the springs' relative motion more strongly. Default 0.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressure" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Jelly only: strength of the force that pushes the outline outward when its area falls below the rest area and inward when it grows; 0 (default) adds none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rows" type="gridSizeType" default="4">
      <xs:annotation><xs:documentation>Number of lattice rows (2 to 16, default 4); jelly and cloth have rows+1 point rows. A rope is one chain of cols points, whatever rows is.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cols" type="gridSizeType" default="4">
      <xs:annotation><xs:documentation>Number of lattice columns (2 to 16, default 4); jelly and cloth have cols+1 point columns, a rope has this many points along its chain.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pin" default="none">
      <xs:annotation><xs:documentation>Lattice points held fixed: none (default), the top, bottom, left or right edge, or the four corners. A rope's chain point is held when any lattice point in its column is.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="top"/>
        <xs:enumeration value="bottom"/><xs:enumeration value="left"/>
        <xs:enumeration value="right"/><xs:enumeration value="corners"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="kind" default="jelly">
      <xs:annotation><xs:documentation>jelly (default): a lattice of full-strength springs, optionally pressurised; cloth: a sheet with weak shear and bend springs so it drapes; rope: a single chain of points along the middle of the box.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="jelly"/><xs:enumeration value="cloth"/><xs:enumeration value="rope"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="selfCollision" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, lattice points closer than half the shortest spring rest length push each other apart; false (default) lets the body pass through itself.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== text animation -->
  <xs:complexType name="textAnimatorType">
    <xs:annotation><xs:documentation>
      Per-character/word/line animation of a text layer (After Effects text
      animators, Lottie t.a, Rive text modifiers). A range selector picks the
      units in [start, end] + offset (percent or index) with a falloff @shape;
      each selected unit receives the property offsets below scaled by the
      selection amount. @stagger/@overlap give preset-style sequential timing.
      @preset expands to a documented animator (typewriter, word-by-word, ...).
      A nested expression with property="selector" makes an expression selector.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="preset">
      <xs:annotation><xs:documentation>Applies a built-in text animation (such as typewriter, fade-in, wave or counter); explicit property attributes override the preset's values. Of the selector only order, amount and seed take part, not the range window.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="typewriter"/><xs:enumeration value="fade-in"/>
        <xs:enumeration value="fade-out"/><xs:enumeration value="word-by-word"/>
        <xs:enumeration value="letter-by-letter"/><xs:enumeration value="line-by-line"/>
        <xs:enumeration value="slide-up"/><xs:enumeration value="slide-down"/>
        <xs:enumeration value="slide-left"/><xs:enumeration value="slide-right"/>
        <xs:enumeration value="pop"/><xs:enumeration value="scale-in"/>
        <xs:enumeration value="blur-in"/><xs:enumeration value="wave"/>
        <xs:enumeration value="bounce"/><xs:enumeration value="spin"/>
        <xs:enumeration value="ascend"/><xs:enumeration value="shift"/>
        <xs:enumeration value="scramble"/><xs:enumeration value="counter"/>
        <xs:enumeration value="karaoke"/><xs:enumeration value="highlight"/>
        <xs:enumeration value="tracking-in"/><xs:enumeration value="mask-reveal"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="presetStart" type="xs:double">
      <xs:annotation><xs:documentation>Time on the layer's parent timeline (composition time for a top-level layer), not an offset from the layer's start; when absent the preset starts at the layer's own start.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="presetDuration" type="positiveDecimal">
      <xs:annotation><xs:documentation>Length in seconds of the preset's run across all its units when no stagger is given; 1 second when absent. Has no effect without a preset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="presetEase">
      <xs:annotation><xs:documentation>
        The curve of a preset, in place of the preset's own (most use cubic-out, which is front-loaded: at 40 % of the
        duration it is 78 % done). Without @preset it has no effect.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="quad-in"/><xs:enumeration value="quad-out"/>
        <xs:enumeration value="cubic-out"/><xs:enumeration value="expo-out"/><xs:enumeration value="back-out"/>
        <xs:enumeration value="bounce-out"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="unit" default="character">
      <xs:annotation><xs:documentation>Which text units the animator selects: each character, each non-space character, each word, each line, or each span. A preset's own unit is replaced only by a value other than character.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="character"/><xs:enumeration value="character-no-space"/>
        <xs:enumeration value="word"/><xs:enumeration value="line"/><xs:enumeration value="span"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="span" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>Restrict to the span whose @role matches.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="selector" default="range">
      <xs:annotation><xs:documentation>Selection method: range (a start/end window with a falloff), wiggly (animated noise), or expression. A nested expression with property="selector" always selects the expression method.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="range"/><xs:enumeration value="wiggly"/><xs:enumeration value="expression"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rangeUnits" default="percent">
      <xs:annotation><xs:documentation>Whether @start, @end and @offset of the range selector are percentages of the unit count (percent) or zero-based unit indices (index). Not used when @preset is set.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="percent"/><xs:enumeration value="index"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Start of the range selector window, in percent of the units or in unit indices (see @rangeUnits); 0 by default. Not used when @preset is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double" default="100">
      <xs:annotation><xs:documentation>End of the range selector window, in percent of the units or in unit indices (see @rangeUnits); 100 by default. Not used when @preset is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Shifts the whole range selector window by this amount, in percent of the units or in unit indices (see @rangeUnits). Not used when @preset is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amount" type="percentType" default="100">
      <xs:annotation><xs:documentation>Selection strength in percent (default 100): selected units get this share of the animator's property offsets; negative values reverse them. For the wiggly selector it is the noise amplitude.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" default="square">
      <xs:annotation><xs:documentation>Falloff of the range selector across its window: square (hard edge), ramp-up, ramp-down, triangle, round or smooth (raised cosine). Outside the window the others give 0; ramp-up gives 1 after it, ramp-down 1 before.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="square"/><xs:enumeration value="ramp-up"/>
        <xs:enumeration value="ramp-down"/><xs:enumeration value="triangle"/>
        <xs:enumeration value="round"/><xs:enumeration value="smooth"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="smoothness" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>For the square shape only, blends from a hard edge (0) to fractional coverage of the units at the window's ends (1, default). Not used when @preset is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="easeHigh" type="percentType" default="0">
      <xs:annotation><xs:documentation>Percent. Together with @easeLow, blends the range falloff toward a smooth-step curve by (easeHigh + easeLow) / 200, clamped to 0-1; 0 leaves the shape unchanged. Not used with @preset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="easeLow" type="percentType" default="0">
      <xs:annotation><xs:documentation>Percent. Together with @easeHigh, blends the range falloff toward a smooth-step curve by (easeHigh + easeLow) / 200, clamped to 0-1; 0 leaves the shape unchanged. Not used with @preset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="order" default="forward">
      <xs:annotation><xs:documentation>Order in which units are placed along the range selector window: forward, reverse, center-out, edges-in, or a seeded random permutation. A preset takes its unit order from it too. Range selector only.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="forward"/><xs:enumeration value="reverse"/>
        <xs:enumeration value="center-out"/><xs:enumeration value="edges-in"/>
        <xs:enumeration value="random"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="stagger" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Delay in seconds between the starts of consecutive units, for presets other than typewriter, word-by-word, wave, scramble and counter. Absent, the delay follows from presetDuration and the overlap.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="overlap" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Fraction 0-1 of each unit's window that overlaps the previous unit's, for presets other than typewriter, word-by-word, wave, scramble and counter. 0 or absent keeps the preset's own overlap.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed for this animator's random order and wiggly selector, combined with the project seed (alone when absent); scramble letters also depend on the seeds of every animator on the layer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="wiggleRate" type="nonNegativeDecimal" default="2">
      <xs:annotation><xs:documentation>Speed of the wiggly selector's noise, in noise steps per second (default 2). Only used with selector wiggly, and not when @preset is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="combine" default="add">
      <xs:annotation><xs:documentation>How offsets (position, rotation, skew, tracking, ...) combine with earlier animators on a unit: add, multiply as 1+(v-1)*selection, or replace. Scale and opacity always multiply, or replace.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="add"/><xs:enumeration value="multiply"/><xs:enumeration value="replace"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <!-- property offsets applied to selected units -->
    <xs:attribute name="x" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal offset in pixels, applied to a unit in proportion to its selection. On text with a textPath it is applied before placement on the path, so it follows the glyph direction unless perpendicular is off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double">
      <xs:annotation><xs:documentation>Vertical offset in pixels (positive is down), applied to a unit in proportion to its selection. With a textPath it is applied before placement on the path, so it follows the glyph direction unless perpendicular is off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zDepth" type="xs:double">
      <xs:annotation><xs:documentation>Depth offset in pixels at full selection; larger values push the unit away and shrink it with a perspective factor of 1000 / (1000 + z).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="xs:double">
      <xs:annotation><xs:documentation>Uniform scale factor at full selection (1 = unchanged); a unit's scale is 1 + (scale - 1) times its selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal scale factor at full selection (1 = unchanged), multiplied with @scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double">
      <xs:annotation><xs:documentation>Vertical scale factor at full selection (1 = unchanged), multiplied with @scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double">
      <xs:annotation><xs:documentation>Rotation in degrees about the unit's pivot, applied in proportion to its selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double">
      <xs:annotation><xs:documentation>Rotation in degrees about the horizontal axis, shown as vertical foreshortening by the cosine of the angle.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double">
      <xs:annotation><xs:documentation>Rotation in degrees about the vertical axis, shown as horizontal foreshortening by the cosine of the angle.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skew" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal skew angle in degrees, applied in proportion to the unit's selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal">
      <xs:annotation><xs:documentation>Opacity factor 0-1 at full selection (1 = unchanged); a unit's opacity is multiplied by 1 + (opacity - 1) times its selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType">
      <xs:annotation><xs:documentation>Fill paint that selected units blend toward by their selection share (clamped to 0-1); gradient and image paints switch at half share instead. For the highlight preset it is the box paint instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType">
      <xs:annotation><xs:documentation>Stroke paint that selected units blend toward by their selection share (clamped to 0-1); gradient and image paints switch at half share. A unit without a stroke gets one only if strokeWidth or the share is above 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Stroke width offset in pixels, added to the unit's stroke width in proportion to its selection. It shows only where the unit has a stroke, from the text style or from @stroke.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tracking" type="xs:double">
      <xs:annotation><xs:documentation>Extra space after each unit's characters, in thousandths of an em, applied in proportion to the selection; it accumulates along the line.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineSpacing" type="xs:double">
      <xs:annotation><xs:documentation>Extra vertical offset in pixels per line index (line 0 unchanged, line 1 once, ...), applied in proportion to the selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blur" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Blur radius in pixels at full selection, scaled by the unit's selection; a radius under 0.5 px draws no blur.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="baselineShift" type="xs:double">
      <xs:annotation><xs:documentation>Baseline shift in pixels; positive raises the unit, applied in proportion to its selection.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="characterOffset" type="xs:integer">
      <xs:annotation><xs:documentation>Shifts each letter A-Z, a-z or digit by this many positions (rounded, scaled by the unit's selection) within its own class, wrapping; other characters, including non-ASCII letters, are unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="variation" type="xs:string">
      <xs:annotation><xs:documentation>Variable-font axis targets such as "wght 700, wdth 80"; selected units move toward these axis values by their selection share.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anchorX" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal offset in pixels of the pivot for rotation, scale and skew from the centre of the unit's box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anchorY" type="xs:double">
      <xs:annotation><xs:documentation>Vertical offset in pixels of the pivot for rotation, scale and skew from the vertical centre of the unit's line box.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="textPathType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="path" type="xs:string" use="required">
      <xs:annotation><xs:documentation>SVG path data (any command, absolute or relative) along which the text's glyphs are placed, in the text layer's own pixel space.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="startOffset" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Distance along the path where the text starts, in pixels or as a percentage of the path length; 0 by default. A vw, vh, vmin or vmax value is read as plain pixels. Not used when @forceAlignment is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="firstMargin" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Pixels added to the starting position of the text on the path; with @forceAlignment it is the inset at the path's start.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lastMargin" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Inset in pixels at the path's end that the text is spread to; used only with @forceAlignment, otherwise it has no effect.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the text runs along the path from its end to its start; false by default.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="perpendicular" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true (default), each glyph rotates to follow the path's direction; when false, glyphs keep their orientation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceAlignment" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the first line of text is stretched or squeezed to fill the path between @firstMargin and @lastMargin, ignoring @startOffset; false by default.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== shape modifiers -->
  <xs:complexType name="shapeModifierType">
    <xs:annotation><xs:documentation>
      Procedural path operators applied in document order (Lottie/After Effects
      shape modifiers): repeater, offset-path, pucker-bloat, zig-zag, twist,
      round-corners, wiggle-path, merge (mode), trim (sequential across paths).
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>The procedural operator applied to the shape's outline: repeater, offset-path, pucker-bloat, zig-zag, twist, round-corners, wiggle-path, merge or trim. Modifiers apply in document order.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="repeater"/><xs:enumeration value="offset-path"/>
        <xs:enumeration value="pucker-bloat"/><xs:enumeration value="zig-zag"/>
        <xs:enumeration value="twist"/><xs:enumeration value="round-corners"/>
        <xs:enumeration value="wiggle-path"/><xs:enumeration value="merge"/>
        <xs:enumeration value="trim"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="copies" type="xs:double" default="3">
      <xs:annotation><xs:documentation>Number of copies a repeater draws, rounded down (default 3; 0 draws none). Values above 10 000 are rejected, and copies times the shapes being repeated are capped at 65 536, dropping the excess.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Repeater: shifts the copy index at which the per-copy transform starts. Trim: rotates the trimmed section along the outline, in degrees (360 = one full length).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amount" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Strength of the operator: offset-path distance in pixels, pucker-bloat in percent, twist in degrees at the farthest point, round-corners radius in pixels, trim in percent cut from the end.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="xs:double" default="10">
      <xs:annotation><xs:documentation>Wiggle-path: peak displacement of the points; zig-zag: distance every other point is offset from the path. Both in pixels, default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ridges" type="xs:nonNegativeInteger" default="5">
      <xs:annotation><xs:documentation>Zig-zag: number of ridges per path segment (default 5); clamped to 1-1024, and values above 10000 are rejected.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frequency" type="xs:double" default="2">
      <xs:annotation><xs:documentation>Wiggle-path: how fast the displacement changes, in noise steps per second (default 2).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="detail" type="xs:double" default="10">
      <xs:annotation><xs:documentation>Wiggle-path: number of points the outline is resampled to per 100 pixels of its length (default 10), at least 3 per outline.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Wiggle-path: seed of the random displacement; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>merge: add|subtract|intersect|exclude; zig-zag and wiggle-path: corner|smooth
      (wiggle-path smooth joins the wiggled points with a Catmull-Rom spline through them instead of straight lines);
      offset-path join: miter|round|bevel.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Repeater: horizontal shift in pixels applied cumulatively per copy (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Repeater: vertical shift in pixels applied cumulatively per copy (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Repeater: rotation in degrees applied cumulatively per copy, about the shape's centre (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Repeater: scale factor applied cumulatively per copy about the shape's centre (default 1): each copy is scaled by this factor to the power of its index. A value of 0 or less is treated as a tiny positive number.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="startOpacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Repeater: opacity 0-1 of the first copy (default 1); opacity changes linearly to @endOpacity at the last copy.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="endOpacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Repeater: opacity 0-1 of the last copy (default 1), reached linearly from @startOpacity.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="composite" default="above">
      <xs:annotation><xs:documentation>Repeater: whether later copies are drawn above (default) or below earlier ones.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="above"/><xs:enumeration value="below"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== node types -->
  <xs:group name="nodeBehaviour">
    <xs:choice>
      <xs:group ref="animationElements"/>
      <xs:element name="mask" type="maskType"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
  </xs:group>
  <xs:group name="bodyBehaviour">
    <xs:choice>
      <xs:element name="rigidBody" type="rigidBodyType"/>
      <xs:element name="softBody" type="softBodyType"/>
      <xs:element name="deform" type="deformType"/>
    </xs:choice>
  </xs:group>

  <xs:complexType name="layerType">
    <xs:annotation><xs:documentation>
      Places an asset. timeRemap, when present, replaces speed/reverse/loop.
      fit/boxWidth/boxHeight scale the asset into a box (responsive media);
      crop* trim fractions of the source. textAnimator and textPath apply when
      the asset is text. volume/mute control a video asset's own audio, which
      is mixed into audioMix bus @audioBus (default: master).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="bodyBehaviour"/>
      <xs:element name="timeRemap" type="timeRemapType"/>
      <xs:element name="textAnimator" type="textAnimatorType"/>
      <xs:element name="textPath" type="textPathType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="asset" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the asset this layer draws. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Compositing mode that combines the layer with the content beneath it in its parent; normal (default) draws it over, the others combine by the named rule (multiply, screen, add, stencil-alpha, behind, ...).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Space-separated ids of effects applied to the layer's picture, in the order listed; disabled effects are skipped.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipIn" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds into the source media at which playback starts; absent means 0, the start of the media. A timeRemap on the layer gives source time directly, so clipIn is not added.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipOut" type="xs:double">
      <xs:annotation><xs:documentation>Seconds into the source media at which the clip ends; with clipIn it sets the clip length used for the layer's duration, looping and reversing. Absent means the end of the media.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="loop" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Number of extra plays of the clip after the first, so 2 plays it three times; 0 (default) plays it once. Needs a clip length from a video or image-sequence asset, or clipOut; a timeRemap ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the clip plays backwards, from its end to its start; this needs a clip length from the media or clipOut. A negative speed reverses it as well and the two cancel; a timeRemap ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Playback rate as a multiple of normal speed (1 = normal, 2 = twice as fast); a negative value plays backwards and 0 holds a single frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeStretch" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Divisor of the playback rate, which is speed / timeStretch: 2 plays at half speed, so the clip lasts twice as long. 1 (default) changes nothing. Ignored when the layer has a timeRemap.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="freezeAt" type="xs:double">
      <xs:annotation><xs:documentation>Layer-local time in seconds whose source frame is held for the layer's whole window; absent means normal playback.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frameBlend" default="none">
      <xs:annotation><xs:documentation>How a video layer shows a time between two source frames: none holds the earlier frame, frame-mix cross-fades the two, optical-flow warps them along motion. With none, a timeRemap child's own frameBlend applies.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="frame-mix"/><xs:enumeration value="optical-flow"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="resample" default="linear">
      <xs:annotation><xs:documentation>The filter used where the layer is drawn larger than its source. linear: bilinear (the default). bicubic: Catmull-Rom, with a clamp to the range of the four nearest texels. mitchell: Mitchell-Netravali with B = C = 1/3, with the same clamp. Where the layer is drawn at or below its source size every layer uses trilinear mip filtering whatever @resample says.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="bicubic"/><xs:enumeration value="mitchell"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fit" type="fitType" default="none">
      <xs:annotation><xs:documentation>How the asset is scaled into the box of boxWidth and boxHeight (both required unless none): contain, cover, fill, scale-down, contain-blur (contain over a blurred cover); none (default) keeps natural size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boxWidth" type="positiveLengthType">
      <xs:annotation><xs:documentation>Width of the box the asset is fitted into: pixels, or a percentage of the parent box or vw/vh/vmin/vmax. Required together with boxHeight when fit is not none; unused when fit is none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boxHeight" type="positiveLengthType">
      <xs:annotation><xs:documentation>Height of the box the asset is fitted into: pixels, or a percentage of the parent box or vw/vh/vmin/vmax. Required together with boxWidth when fit is not none; unused when fit is none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusX" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Horizontal position, 0 (left) to 1 (right), of the fitted content in spare box space (contain) or of the visible part of the overflow (cover). Default 0.5, centred.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusY" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Vertical position, 0 (top) to 1 (bottom), of the fitted content in spare box space (contain) or of the visible part of the overflow (cover). Default 0.5, centred.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cropLeft" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Fraction of the source width, 0 to 1, trimmed from the left edge before fitting; default 0 keeps the whole edge.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cropTop" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Fraction of the source height, 0 to 1, trimmed from the top edge before fitting; default 0 keeps the whole edge.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cropRight" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Fraction of the source width, 0 to 1, trimmed from the right edge before fitting; default 0 keeps the whole edge.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cropBottom" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Fraction of the source height, 0 to 1, trimmed from the bottom edge before fitting; default 0 keeps the whole edge.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="flipX" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, mirrors the asset horizontally after cropping.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="flipY" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, mirrors the asset vertically after cropping.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stabilize" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, counter-moves the layer to cancel the camera shake of the motion track whose footage is this layer's asset, keeping the smoothed motion. No such track means no effect.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stabilizeSmoothness" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>How much of the tracked motion is removed, 0 to 1: the layer follows the track smoothed by a Gaussian of 2 x value seconds standard deviation, and 1 locks it to the track's first sample. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="volume" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Level of a video asset's own audio as a fraction from 0 (silent) to 1 (unchanged, default); it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mute" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, silences the audio of the layer's video asset; default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioBus" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the audioMix bus that receives the layer's video audio; absent sends it to the master output.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== parametric geometry (SREP 70, scene version 1.6) -->
  <xs:complexType name="parametricPathType">
    <xs:annotation><xs:documentation>
      The outline of a shape="parametric": the points (x(t), y(t)) at N = samples values of t from t0 to t1 (to t1
      minus one step with closed="true"), in the shape's local pixel space, joined by lines and closed when closed is
      true. x and y are expressions of the expression language (expressionType) with the variable t, evaluated in
      64-bit floats at each frame. A non-finite point is dropped and breaks the path. SREP 70.
    </xs:documentation></xs:annotation>
    <xs:attribute name="x" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the x coordinate of the outline in the shape's local pixel space, as a function of t; evaluated at every frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the y coordinate of the outline in the shape's local pixel space, as a function of t; evaluated at every frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="t0" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Value of t at the first sample of the outline; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="t1" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Value of t at the last sample; with closed true the last sample stops one step short of it. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="samples" default="256">
      <xs:annotation><xs:documentation>Number of values of t, from 2 to 1000000, at which the curve is sampled and joined by straight lines; default 256. Values outside the range are invalid.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="2"/><xs:maxInclusive value="1000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="closed" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the outline is closed back to its first point and the last sample stops one step short of t1; default false.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:simpleType name="surfaceSamplesType">
    <xs:restriction base="xs:positiveInteger"><xs:minInclusive value="2"/><xs:maxInclusive value="4096"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="parametricSurfaceType">
    <xs:annotation><xs:documentation>
      The mesh of an object3D with primitive="parametric": the vertices (x, y, z)(u, v) on a uSamples x vSamples grid
      over [u0, u1] x [v0, v1], in the object's local space before its transform, two triangles per grid cell (the
      last row or column joins the first in a closed direction). The vertex normal is the unit vector of
      D_v x D_u (central differences); a triangle faces the camera when its vertex normals do. x, y and z are
      expressions with the variables u and v. SREP 70.
    </xs:documentation></xs:annotation>
    <xs:attribute name="x" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the x coordinate of each mesh vertex in the object's local space, as a function of u and v.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the y coordinate of each mesh vertex in the object's local space, as a function of u and v.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the z coordinate of each mesh vertex in the object's local space, as a function of u and v.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="u0" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Value of u at the first vertex along the u direction of the grid; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="u1" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Value of u at the last vertex along the u direction of the grid (one step short of it when closedU is true); default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="v0" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Value of v at the first vertex along the v direction of the grid; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="v1" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Value of v at the last vertex along the v direction of the grid (one step short of it when closedV is true); default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="uSamples" type="surfaceSamplesType" default="64">
      <xs:annotation><xs:documentation>Number of grid vertices along u, from 2 to 4096; default 64. Values outside the range are invalid.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="vSamples" type="surfaceSamplesType" default="64">
      <xs:annotation><xs:documentation>Number of grid vertices along v, from 2 to 4096; default 64. Values outside the range are invalid.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="closedU" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the mesh wraps around in u: the last vertex along u joins the first and u1 is not sampled. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="closedV" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the mesh wraps around in v: the last vertex along v joins the first and v1 is not sampled. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="heightfieldType">
    <xs:annotation><xs:documentation>
      The mesh of an object3D with primitive="heightfield": the parametricSurface with u = z over [-depth/2, depth/2]
      (zSamples), v = x over [-width/2, width/2] (xSamples) and vertices (x, -height(x, z), z), so that a flat
      heightfield's top face (normal -y, up) is its front face. height is an expression with the variables x and z.
      SREP 70.
    </xs:documentation></xs:annotation>
    <xs:attribute name="height" type="expressionString" use="required">
      <xs:annotation><xs:documentation>Expression for the surface height at (x, z) in the object's local space; a positive height raises the surface (the vertex y is minus the height).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Extent of the heightfield along x, centred on the origin, in local units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Extent of the heightfield along z, centred on the origin, in local units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="xSamples" type="surfaceSamplesType" default="64">
      <xs:annotation><xs:documentation>Number of grid vertices along x, from 2 to 4096; default 64. Values outside the range are invalid.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zSamples" type="surfaceSamplesType" default="64">
      <xs:annotation><xs:documentation>Number of grid vertices along z, from 2 to 4096; default 64. Values outside the range are invalid.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="shapeType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="bodyBehaviour"/>
      <xs:element name="shapeModifier" type="shapeModifierType"/>
      <xs:element name="parametricPath" type="parametricPathType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="shape" use="required">
      <xs:annotation><xs:documentation>Kind of outline drawn: rect, rounded-rect, ellipse, polygon, star, line (across the middle of the box), path (from @path), stroke-text (from @text) or parametric (from a parametricPath).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="rect"/><xs:enumeration value="ellipse"/>
        <xs:enumeration value="rounded-rect"/><xs:enumeration value="polygon"/>
        <xs:enumeration value="star"/><xs:enumeration value="line"/>
        <xs:enumeration value="path"/><xs:enumeration value="stroke-text"/>
        <xs:enumeration value="parametric"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="positiveLengthType">
      <xs:annotation><xs:documentation>Width of the shape's box: pixels, or a percentage of the parent box or vw/vh/vmin/vmax. Required unless the shape takes its box from a region or is parametric.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveLengthType">
      <xs:annotation><xs:documentation>Height of the shape's box: pixels, or a percentage of the parent box or vw/vh/vmin/vmax. Required unless the shape takes its box from a region or is parametric.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>Outline as SVG path data (all absolute and relative commands, arcs included), in the shape's local pixel space; used by shape="path".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation><xs:documentation>The string drawn as pen strokes by shape="stroke-text"; a line feed starts a new line. Required with stroke-text; ignored on other shape kinds.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeFont" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the strokeFont asset whose single-line glyphs lay out the text of a stroke-text shape. Required with stroke-text; ignored on other shape kinds.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontSize" type="positiveDecimal" default="48">
      <xs:annotation><xs:documentation>Cap height, in local units, of the glyphs of a stroke-text shape; default 48. Ignored on other shape kinds.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillRule" type="fillRuleType" default="nonzero">
      <xs:annotation><xs:documentation>Rule that decides which areas of a self-overlapping outline are inside the fill: nonzero (default) or evenodd.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Corner radius in local units for rect and rounded-rect shapes; default 0 gives square corners. Radii that do not fit are scaled down. cornerRadii overrides it; other shape kinds ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cornerRadii" type="numberListType">
      <xs:annotation><xs:documentation>Per-corner radii TL TR BR BL; overrides radius.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="points" type="xs:positiveInteger" default="5">
      <xs:annotation><xs:documentation>Number of vertices of a polygon or tips of a star; default 5. Values below 3 (polygon) or 2 (star) are raised to that minimum. Other kinds ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerRadius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Radius, in local units around the box centre, of a star's inner vertices; absent means half the outer radius. Only stars read it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outerRadius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Radius, in local units around the box centre, of a polygon's vertices or a star's tips; absent means the ellipse inscribed in the box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerRoundness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Rounding of a star's inner vertices from 0 (sharp, default) up to 1; larger values give longer curved tangent handles. Only stars read it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outerRoundness" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Rounding of a polygon's vertices or a star's tips from 0 (sharp, default) up to 1; larger values give longer curved tangent handles.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Paint (colour or url(#id) of a gradient, pattern or noise) that fills the outline; default opaque white. Not used by stroke-text.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#00000000">
      <xs:annotation><xs:documentation>Paint (colour or url(#id) of a gradient, pattern or noise) for the outline; default fully transparent. The outline is drawn only when strokeWidth is above 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Width of the outline stroke in local units; default 0, which draws no stroke. Nothing is drawn either while the stroke paint is transparent (its default).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Compositing mode that combines the shape with the content beneath it in its parent; normal (default) draws it over, the others combine by the named rule (multiply, screen, add, stencil-alpha, behind, ...).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Space-separated ids of effects applied to the shape's picture, in the order listed; disabled effects are skipped.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="strokeStyle"/>
    <xs:attributeGroup ref="trimPath"/>
    <xs:attributeGroup ref="strokeMarkers"/>
    <xs:attribute name="region" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a region of a pdf asset: the shape takes its box from it (grown by regionPadding) and follows the layer named by regionLayer. Its width and height are unused; it must have no parent and no transformConstraint.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="regionLayer" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the layer that shows the pdf page; a shape with a region is placed through that layer and is not drawn while the layer is out of the frame. Required with region.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="regionPadding" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Margin added on every side of the region's box, in the page image's pixels; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="connectorType">
    <xs:annotation><xs:documentation>
      A line between two nodes (or fixed points) that is recomputed every frame, so it stays attached
      while they move. @from and @to name a group, layer, shape or instance; with anchor auto the line is
      cut where it leaves the start node's box and enters the end node's box, less fromGap and toGap.
      route straight, orthogonal (axis-aligned elbows) or curved (bend in degrees); @points are
      waypoints. A connector has no box and no transform of its own.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="animate" type="animateType"/>
      <xs:element name="expression" type="expressionType"/>
      <xs:element name="mask" type="maskType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeCoreAttributes"/>
    <xs:attribute name="from" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the group, layer, shape or instance where the line starts (same composition or symbol, not in a repeat, not 2.5D). Absent: the point fromX, fromY. If the node is absent at a frame, nothing is drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="to" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the group, layer, shape or instance where the line ends (same composition or symbol, not in a repeat, not 2.5D). Absent: the point toX, toY. If the node is absent at a frame, nothing is drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromAnchor" type="connectorAnchorType" default="auto">
      <xs:annotation><xs:documentation>Point of the start node's box the line attaches to: auto (centre; line cut at the box edge if the box has nonzero size), center, a side or a corner (not cut). A keyword other than auto excludes fromX/fromY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toAnchor" type="connectorAnchorType" default="auto">
      <xs:annotation><xs:documentation>Point of the end node's box the line attaches to: auto (centre; line cut at the box edge if the box has nonzero size), center, a side or a corner (not cut). A keyword other than auto excludes toX/toY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromX" type="lengthType">
      <xs:annotation><xs:documentation>With from: horizontal offset of the start inside the node's box, from its left edge (px, %, or viewport units; % is of the box width); the line is not cut. Without from: the start point's x (% is of the parent width).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromY" type="lengthType">
      <xs:annotation><xs:documentation>With from: vertical offset of the start inside the node's box, from its top edge (px, %, or viewport units; % is of the box height); the line is not cut. Without from: the start point's y (% is of the parent height).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toX" type="lengthType">
      <xs:annotation><xs:documentation>With to: horizontal offset of the end inside the node's box, from its left edge (px, %, or viewport units; % is of the box width); the line is not cut. Without to: the end point's x (% is of the parent width).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toY" type="lengthType">
      <xs:annotation><xs:documentation>With to: vertical offset of the end inside the node's box, from its top edge (px, %, or viewport units; % is of the box height); the line is not cut. Without to: the end point's y (% is of the parent height).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromGap" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Distance in pixels, measured along the route, by which the visible line is pulled back from the start (after any cut at the start node's edge). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toGap" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Distance in pixels, measured along the route, by which the visible line is pulled back from the end (after any cut at the end node's edge). Default 0; the line vanishes if the gaps overlap.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="route" default="straight">
      <xs:annotation><xs:documentation>Shape of the line between the ends: straight (through any points), orthogonal (axis-aligned elbows), or curved (one smooth curve shaped by bend). Default straight.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="straight"/><xs:enumeration value="orthogonal"/><xs:enumeration value="curved"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="points" type="pointListType">
      <xs:annotation><xs:documentation>Waypoints as x,y pairs in pixels in the connector's own space (where its siblings' x and y are given). The line passes through them in order; not allowed with route curved.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bend" default="30">
      <xs:annotation><xs:documentation>For route curved: angle in degrees (-90 to 90) between the chord and the curve's end tangents. Positive bulges left of the direction of travel, negative right, 0 is straight. Default 30.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="-90"/><xs:maxInclusive value="90"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="stroke" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Paint of the line; a colour, or a gradient or pattern spread over the bounding box of the line after cuts and gaps (before any trim). Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeWidth" type="nonNegativeDecimal" default="4">
      <xs:annotation><xs:documentation>Line thickness in pixels, centred on the path. 0 draws nothing. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeCap" type="strokeCapType" default="butt">
      <xs:annotation><xs:documentation>Shape of the line ends: butt (flat, default), round or square (flat, extended by half the width).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeJoin" type="strokeJoinType" default="miter">
      <xs:annotation><xs:documentation>Shape of corners where line segments meet: miter (sharp, default), round or bevel (cut off).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="miterLimit" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Longest allowed miter point, as a ratio of miter length to line width; a sharper corner is drawn beveled instead. Applies to strokeJoin miter. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dash" type="numberListType">
      <xs:annotation><xs:documentation>Lengths in pixels of alternating dashes and gaps along the line; an odd number of values repeats the list. Absent: a solid line.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dashOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>How far into the dash pattern, in pixels, the line starts; shifts the dashes along the line. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the connector over what lies beneath it. Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Space-separated ids of effects, defined in the scene's effects, that are applied to the drawn connector.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="trimPath"/>
    <xs:attributeGroup ref="strokeMarkers"/>
    <xs:attribute name="label" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a text asset drawn centred on the line, above the stroke, at the position set by labelAt and labelOffset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labelAt" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Where along the line the label sits, as a fraction from 0 (start) to 1 (end) of the part left after cuts and gaps; trim does not move it. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labelOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Distance in pixels to shift the label sideways from the line; positive moves it to the right of the direction of travel (down for a line running left to right). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labelOrient" default="horizontal">
      <xs:annotation><xs:documentation>horizontal keeps the label unrotated (default); along turns it to follow the line's direction at the label point, flipped when it would read upside down.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="horizontal"/><xs:enumeration value="along"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="burstType">
    <xs:attribute name="time" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds of the first burst on the timeline the emitter sits in (scene time at top level), not counted from the emitter's own start.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="count" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Number of particles released at each burst instant.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="repeat" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Number of additional times the burst fires after the first, spaced by interval. Default 0 (fires once).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interval" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Seconds between repeated bursts. Default 1; applies only when repeat is greater than 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="particleEmitterType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="burst" type="burstType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="preset">
      <xs:annotation><xs:documentation>Named look (smoke, sparks, dust, rain, snow, confetti, fire, bubbles, bokeh, glitter) that supplies values for the emitter attributes it covers (all but rate) that are absent or at their defaults; other values win.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="smoke"/><xs:enumeration value="sparks"/>
        <xs:enumeration value="dust"/><xs:enumeration value="rain"/>
        <xs:enumeration value="snow"/><xs:enumeration value="confetti"/>
        <xs:enumeration value="fire"/><xs:enumeration value="bubbles"/>
        <xs:enumeration value="bokeh"/><xs:enumeration value="glitter"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rate" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Particles emitted per second, continuously while the emitter is active; fractions accumulate over time. Bursts add to it. Default 10; can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lifetime" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>How long each particle lives, in seconds. Default 1; a preset supplies another value while this is left at its default.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lifetimeVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Random spread of a particle's lifetime in seconds: each lives lifetime plus or minus up to this amount (at least 1 ms). Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="100">
      <xs:annotation><xs:documentation>Initial particle speed in pixels per second. Default 100; a preset supplies another value while this is left at its default.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speedVariance" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Random spread of initial speed in pixels per second: plus or minus up to this amount. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" type="xs:double" default="-90">
      <xs:annotation><xs:documentation>Emission direction in degrees: 0 is right, 90 is down, -90 (default) is up. Turns with the emitter's rotation, including rotation inherited from its parents.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spread" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Width in degrees of the cone around direction in which particles are launched, centred on it: 0 is one direction, 360 is all directions. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant horizontal acceleration of particles in pixels per second squared; positive is rightward. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant vertical acceleration of particles in pixels per second squared; positive pulls down, negative rises. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Air drag: particle velocity decays at about this rate per second (0 is none; larger slows faster). Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="turbulence" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Scale of a swirling noise acceleration on particles, in pixels per second squared: the acceleration is twice this value times a noise vector of roughly unit length. 0 (default) is none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="turbulenceScale" type="positiveDecimal" default="100">
      <xs:annotation><xs:documentation>Size in pixels of the swirls in the turbulence noise; larger values give broader, smoother motion. Default 100.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Particle size at birth in pixels: diameter of a disc, side of a square or sprite, thickness of a streak. Default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sizeEnd" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Particle size in pixels at the end of its life, reached by blending from size along sizeCurve. Absent: size does not change, unless a preset supplies an end size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sizeVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Random size variation per particle as a fraction: each size is multiplied by 1 plus or minus up to this value (never below 0). Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sizeCurve" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Easing that shapes how size moves from size to sizeEnd over a particle's life. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Particle colour at birth, including its alpha; a gradient or pattern reference is not used and gives white. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorEnd" type="paintType">
      <xs:annotation><xs:documentation>Colour a particle blends to by the end of its life, along colorCurve (preset confetti instead gives each particle a fixed random mix of the two). Absent: colour does not change.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorCurve" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Easing over a particle's life of the blend from color to colorEnd (not with preset confetti) and of the fade to opacityEnd. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacityEnd" type="unitDecimal">
      <xs:annotation><xs:documentation>Particle opacity at the end of its life, 0 to 1, reached from full opacity along colorCurve and multiplied with the colour's alpha. Absent: no fade.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation0" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial particle rotation in degrees. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Random spread of initial rotation in degrees: plus or minus up to this amount. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocity" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Particle spin in degrees per second. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Random spread of spin in degrees per second: plus or minus up to this amount. Default 0; a preset may supply a value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="orientToVelocity" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>true turns each particle to face its direction of travel, overriding the rotation settings. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxParticles" default="10000">
      <xs:annotation><xs:documentation>Cap on particles alive at once (1 to 10,000,000); emission beyond it is skipped until others expire. Default 10000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger">
        <xs:maxInclusive value="10000000"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="emitterShape" default="rect">
      <xs:annotation><xs:documentation>Where particles are born, relative to the emitter: point, rect or ellipse (centred, sized by emitterWidth/Height), line (along x), path (emitterPath outline), asset-alpha (opaque pixels of emitterAsset). Default rect.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="point"/><xs:enumeration value="rect"/><xs:enumeration value="ellipse"/>
        <xs:enumeration value="line"/><xs:enumeration value="path"/><xs:enumeration value="asset-alpha"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="emitterWidth" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Width in pixels of the emission area for rect, ellipse (full diameter) and line shapes, centred on the emitter. Default 0 (a point).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterHeight" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Height in pixels of the emission area for rect and ellipse shapes, centred on the emitter. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterPath" type="xs:string">
      <xs:annotation><xs:documentation>Path data (in pixels, relative to the emitter) whose outline particles are born on when emitterShape is path.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterAsset" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of an image asset whose opaque pixels (alpha above about half) are where particles are born when emitterShape is asset-alpha; the image's top-left corner sits at the emitter's origin.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed for the emitter's randomness; the same seed gives the same particles. Absent: derived from the emitter's id and the scene seed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" default="disc">
      <xs:annotation><xs:documentation>Particle appearance: disc (default), square, sprite (draws the sprite asset, which is then required; a disc if no image is usable) or streak (elongated along motion). A preset may set it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="disc"/><xs:enumeration value="square"/>
        <xs:enumeration value="sprite"/><xs:enumeration value="streak"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the image asset drawn for each particle when shape is sprite, where it is required; may be a sheet of spriteCols by spriteRows cells.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spriteCols" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Number of columns in the sprite image's cell grid. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spriteRows" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Number of rows in the sprite image's cell grid. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spriteFps" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Frames per second at which each particle steps through the sprite cells, row by row, from its birth, wrapping around. 0 (default): each particle keeps one fixed cell, which differs between particles.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trail" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Motion-trail length in seconds of travel: a faint tail (or streak) extends the particle's current speed times trail pixels behind it. Default 0 (none; streaks use 1/30 s); a preset may set it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceFields" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        The force fields that act on this simulation. Absent: every forceField of the scene. Present: only
        those listed.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="useForceFields" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>
        false: no force field acts on this simulation, whatever forceFields lists.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collide" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>true makes particles bounce off the scene's physics bodies and, when physics bounds is floor or frame, off that floor or frame. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bounce" type="unitDecimal" default="0.3">
      <xs:annotation><xs:documentation>Fraction of its speed into the surface that a colliding particle rebounds with: 0 gives no rebound (it slides on), 1 a full one; each rebound also scales the whole velocity by 0.9. Default 0.3. Needs collide.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="preroll" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Seconds the emitter is simulated before its start time so it is already running when it appears. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the particles over what lies beneath. Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Space-separated ids of effects, defined in the scene's effects, that are applied to the drawn particles.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="blackHoleType">
    <xs:annotation><xs:documentation>
      Version 1.3 or later (BH1). A non-rotating, uncharged black hole in vacuum: the Schwarzschild solution, in units with G = c = 1,
      so that the mass is a length of scene units and the horizon is at r_s = 2 `mass` (BH1). One per scene (BH2). It is
      drawn by a camera with `geodesics="true"`; without it nothing is drawn (W11). Its place is the origin of the
      Schwarzschild coordinates; nothing else about it is authored.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier of the black hole; an accretion disk refers to it by this id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="mass" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Mass of the black hole in scene units (geometric units, G = c = 1); the horizon radius is twice the mass. Required and must be positive.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>X coordinate of the black hole centre, in scene units, in its parent's coordinate frame when it has a parent (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Y coordinate of the black hole centre, in scene units, in its parent's coordinate frame when it has a parent (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Z coordinate of the black hole centre, in scene units, in its parent's coordinate frame when it has a parent (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="accretionDiskType">
    <xs:annotation><xs:documentation>
      Version 1.3. A geometrically thin, optically thick disk of gas on circular orbits in the equatorial plane of the
      `blackHole` it names (BH3), from `innerRadius` to `outerRadius` in the Schwarzschild radial coordinate, scene
      units. `innerRadius` is at least the innermost stable circular orbit, 6 `mass` (BH4), and is that when absent;
      `outerRadius` is beyond it (BH4). Its temperature is the thin-disk profile with a zero-torque inner edge,
      T(r) = `temperatureScale` f(r) / f(49/36 r_in), f(r) = (r_in / r)^(3/4) (1 - (r_in / r)^(1/2))^(1/4): `temperatureScale`,
      in kelvin, is the local temperature at the peak, r = 49/36 r_in, before the shift of light. The gas orbits with
      the angular velocity sqrt(`mass` / r^3) times `timeScale`, in radians per scene second, about the axis of the disk,
      which is the scene's up, (0, -1, 0), turned by `rotationX`, `rotationY` and `rotation` (about z) degrees composed as
      an object3D composes them, Rz Ry Rx; seen from above it turns counter-clockwise. The disk is centred on its
      `blackHole` and has no place of its own. `angularPattern` is the azimuthal structure the gas carries and `seed` fixes it: `none` is a smooth
      disk, `clumps` (the default) seeded azimuthal noise that rotates differentially, `spiral` seeded logarithmic spiral
      arms; `contrast` is its amplitude, 0 to 1, and `intensity` scales the brightness. The disk is analytic,
      a surface the rays meet, and is not made of particles.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier of the accretion disk.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="blackHole" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the black hole the disk orbits; the disk is centred on it. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerRadius" type="positiveDecimal">
      <xs:annotation><xs:documentation>Inner edge of the disk in scene units, not smaller than 6 times the hole mass; absent, it is 6 times the mass.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outerRadius" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Outer edge of the disk in scene units; required and larger than the inner radius.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperatureScale" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Gas temperature in kelvin at the hottest part of the disk (at 49/36 of the inner radius); required, positive.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed of the random azimuthal pattern of the gas (clumps or spiral) and of the background starfield; default 0. Values above 4294967295 act as 4294967295.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularPattern" default="clumps">
      <xs:annotation><xs:documentation>Azimuthal structure of the gas: none is smooth, clumps (default) is seeded noise turning differentially, spiral is seeded spiral arms.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="clumps"/><xs:enumeration value="spiral"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="contrast" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Amplitude of the azimuthal pattern from 0 (smooth) to 1 (strongest); default 0.5. No effect when angularPattern is none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="intensity" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Brightness multiplier of the disk; 0 makes it black, default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeScale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier of the speed at which the gas pattern (clumps or spiral) turns round the hole; 2 turns twice as fast. No effect with angularPattern none. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the x axis that tilts the disk plane (composed with the other two rotations); default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the y axis, composed after rotationX and before rotation to turn the disk's spin axis; alone it changes nothing, since that axis is already vertical. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the z axis that tilts the disk plane (composed with the other two rotations); default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="morphType">
    <xs:annotation><xs:documentation>With an object3D of primitive="mesh" and an imported model: the weight of one morph
    target of the model, by the target's name. It replaces that target's weight from the clip or the rest pose, and wins
    over the same target in the object's @morphWeights. The weight animates. Version 1.2.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the morph target of the imported model that this element sets. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="weight" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Weight of the named morph target, replacing the clip or rest value; default 0. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="jointType">
    <xs:annotation><xs:documentation>With an object3D of primitive="mesh" and an imported model: poses one joint (a node by
    name) of the model. rotationX, rotationY and rotation (about z), in degrees and in that order, turn the joint in its
    own axes on top of the clip's pose; they animate. lookAt then turns the joint so that its lookAxis points at the target
    node, light or camera (the shortest turn, scaled by influence and limited to maxAngle degrees), without moving the
    joint's parents. The first joint of that name in the model's node order is used. Version 1.2.</xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the node (joint) of the imported model that is posed; the first node of that name is used. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the joint in degrees about its own x axis, on top of the clip pose; default 0. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the joint in degrees about its own y axis, on top of the clip pose; default 0. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the joint in degrees about its own z axis, on top of the clip pose; default 0. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lookAt" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a node, light or camera the joint turns to face; its look axis points at it without moving the joint's parents.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lookAxis" default="z">
      <xs:annotation><xs:documentation>Joint-local axis that is pointed at the lookAt target: x, y, z or their negatives (default z).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="x"/><xs:enumeration value="minus-x"/><xs:enumeration value="y"/>
        <xs:enumeration value="minus-y"/><xs:enumeration value="z"/><xs:enumeration value="minus-z"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="influence" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Share, 0 to 1, of the full turn toward the lookAt target that is applied; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxAngle" type="nonNegativeDecimal" default="180">
      <xs:annotation><xs:documentation>Largest turn in degrees the look-at may apply to the joint; default 180.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="object3DType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
      <xs:element name="morph" type="morphType"/>
      <xs:element name="joint" type="jointType"/>
      <xs:element name="medium" type="mediumType"/>
      <xs:element name="pyro" type="pyroType"/>
      <xs:element name="crater" type="craterType"/>
      <xs:element name="fracture" type="fractureType"/>
      <xs:element name="blob" type="clayBlobType"/>
      <xs:element name="rigidBody" type="rigidBody3DType"/>
      <xs:element name="parametricSurface" type="parametricSurfaceType"/>
      <xs:element name="heightfield" type="heightfieldType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier of the object; other nodes refer to it by this id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="primitive" use="required">
      <xs:annotation><xs:documentation>Kind of object: built-in solid (sphere, box, plane, cylinder, cone, torus, capsule), extruded path or text, imported mesh, clay, map, globe, volume, voxels, parametric surface or heightfield. Required.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="sphere"/><xs:enumeration value="box"/>
        <xs:enumeration value="plane"/><xs:enumeration value="mesh"/>
        <xs:enumeration value="cylinder"/><xs:enumeration value="cone"/>
        <xs:enumeration value="torus"/><xs:enumeration value="capsule"/>
        <xs:enumeration value="text"/><xs:enumeration value="extrude"/>
        <xs:enumeration value="clay"/><xs:enumeration value="map"/><xs:enumeration value="globe"/>
        <xs:enumeration value="volume"/><xs:enumeration value="voxels"/>
        <xs:enumeration value="parametric"/><xs:enumeration value="heightfield"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="material" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material the object is drawn with; on an imported mesh it replaces every imported material. A voxels object uses it only for palette entries that name none, and a volume ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="resolution" default="64">
      <xs:annotation><xs:documentation>Cells along the longest side of a clay object's bounds, and along the longer side of a map ground's grid; 8 to 256, default 64.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="8"/><xs:maxInclusive value="256"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fingerprints" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Amount, 0 to 1, of fingerprint-like surface roughness on a clay object; 0 (default) is smooth.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boil" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Times per second the clay roughness pattern is re-seeded, so it shimmers in steps; 0 (default) never changes it. Has no visible effect while fingerprints is 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the clay roughness pattern; absent, it is derived from the object id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mesh" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the mesh or mesh-sequence asset to draw; required when primitive is mesh.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation><xs:documentation>Text to draw as a solid when primitive is text; the element's text content, when present, takes precedence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation><xs:documentation>Font family used for primitive text; under project fontPolicy pinned it must be the family of a font asset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="node" type="xs:string">
      <xs:annotation><xs:documentation>With primitive="mesh" and an imported model: draw only the node of that name and its
      descendants, placed so that the node's own origin is the object's origin (the node's transform within the model is
      dropped, the transforms below it are kept). The first node of that name in the model's node order is used.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="materialOverride" type="xs:string">
      <xs:annotation><xs:documentation>With primitive="mesh" and an imported model: a space-separated list of
      imported-material-name:document-material-id pairs. Each primitive of the model whose material has that name is drawn with
      the document material instead. A material with no pair keeps its imported look. @material, when present, replaces every
      material and takes precedence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tracking" type="xs:double">
      <xs:annotation><xs:documentation>Extra space after every character of primitive="text", in thousandths of an em of the
      text size (the object's height). Negative values tighten. Valid only with primitive="text".
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>Path data of the outline to extrude when primitive is extrude; required there.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Thickness in scene units of a box or of an extruded shape (centred on the origin along z); default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bevel" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Width in scene units of the chamfer on both faces of extruded text or paths, limited to half the depth; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal">
      <xs:annotation><xs:documentation>Width in scene units of a box or plane; absent, twice the radius.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal">
      <xs:annotation><xs:documentation>Height in scene units of a box, plane, cylinder, cone or capsule (default twice the radius; capsule four times), the tube diameter of a torus (default 0.7 of the radius), and the text size (default 100).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="segments" type="xs:positiveInteger" default="32">
      <xs:annotation><xs:documentation>Tessellation count of round shapes, 3 to 512 (default 32); a globe never uses fewer than 24. For a plane, the grid is segments by segments quads, 1 to 1024.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position along x in scene units, in the parent frame; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position along y in scene units, in the parent frame; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position along z in scene units, in the parent frame; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the z axis, default 0. The object is turned about x first, then y, then z (matrix Rz*Ry*Rx), all about the parent's axes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the x axis, default 0. Applied first: the object is turned about x, then y (rotationY), then z (rotation), all about the parent's axes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees about the y axis, default 0. Applied second: after rotationX and before rotation (z), all about the parent's axes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale factor along the x axis; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale factor along the y axis; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleZ" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale factor along the z axis; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="50">
      <xs:annotation><xs:documentation>Radius in scene units of a sphere, cylinder, cone, capsule or torus ring; unset width and height are derived from it (twice the radius for a box or plane). Default 50.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="castShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the object casts shadows; default true. An object that is a shadow catcher never casts one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="receiveShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the object receives shadows; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowCatcher" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>The surface draws no colour of its own. It is transparent where no light is
      blocked and black, with alpha up to @opacity, where the shadow casters block the light that would reach it, so
      that it darkens what is behind the 3D layer by the share of light that is taken away (ambient light counted). It
      does not cast shadows.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the object is drawn; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity from 0 (invisible) to 1 (opaque), multiplied with that of its parents; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the object appears; it is also zero of the object's own time. A transition into it can make it appear earlier. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the object disappears (exclusive); a transition out of it keeps it shown until the transition ends. Without end or such a transition, it stays until its parent ends.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="condition" type="expressionString">
      <xs:annotation><xs:documentation>Expression evaluated over time; the object is drawn only while it is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parent" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of another node, camera or light whose world transform this object follows; position, angles and scales are then in that frame. A 2D parent contributes its 2D world transform.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parentJoint" type="xs:string">
      <xs:annotation><xs:documentation>With a @parent (or a transformConstraint of type="parent") that is an object3D
      drawing an imported model: the name of a node of that model. The element is placed in that node's frame as the
      model's clips pose it, instead of in the object's own frame. The first node of that name in the model's node order
      is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="triStateType" default="inherit">
      <xs:annotation><xs:documentation>Motion blur: on, off, or inherit (default) the setting of the parent, else the project. Consecutive 3D objects sharing a parent are drawn as one pass, blurred by the first one's setting.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationClip" type="xs:string">
      <xs:annotation><xs:documentation>Name or index of the animation clip of an imported model to play, looped over its duration.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationSpeed" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Speed multiplier of the object's source time (model clip, mesh sequence, numbered volume sequence, pyro): source time is object time times this plus animationOffset. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds added to the object's source time (model clip, mesh sequence, numbered volume sequence, pyro) after the speed multiplier; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationClipTo" type="xs:string">
      <xs:annotation><xs:documentation>With primitive="mesh" and an imported model: a second clip (by name or index, as
      @animationClip) the model is blended toward by @animationBlend. It plays at the object's time scaled by
      @animationSpeed plus @animationOffsetTo.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationBlend" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Weight of @animationClipTo, 0 to 1 (animatable): 0 is @animationClip alone, 1 is
      @animationClipTo alone, between them translation, scale and morph weights blend linearly and rotation along the
      shortest arc. A node a clip does not animate keeps its rest pose in that clip. Without @animationClipTo the weight
      blends toward the rest pose.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="animationOffsetTo" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds added to the time of the second clip (animationClipTo) that is blended in; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="morphWeights" type="numberListType">
      <xs:annotation><xs:documentation>Weights of the imported model morph targets in order, replacing the clip weights; named morph children override single targets.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="materialVariant" type="xs:string">
      <xs:annotation><xs:documentation>Name of the material variant of the imported model to draw; an unknown name keeps the default material, and a set material replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="instances" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Number of copies of the object drawn (default 1); each is evaluated with its own index and count.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="map" type="xs:IDREF">
      <xs:annotation><xs:documentation>
        primitive="map": the map asset as ground in the object's xy plane, one map pixel per scene
        unit, draped with the map as drawn; @terrain (tiles of elevation, Terrarium or Mapbox
        Terrain-RGB per @terrainEncoding) raises it toward the camera (−z) by true height times
        @exaggeration on a grid of @resolution cells, and @buildings extrudes the footprints of its
        first basemap's vector tiles to their heights. Terrain and buildings need a Web Mercator
        map. primitive="globe": a sphere of @radius and @segments (poles on the y axis, 0° longitude
        facing the camera) draped with the map's content drawn over the whole world. @material
        dresses the ground, the globe and the buildings. @textureSize is the drape's resolution in
        pixels along a map's longer side, and a globe drape's height (its width is twice that); it
        does not change what the drape shows.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="terrain" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the tiles asset with elevation data that raises a map ground or relieves a globe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="terrainEncoding" default="terrarium">
      <xs:annotation><xs:documentation>How elevation is encoded in terrain tiles: terrarium (default) or mapbox.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="terrarium"/><xs:enumeration value="mapbox"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="exaggeration" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier of terrain heights on a map or globe, and of building heights on a map; 1 (default) is true scale, 0 flattens.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="buildings" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>On a map, extrudes the building footprints of the first basemap's vector tiles to their heights (8 m when a footprint has none); default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="textureSize" default="2048">
      <xs:annotation><xs:documentation>Resolution in pixels of the drape texture: its longer side on a map, its height on a globe (width twice that, height capped at 4096); 64 to 8192, default 2048.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="64"/><xs:maxInclusive value="8192"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="planetRadius" type="positiveDecimal" default="6378137">
      <xs:annotation><xs:documentation>Version 1.3 globe relief: physical datum radius in metres. Radial scene displacement is elevationMetres * radius / planetRadius * exaggeration. Flat map terrain keeps its existing scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="terrainTileSize" default="256">
      <xs:annotation><xs:documentation>Width and height in pixels of the terrain tiles, which must match the tiles in the asset; a power of two up to 4096, default 256. Only on a globe with terrain.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="terrainZoom">
      <xs:annotation><xs:documentation>Zoom level, 0 to 22, of the terrain tiles read for a globe; absent, derived from the segments and tile size within the archive's zoom range. Only on a globe with terrain.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="22"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="terrainMissing" default="error">
      <xs:annotation><xs:documentation>What a missing terrain tile does on a globe: error (default) fails, zero treats its elevation as 0. Only on a globe with terrain.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="error"/><xs:enumeration value="zero"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="terrainMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Upper bound in MiB, 1 to 4096 (default 128), for the memory of globe terrain (surface and tile cache). Only on a globe with terrain.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="voxels" type="xs:IDREF">
      <xs:annotation><xs:documentation>
        Version 1.3. With primitive="voxels" (VOX4): the voxelAsset whose cells this object is made of. Position, scale and the other
        transform attributes are those of every object3D; the origin of the cells is the corner of the bounding box of the occupied cells.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cellSize" type="positiveDecimal">
      <xs:annotation><xs:documentation>
        Only with primitive="voxels" (VOX5): scene units a cell. Absent, the voxelAsset's own cellSize if it has one, else the cell size that
        an srvol asset's grid says, else 1.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="palette" type="xs:string">
      <xs:annotation><xs:documentation>
        Only with primitive="voxels" (VOX5): the token `file` (the colours of the file, which needs a file that has them) or the materials,
        as IDs separated by spaces, of the palette indices 1, 2, ... in order, at most 255 (VOX6). The material of a cell is the one of its
        index, else the object's own `material`, else the colour of the file; an index with none of the three is an error that names it.
        Absent, `file` if the file has colours and otherwise the object's `material`.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="surface">
      <xs:annotation><xs:documentation>
        Only with primitive="voxels" (VOX5): `blocks`, the only value so far, draws every exposed face of a cell as a quad. The engine's default
        is `blocks`; it is not an XSD default so that it can be refused on any other primitive.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="blocks"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="surfaceMemoryMiB">
      <xs:annotation><xs:documentation>
        Only with primitive="voxels" (VOX5): the most memory, in MiB, that the surface of the cells may take while it is made and drawn (1,240 bytes
        for each quad at the peak: its compact form, the builder's vertices and indices, the copy a mesh upload keeps and the buffers on the
        device). The engine's default is 128; it is not an XSD default so that it can be refused on any other primitive. A surface over it is an
        error that names the cause, never a surface cut short.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="volume" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the volume asset to draw when primitive is volume; a volume object needs exactly one of this and a pyro child.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="shakeType">
    <xs:attribute name="amplitude" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Peak camera displacement of the shake in scene units along the x and y axes of the camera's parent frame (not the view direction); default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frequency" type="positiveDecimal" default="2">
      <xs:annotation><xs:documentation>Speed of the shake noise: it is sampled at frequency times the camera time in seconds, so higher values shake faster. Default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Peak roll of the shake in degrees; 0 (default) adds no roll.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Strength of the zoom pulsing of the shake on a perspective camera: it zooms by a factor of 1 plus zoom times the noise (the field of view is divided by it); 0 (default) adds none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="octaves" type="xs:positiveInteger" default="2">
      <xs:annotation><xs:documentation>Number of noise layers (detail levels) summed in the shake, each at half the weight of the one before; values below 1 count as 1 and above 16 as 16. Default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the shake noise; absent, the project seed is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds after the camera becomes live (its own start) at which the shake begins; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Seconds after the camera becomes live (its own start) at which the shake stops (exclusive); absent, it continues.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="cameraType">
    <xs:annotation><xs:documentation>
      Physical camera: when focalLength is set, fov derives from focalLength and
      sensorWidth (mm). depthOfField uses fStop, focusDistance (scene units) and
      apertureBlades. Several cameras may exist; the active one at time t is the
      last active camera whose [start, end) contains t (camera switching).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="shake" type="shakeType"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier of the camera; other nodes can refer to it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="active" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the camera can be the frame camera; of the active cameras live at time t, the one last in drawing order renders. Cameras inside a viewport3D never qualify. Default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds at which the camera becomes live; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds at which the camera stops being live (exclusive); absent, it stays live.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera position along x in scene units; default 0. In the parent frame when the camera has a parent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera position along y in scene units (y points down); default 0. In the parent frame when parented.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera position along z in scene units (z points into the scene); default 0. In the parent frame when parented.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="projection" default="perspective">
      <xs:annotation><xs:documentation>Projection: perspective (default) with a field of view, or orthographic with no perspective foreshortening.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="perspective"/><xs:enumeration value="orthographic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fov" type="positiveDecimal" default="60">
      <xs:annotation><xs:documentation>Horizontal field of view in degrees, across the frame width: the focal distance in pixels is (frame width / 2) / tan(fov / 2), whatever the frame's height, so a portrait frame sees a narrower vertical angle than a landscape one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="near" type="positiveDecimal" default="0.1">
      <xs:annotation><xs:documentation>Distance in scene units from the camera of the nearest drawn surface; default 0.1. A perspective camera with renderer pathtrace does not clip at it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="far" type="positiveDecimal" default="10000">
      <xs:annotation><xs:documentation>Distance in scene units from the camera of the farthest drawn surface; default 10000. A camera with renderer pathtrace does not clip at it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="yaw" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera turn in degrees about the vertical axis; positive turns toward +x. Replaced by target while target names a node present in the frame. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pitch" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera tilt in degrees; positive looks up. Replaced by target while target names a node present in the frame. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="roll" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Camera roll in degrees about its viewing axis; applies with or without target. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="target" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a node the camera looks at; while that node is in the frame it overrides yaw and pitch (roll still applies).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focalLength" type="positiveDecimal">
      <xs:annotation><xs:documentation>Lens focal length in millimetres; when set, the field of view derives from it and sensorWidth instead of fov.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sensorWidth" type="positiveDecimal" default="36">
      <xs:annotation><xs:documentation>Sensor width in millimetres used to turn focalLength into a field of view and for depth of field; default 36.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sensorHeight" type="positiveDecimal" default="24"/>
    <xs:attribute name="orthoHeight" type="positiveDecimal">
      <xs:annotation><xs:documentation>Visible height in scene units of an orthographic camera; absent, the frame height is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depthOfField" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, a perspective camera blurs what is away from the focus distance; default false. Not used when geodesics is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fStop" type="positiveDecimal" default="2.8">
      <xs:annotation><xs:documentation>Lens aperture number for depth of field; a smaller value gives more blur. Default 2.8.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusDistance" type="positiveDecimal" default="1000">
      <xs:annotation><xs:documentation>Distance in scene units, measured along the viewing direction, that is in focus for depth of field; default 1000. Overridden by focusTarget.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusTarget" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a node kept in focus when depthOfField is on; its depth from the camera replaces focusDistance. If the node cannot be found, focusDistance is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="apertureBlades" default="0">
      <xs:annotation><xs:documentation>Number of aperture blades for the depth-of-field blur shape; 3 or more gives a polygon, fewer a round blur. Default 0. A camera with renderer pathtrace always blurs round.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="16"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shutterAngle" type="nonNegativeDecimal"/>
    <xs:attribute name="exposure" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Exposure compensation in stops for the camera's 3D picture (2D layers are not affected): its colours are multiplied by 2 to the power exposure; 0 (default) leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lensDistortion" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Radial lens distortion of the camera's 3D picture; positive values give barrel distortion, 0 (default) is none. Not used when geodesics is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <!-- Screen-space lighting of the raster renderer, and a
         progressive path tracer for final frames -->
    <xs:attribute name="ambientOcclusion" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Turns on screen-space ambient occlusion; applies only to rasterized output, not to path-traced images, geodesic images or scenes with media. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="aoRadius" type="positiveDecimal" default="40">
      <xs:annotation><xs:documentation>Sampling radius of the ambient occlusion in scene units; used only when ambientOcclusion is true. Default 40.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="aoIntensity" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Strength of the ambient occlusion darkening; 0 removes the darkening, default 1. Used only when ambientOcclusion is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="screenSpaceReflections" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Turns on screen-space reflections; applies only to rasterized output, not to path-traced images, geodesic images or scenes with media. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="renderer" default="raster">
      <xs:annotation><xs:documentation>Rendering method: raster (default) or pathtrace, a progressive path tracer for final frames; a camera with geodesics true draws its black hole pass instead of either.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="raster"/><xs:enumeration value="pathtrace"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="geodesics" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        Version 1.3. true renders the scene by tracing each camera ray along a null geodesic of the Schwarzschild
        spacetime of the scene's `blackHole` (BH5): the shadow, the lensed image of the background and of the
        `accretionDisk`. This version renders only the black hole, its disk and the 2D background: any `object3D`,
        `particles3D`, `particleEmitter`, `ocean`, `fluid`, `flock`, `slime`, `erosion`, `pyro` or `medium` in the scene is an
        error (BH6), the camera is farther than 3 `mass` from the hole (BH7) and is the only one with geodesics (BH8); 2D
        layers, text, shapes, effects and adjustments are allowed, and the image goes through the 2D chain. The camera's
        distance to the hole is the radius of the static observer. `fov`, `roll`, `target`, `yaw` and `pitch` are those of any
        camera and `pathSamples` is the number of antialiasing samples of a pixel; `denoise="true"` and lights are not
        used (W12, W05). false (the default) is the camera there always was, and a `blackHole` or an `accretionDisk` with
        it is not rendered (W11).
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pathSamples" default="64">
      <xs:annotation><xs:documentation>Samples per pixel of the path tracer, 1 to 65536, default 64. With geodesics it is instead the antialiasing sample count of a pixel, 1 to 4096, default 16.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="65536"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="maxBounces" default="4">
      <xs:annotation><xs:documentation>Maximum light bounces per path of the path tracer, 1 to 64; default 4.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="64"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="denoise" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the path-traced image is denoised; default true. Ignored with geodesics.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="groupType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="nodeChoice"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the group onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        Effect ids applied in order to this group's isolated buffer (a group
        with effects is always isolated) instead of the final frame.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="isolate" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the group is rendered on its own and then composited as a unit, so child blend modes act only inside it. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collapse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Accepted, with no effect (an inert attribute, reported as such: SREP 18, rule I9). A group that is not isolated passes its 2.5D children through, so they share the frame's camera space; an isolated group (clip, mask, matte, effects or blend) draws its children in its own offscreen.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveLengthType">
      <xs:annotation><xs:documentation>Width of the group box, in pixels or as a relative length; used only together with height. Absent, a layout hugs its content and children's relative lengths use the enclosing box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveLengthType">
      <xs:annotation><xs:documentation>Height of the group box, in pixels or as a relative length; used only together with width. Absent, a layout hugs its content and children's relative lengths use the enclosing box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clip" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true and both width and height are set, children are clipped to the group box. Without a box nothing is clipped. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="layout" default="none">
      <xs:annotation><xs:documentation>Automatic layout of children (flexbox subset): row, column, stack or grid with gap/padding/justify/alignItems.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="row"/><xs:enumeration value="column"/>
        <xs:enumeration value="stack"/><xs:enumeration value="grid"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="gap" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Space between neighbouring children in a row, column or grid layout; in pixels, a percentage of the container width, or a unit relative to the frame. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="lengthType" default="0">
      <xs:annotation><xs:documentation>Space between the group box edge and its laid-out children; in pixels, a percentage of the container width, or a unit relative to the frame. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="justify" default="start">
      <xs:annotation><xs:documentation>Distribution of children along the horizontal axis (row, stack, grid) or the vertical axis (column) of the layout: start, center, end, space-between, space-around or space-evenly. Default start.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="center"/><xs:enumeration value="end"/>
        <xs:enumeration value="space-between"/><xs:enumeration value="space-around"/><xs:enumeration value="space-evenly"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alignItems" default="start">
      <xs:annotation><xs:documentation>Cross-axis alignment of children (vertical in stack and grid): start, center, end, stretch (scales children to the cross size) or baseline (same as start). Default start.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="center"/><xs:enumeration value="end"/>
        <xs:enumeration value="stretch"/><xs:enumeration value="baseline"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="gridColumns" type="xs:positiveInteger" default="2">
      <xs:annotation><xs:documentation>Number of columns in a grid layout, at least 1; default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds by which the children timeline is delayed relative to the group; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeScale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Speed multiplier of the children time inside the group; 2 plays twice as fast, 1 (default) is unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="sequenceType">
    <xs:annotation><xs:documentation>
      Children play one after another: each child's start is the previous
      child's end plus @timeGap seconds (negative values overlap). A child's own start is an
      additional offset. If @transition is set, every junction gets that
      transition with @transitionDuration unless an explicit transition exists.
    </xs:documentation></xs:annotation>
    <xs:complexContent><xs:extension base="groupType">
      <xs:attribute name="timeGap" type="xs:double" default="0">
        <xs:annotation><xs:documentation>Seconds between the end of one child and the start of the next in the sequence; negative values overlap them. A child with a startMarker is not repositioned by the sequence. Default 0.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="transition" type="xs:NMTOKEN">
        <xs:annotation><xs:documentation>Transition type automatically inserted at each junction that has no explicit transition; absent, junctions stay cuts. The inserted ones take default options, so shader falls back to a crossfade.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="transitionDuration" type="positiveDecimal" default="0.5">
        <xs:annotation><xs:documentation>Length in seconds of the automatic transitions, centred on the cut between children; default 0.5.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- ===================================================== reuse and templating nodes -->
  <xs:complexType name="instanceType">
    <xs:annotation><xs:documentation>
      Instantiates a symbol (precomposition / component). The symbol runs on its
      own clock: local time = (t - start) * speed + clipIn, looped/reversed as
      for layers, or mapped by timeRemap. override children change attributes
      of elements inside this instance only; ids inside a symbol are scoped to
      the instance (effective id = instanceId/innerId).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="override" type="overrideType"/>
      <xs:element name="timeRemap" type="timeRemapType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="symbol" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the symbol whose content this instance plays. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the instance onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the instance; absent means none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipIn" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds trimmed from the start of the symbol timeline; playback covers the rest of the symbol, running backwards from its end when reversed. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipOut" type="xs:double"/>
    <xs:attribute name="loop" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Number of extra times the symbol is played after the first; 0 (default) plays it once. Ignored when the instance has a timeRemap child.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the symbol plays backwards; a negative speed reverses it too, so both together play it forwards. Ignored when the instance has a timeRemap child. Default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Playback speed multiplier of the symbol; negative plays it backwards and cancels reverse. Unless the instance sets its own end or a timeRemap, it lasts (symbol length - clipIn) x (loop + 1) / |speed|. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fit" type="fitType" default="none"/>
    <xs:attribute name="boxWidth" type="positiveLengthType"/>
    <xs:attribute name="boxHeight" type="positiveLengthType"/>
  </xs:complexType>
  <xs:complexType name="includeType">
    <xs:annotation><xs:documentation>
      Pulls a symbol from another scene-render document (@src#@symbol) or that
      document's whole composition when @symbol is absent. The included file's
      assets, paints, styles and effects are merged under the namespace @id/.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="override" type="overrideType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Location of the scene document to include; it must be a local file, a remote one is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="symbol" type="xs:NCName">
      <xs:annotation><xs:documentation>Name of the symbol of the included document to bring in; absent, the whole composition is included.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>Expected SHA-256 hash of the included local file; when the document's files are verified (not with asset checks switched off), a mismatch is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pointsType">
    <xs:annotation><xs:documentation>
      Generates the points on which a repeat places its copies: one copy per point, copy i on point i,
      in the repeat's own space (pixels, +y down). type grid (columns x rows, centred on the origin),
      along-path (count points at equal arc length along @path), scatter (count seeded points inside
      width x height centred on the origin, or inside @path), vertices (one point per vertex of @path)
      or list (the pairs of @at). Expressions inside the repeat read pointX, pointY, pointAngle, pointU
      and pointRandom.
    </xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="animate" type="animateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Where the points go: grid, along-path (needs path and count), scatter (needs count and a path, or width and height), vertices (needs path) or list (needs at). Required.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="grid"/><xs:enumeration value="along-path"/>
        <xs:enumeration value="scatter"/><xs:enumeration value="vertices"/>
        <xs:enumeration value="list"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="columns" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Number of columns of a grid of points, centred on the origin; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rows" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Number of rows of a grid of points, centred on the origin; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spacingX" type="xs:double" default="100">
      <xs:annotation><xs:documentation>Horizontal distance in pixels between grid columns; default 100. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spacingY" type="xs:double" default="100">
      <xs:annotation><xs:documentation>Vertical distance in pixels between grid rows; default 100. It can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="count" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Number of points for along-path; for scatter, the most points made (fewer if too few candidates land inside a path). Absent counts as 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>Path data used by along-path, vertices, and by scatter to confine points inside the path; with scatter it excludes width and height.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillRule" type="fillRuleType" default="nonzero">
      <xs:annotation><xs:documentation>Fill rule deciding which area counts as inside the path for scatter: nonzero (default) or evenodd.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="orient" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, along-path copies are rotated to the path direction at their point; default false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Width in pixels of the rectangle, centred on the origin, that scatter fills; required with height for scatter without a path, not allowed with a path; it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Height in pixels of the rectangle, centred on the origin, that scatter fills; required with width for scatter without a path, not allowed with a path; it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="at" type="pointListType">
      <xs:annotation><xs:documentation>Explicit list of x,y pairs, in pixels, for type list.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the random scatter; absent, the project seed is used.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="repeatType">
    <xs:annotation><xs:documentation>
      Generates copies of its children: @count copies, or one per item of the
      list parameter / data rows named by @over. Inside, expressions read
      index, count and param(@var) (the current item). Copy i receives the
      cumulative offsets i*offsetX, i*offsetY, i*rotationStep, scaleStep^i,
      opacity - i*opacityStep and a start delay of i*timeStep (stagger).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="points" type="pointsType"/>
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="nodeChoice"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="count" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Number of copies made; the first copy takes the value from, and each next adds step. Use count, over or a points child.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="over" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a list parameter or data source with one copy per item (skipping from, taking every step-th); anything else is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="var" type="xs:NCName" default="item">
      <xs:annotation><xs:documentation>Name of the loop variable that expressions read with param(name) to get the current item; default item.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="from" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Index of the first item or counter value; default 0. With a points child it must be 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="step" type="xs:positiveInteger" default="1">
      <xs:annotation><xs:documentation>Distance between consecutive counter values, or between consecutive list items taken (1 takes every item); at least 1, default 1. With a points child it must be 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal displacement in pixels added per copy: copy k is moved k times this; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical displacement in pixels added per copy: copy k is moved k times this; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationStep" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation in degrees added per copy: copy k is rotated k times this, about the repeat's origin rather than the copy's own anchor; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleStep" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Scale factor applied per copy: copy k is scaled by this to the power k, about the repeat's origin rather than the copy's own anchor; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacityStep" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>Opacity lost per copy: copy k has opacity 1 minus k times this, not below 0; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeStep" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds of delay added per copy: copy k starts k times this later; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the repeat output onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="adjustmentType">
    <xs:annotation><xs:documentation>
      Adjustment layer: applies @effects to the composite of every sibling below
      it (lower z / earlier in document order), limited by its masks, matte and
      opacity, during [start, end).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="effects" type="xs:IDREFS" use="required">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the composite of everything drawn beneath the adjustment layer in the frame or isolated group that holds it; disabled effects are skipped. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode of the adjustment; with normal, the effect result replaces the backdrop within the layer coverage, unless edgeBlend selects the other blend space (then it composites over). Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="transitionType">
    <xs:annotation><xs:documentation>
      Transition between sibling nodes @from (outgoing) and @to (incoming), or
      an in/out transition of a single node when only one is given. The
      transition window has length @duration, centred on the cut (alignment
      center), ending at it (end) or starting at it (start). The renderer
      extends the handles of both nodes by the needed amount.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of transition between the outgoing and incoming content: cut, crossfade, dissolve, dip, wipes, slides, zooms, 3D flips, glitch, shader and others. Required; shader needs shader, luma needs matte.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="cut"/><xs:enumeration value="crossfade"/>
        <xs:enumeration value="additive-dissolve"/><xs:enumeration value="dip-to-color"/>
        <xs:enumeration value="wipe"/><xs:enumeration value="slide"/>
        <xs:enumeration value="push"/><xs:enumeration value="cover"/>
        <xs:enumeration value="reveal"/><xs:enumeration value="zoom-in"/>
        <xs:enumeration value="zoom-out"/><xs:enumeration value="spin"/>
        <xs:enumeration value="whip-pan"/><xs:enumeration value="circle-open"/>
        <xs:enumeration value="circle-close"/><xs:enumeration value="iris"/>
        <xs:enumeration value="clock-wipe"/><xs:enumeration value="radial-wipe"/>
        <xs:enumeration value="barn-door"/><xs:enumeration value="blinds"/>
        <xs:enumeration value="luma"/><xs:enumeration value="blur"/>
        <xs:enumeration value="glitch"/><xs:enumeration value="pixelize"/>
        <xs:enumeration value="flip"/><xs:enumeration value="cube"/>
        <xs:enumeration value="page-curl"/><xs:enumeration value="film-roll"/>
        <xs:enumeration value="stripe"/><xs:enumeration value="squash"/>
        <xs:enumeration value="shuffle"/><xs:enumeration value="carousel"/>
        <xs:enumeration value="light-leak"/><xs:enumeration value="morph"/>
        <xs:enumeration value="shader"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="from" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the outgoing node; the cut is at its end, or at the incoming node's start when from is absent or the node has no end.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="to" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the incoming node; the cut is at its start when from is absent or the outgoing node has no end.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="positiveDecimal" default="0.5">
      <xs:annotation><xs:documentation>Length of the transition in seconds, placed around the cut as alignment says; default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alignment" default="center">
      <xs:annotation><xs:documentation>Where the transition window lies relative to the cut: center (default), end (finishes at the cut) or start (begins at it).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="center"/><xs:enumeration value="start"/><xs:enumeration value="end"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="curve" type="curveType" default="ease-in-out">
      <xs:annotation><xs:documentation>Easing curve applied to the transition progress; default ease-in-out.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" default="left">
      <xs:annotation><xs:documentation>Direction of motion or wipe: left (default), right, up, down, or angle, which follows the angle attribute.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="left"/><xs:enumeration value="right"/><xs:enumeration value="up"/>
        <xs:enumeration value="down"/><xs:enumeration value="angle"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="angle" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Degrees, 0 pointing right and turning clockwise on screen: the direction when direction is angle, the start ray of a radial-wipe, or the total rotation of a spin with direction angle (0 gives 180).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Colour used by dip-to-color in the middle of the transition, by film-roll, and, when not the default black, by the light-leak blobs; default opaque black.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="softness" type="unitDecimal" default="0.1">
      <xs:annotation><xs:documentation>Width of the soft edge of wipe-style transitions, from 0 (hard edge) to 1; default 0.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="matte" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a node whose luminance drives a luma transition; required for type luma.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shader" type="xs:anyURI">
      <xs:annotation><xs:documentation>type="shader": GLSL fragment in the gl-transitions convention (vec4 transition(vec2 uv), uniform float progress).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true (default), slide-like transitions add a motion-blur streak and shader transitions are sampled across the shutter.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audio" default="crossfade">
      <xs:annotation><xs:documentation>How the transition mixes the sound of the video layers on its sides (a side that is
      such a layer, and such layers inside a side), at the transition's eased progress p: crossfade gives the outgoing side
      1 - p and the incoming side p; equal-power cos(pi p / 2) and sin(pi p / 2); cut the outgoing side while p &lt; 1/2
      and the incoming side from p = 1/2; none leaves both at their own volume. The gains multiply the layers' volume.
      A sequence junction cuts its sound when its type is cut and crossfades it otherwise. SREP 82.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="crossfade"/><xs:enumeration value="equal-power"/>
        <xs:enumeration value="cut"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ============================================================ 2D simulations
       Each simulates at a fixed step from its start
       with a checkpoint every simulated second, like physics and particles, and is drawn in
       its own box (flock: as particles in frame space). -->
  <xs:simpleType name="simBoundsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="steer"/><xs:enumeration value="bounce"/><xs:enumeration value="wrap"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="flockType">
    <xs:annotation><xs:documentation>
      Boids (Reynolds 1987): `count` agents in the width x height box steer by separation,
      alignment and cohesion with neighbours within `perception`, capped at `maxSpeed` and
      `maxForce`, kept in the box by `bounds`, and pushed by the named force fields. Drawn like
      particles (disc, streak or sprite), oriented to their velocity unless `orientToVelocity` is false.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="count" default="200">
      <xs:annotation><xs:documentation>Number of agents in the flock, 1 to 100000; default 200.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="100000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the random start positions and headings; absent, it is derived from the node id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Width of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Height of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="nonNegativeDecimal" default="120">
      <xs:annotation><xs:documentation>Minimum (cruise) speed of an agent in pixels per second; 0 lets agents slow freely. Default 120.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxSpeed" type="positiveDecimal" default="240">
      <xs:annotation><xs:documentation>Top speed of an agent in pixels per second, unless speed is larger, in which case speed applies; default 240.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxForce" type="positiveDecimal" default="400">
      <xs:annotation><xs:documentation>Largest acceleration, in pixels per second squared, of each steering rule (separation, alignment, cohesion) before its weight, and of the push at the edge; default 400.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="perception" type="positiveDecimal" default="60">
      <xs:annotation><xs:documentation>Radius in pixels within which an agent sees neighbours; default 60.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="separationDistance" type="positiveDecimal" default="24">
      <xs:annotation><xs:documentation>Distance in pixels under which neighbours push an agent away; only neighbours also within perception count. Default 24.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="separation" type="nonNegativeDecimal" default="1.5">
      <xs:annotation><xs:documentation>Weight of steering away from close neighbours; 0 disables it. Default 1.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alignment" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Weight of steering toward the average heading of neighbours; 0 disables it. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cohesion" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Weight of steering toward the centre of neighbours; 0 disables it. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bounds" type="simBoundsType" default="steer">
      <xs:annotation><xs:documentation>Behaviour at the box edge: steer (default) pushes agents back near the edge and also reflects them at it, bounce only reflects them, wrap makes the box periodic.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="edgeMargin" type="nonNegativeDecimal" default="40">
      <xs:annotation><xs:documentation>Distance in pixels from the edge within which steer bounds push agents back; default 40. Used only by steer.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceFields" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        The force fields that act on this simulation. Absent: every forceField of the scene. Present: only
        those listed.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="useForceFields" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>
        false: no force field acts on this simulation, whatever forceFields lists.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="positiveDecimal" default="6">
      <xs:annotation><xs:documentation>Body size of each agent in pixels; default 6.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour of the agents; only a literal colour is used. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" default="streak">
      <xs:annotation><xs:documentation>Look of an agent: disc, streak (default, drawn along its velocity) or sprite, which needs the sprite attribute (absent, agents are streaks) naming a loadable image asset (else discs).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="disc"/><xs:enumeration value="streak"/><xs:enumeration value="sprite"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the image asset drawn for each agent when shape is sprite; required in that case.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="orientToVelocity" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>true (the default): each agent's disc or sprite is turned to point along its velocity.
      false: it keeps rotation 0 in the flock's space. Streaks always follow the velocity. SREP 73.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trail" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Length of the fading tail behind each agent, in seconds of its motion, so tail length is speed times trail. Streak agents get at least a trail of three body sizes at the larger of speed and half maxSpeed. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the flock onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the flock; absent means none.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="fluidSourceType">
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal position of the source in pixels within the fluid box; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical position of the source in pixels within the fluid box; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="20">
      <xs:annotation><xs:documentation>Radius in pixels of the source; its effect fades linearly to zero at the edge. Default 20.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour of the dye it injects; only a literal colour is used (any other paint falls back to white). Default white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="density" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Amount of dye injected per second at the centre; 0 injects none. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal velocity in pixels per second that the source pushes the fluid toward within its radius; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical velocity in pixels per second that the source pushes the fluid toward within its radius; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds, on the fluid clock, at which the source switches on; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds, on the fluid clock, at which the source switches off (exclusive); absent, it stays on.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="fluidType">
    <xs:annotation><xs:documentation>
      Incompressible 2D fluid on a grid (Stam 1999, stable fluids): semi-Lagrangian advection of
      velocity and coloured dye, viscous diffusion, vorticity confinement and a pressure
      projection. Sources inject dye (per second) and velocity (px/s) inside their radius.
      Positions are in the fluid's box.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="fluidSource" type="fluidSourceType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Width of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Height of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="resolution" default="128">
      <xs:annotation><xs:documentation>Number of grid cells along the longer side of the box, 8 to 1024; default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="8"/><xs:maxInclusive value="1024"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="viscosity" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Velocity diffusion coefficient in pixels squared per second; 0 (default) means none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="diffusion" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Dye diffusion coefficient in pixels squared per second; 0 (default) means none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dissipation" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Rate at which dye fades, per second (fraction left after time t is exp(-k t)); 0 (default) keeps it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityDissipation" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Rate at which velocity decays, per second (exp(-k t)); 0 (default) keeps it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="vorticity" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Strength of vorticity confinement, which restores small swirls; 0 (default) disables it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="buoyancy" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Upward acceleration in pixels per second squared per unit of dye opacity; negative sinks. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="iterations" default="40">
      <xs:annotation><xs:documentation>Iterations of the pressure solver in each of the two projections of a step, 1 to 500; more is more incompressible. Default 40.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="500"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bounds" default="closed">
      <xs:annotation><xs:documentation>Box edge behaviour: closed (default) walls, open lets fluid flow out, wrap is periodic.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="closed"/><xs:enumeration value="open"/><xs:enumeration value="wrap"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="forceFields" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        The force fields that act on this simulation. Absent: every forceField of the scene. Present: only
        those listed.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="useForceFields" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>
        false: no force field acts on this simulation, whatever forceFields lists.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the fluid onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the fluid; absent means none.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="slimeType">
    <xs:annotation><xs:documentation>
      Physarum transport network (Jones 2010): agents sense a trail map ahead and to either side,
      turn toward the strongest trail, move and deposit; the map diffuses and decays each step.
      Drawn as the trail map through a two-colour ramp (colorLow at 0, color at `saturation`).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Width of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Height of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="resolution" default="256">
      <xs:annotation><xs:documentation>Number of trail cells along the longer side of the box, 8 to 2048; default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="8"/><xs:maxInclusive value="2048"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="agents" default="20000">
      <xs:annotation><xs:documentation>Number of agents, 1 to 2000000; default 20000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="2000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the random start positions and of the random turns and edge bounces; absent, it is derived from the node id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spawn" default="disc">
      <xs:annotation><xs:documentation>Where agents start: random, disc (centred disc, facing outward; default), ring (facing inward) or center.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="random"/><xs:enumeration value="disc"/><xs:enumeration value="ring"/><xs:enumeration value="center"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sensorAngle" type="xs:double" default="30">
      <xs:annotation><xs:documentation>Angle in degrees between the forward sensor and each side sensor; default 30.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sensorDistance" type="positiveDecimal" default="9">
      <xs:annotation><xs:documentation>Distance in pixels from the agent at which it senses the trail; default 9.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="turnAngle" type="xs:double" default="45">
      <xs:annotation><xs:documentation>Angle in degrees an agent turns per step toward the stronger side trail; when both sides beat the front it turns left or right at random. Default 45.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="nonNegativeDecimal" default="60">
      <xs:annotation><xs:documentation>Movement speed of agents in pixels per second; default 60.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="deposit" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Trail amount each agent adds per step; default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="decay" type="unitDecimal" default="0.1">
      <xs:annotation><xs:documentation>Fraction of the trail lost per step, 0 to 1; default 0.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="diffuse" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Share, 0 to 1, of the 3x3 neighbourhood mean mixed into each cell per step; default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="saturation" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Trail value at which the colour reaches its full value; default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="paintType" default="#FFD27AFF">
      <xs:annotation><xs:documentation>Colour of the trail at saturation; only a literal colour is used (others fall back to the default). Default a warm yellow.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorLow" type="paintType" default="#00000000">
      <xs:annotation><xs:documentation>Colour of an empty trail, blended toward color as the trail grows; only a literal colour is used. Default transparent black.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the simulation onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the simulation; absent means none.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="erosionType">
    <xs:annotation><xs:documentation>
      Hydraulic erosion of a heightmap by water droplets (Beyer 2015): each droplet runs downhill
      with inertia, carries sediment up to a capacity that grows with speed, water and slope,
      erodes within a radius and deposits where it slows or climbs, and evaporates. The terrain
      starts as fractal noise (or the `heightmap` image's luminance) and is drawn hill-shaded
      through colorLow to colorHigh.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Width of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Height of the simulation box in pixels; required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="resolution" default="256">
      <xs:annotation><xs:documentation>Number of terrain cells along the longer side of the box, 16 to 2048; default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="16"/><xs:maxInclusive value="2048"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the starting noise terrain and of the droplet start positions; absent, it is derived from the node id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="heightmap" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of an image asset whose luminance, rescaled to span 0 to 1, is the starting terrain height; absent, fractal noise is used. Once the image loads, octaves and frequency are not used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="octaves" default="6">
      <xs:annotation><xs:documentation>Number of noise layers summed in the starting terrain, 1 to 12; default 6. Not used when a loaded heightmap image supplies the terrain.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="12"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="frequency" type="positiveDecimal" default="3">
      <xs:annotation><xs:documentation>Number of noise features across the longer side of the starting terrain; default 3. Not used when a loaded heightmap image supplies the terrain.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="droplets" type="nonNegativeDecimal" default="20000">
      <xs:annotation><xs:documentation>Water droplets simulated per second; default 20000.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inertia" type="unitDecimal" default="0.05">
      <xs:annotation><xs:documentation>Share, 0 to 1, of its previous direction a droplet keeps instead of following the slope; default 0.05.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="capacity" type="nonNegativeDecimal" default="4">
      <xs:annotation><xs:documentation>Multiplier of how much sediment a droplet can carry; default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="erodeRate" type="unitDecimal" default="0.3">
      <xs:annotation><xs:documentation>Share, 0 to 1, of the missing sediment capacity a droplet picks up per move, and at most the height lost in that move; default 0.3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depositRate" type="unitDecimal" default="0.3">
      <xs:annotation><xs:documentation>Share, 0 to 1, of the sediment above capacity a droplet drops per move; when moving uphill it instead drops what fills the rise. Default 0.3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="evaporation" type="unitDecimal" default="0.01">
      <xs:annotation><xs:documentation>Fraction of its water a droplet loses per move, 0 to 1; default 0.01.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravity" type="nonNegativeDecimal" default="4">
      <xs:annotation><xs:documentation>How strongly height changes alter a droplet speed; default 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="erodeRadius" default="3">
      <xs:annotation><xs:documentation>Radius in cells of the area a droplet erodes, 1 to 16; default 3.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="16"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="relief" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Scale of slopes in the hill shading; higher is more contrast. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunAzimuth" type="xs:double" default="315">
      <xs:annotation><xs:documentation>Direction of the shading sun in degrees, 0 toward the top of the image and increasing clockwise; default 315.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunElevation" type="xs:double" default="45">
      <xs:annotation><xs:documentation>Height of the shading sun above the horizon in degrees; default 45.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorLow" type="paintType" default="#3B4A2FFF">
      <xs:annotation><xs:documentation>Colour of the lowest terrain; only a literal colour is used (others fall back to the default). Default dark green.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorHigh" type="paintType" default="#E8E2D0FF">
      <xs:annotation><xs:documentation>Colour of the highest terrain; only a literal colour is used (others fall back to the default). Default pale cream.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the simulation onto what is below it; default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ordered list of effect ids applied to the simulation; absent means none.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="clayBlobType">
    <xs:annotation><xs:documentation>
      One solid of a clay object (primitive="clay"), in the object's local scene units: its signed
      distance field joins the others with a smooth union of width `blend` (or is carved out
      with `subtract`). Blobs animate like any element, so topology can change over time.
    </xs:documentation></xs:annotation>
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Optional identifier of this blob, unique within the document; expressions can read the blob's properties through it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shape" default="sphere">
      <xs:annotation><xs:documentation>Which solid this blob is: sphere (default), box, capsule or torus.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="sphere"/><xs:enumeration value="box"/><xs:enumeration value="capsule"/><xs:enumeration value="torus"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal position of the blob's centre, in the clay object's local scene units (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical position of the blob's centre, in the clay object's local scene units (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Depth position of the blob's centre, in the clay object's local scene units (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="30">
      <xs:annotation><xs:documentation>Radius in local scene units (default 30): the sphere's radius, the capsule's cap and body radius, or the torus's ring radius. Not used by box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal" default="60">
      <xs:annotation><xs:documentation>Box: size along local x (default 60). Torus: diameter of the tube (default 60). Not used by sphere or capsule.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" default="60">
      <xs:annotation><xs:documentation>Box size along local y, in local scene units (default 60). Not used by the other shapes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="positiveDecimal" default="60">
      <xs:annotation><xs:documentation>Box size along local z, in local scene units (default 60). Not used by the other shapes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="nonNegativeDecimal" default="60">
      <xs:annotation><xs:documentation>Capsule only: distance between the two cap centres along the blob's local y axis, in local scene units (default 60).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the blob about its x axis, in degrees (default 0); combined with rotationY and rotation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the blob about its y axis, in degrees (default 0); combined with rotationX and rotation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the blob about its z axis, in degrees (default 0); combined with rotationX and rotationY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Width of the smooth join with the blobs before it, in local scene units (default 10); 0 gives a hard union. With subtract it is the width of the carved edge.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="subtract" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, carves this blob out of the blobs before it instead of adding to them (default false); on the first blob it has no effect.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:group name="nodeChoice">
    <xs:choice>
      <xs:element name="group" type="groupType"/>
      <xs:element name="sequence" type="sequenceType"/>
      <xs:element name="layer" type="layerType"/>
      <xs:element name="shape" type="shapeType"/>
      <xs:element name="connector" type="connectorType"/>
      <xs:element name="object3D" type="object3DType"/>
      <xs:element name="camera" type="cameraType"/>
      <xs:element name="particleEmitter" type="particleEmitterType"/>
      <xs:element name="particles3D" type="particles3DType"/>
      <xs:element name="ocean" type="oceanType"/>
      <xs:element name="blackHole" type="blackHoleType"/>
      <xs:element name="accretionDisk" type="accretionDiskType"/>
      <xs:element name="flock" type="flockType"/>
      <xs:element name="fluid" type="fluidType"/>
      <xs:element name="slime" type="slimeType"/>
      <xs:element name="erosion" type="erosionType"/>
      <xs:element name="instance" type="instanceType"/>
      <xs:element name="include" type="includeType"/>
      <xs:element name="repeat" type="repeatType"/>
      <xs:element name="adjustment" type="adjustmentType"/>
      <xs:element name="transition" type="transitionType"/>
      <xs:element name="skeleton" type="skeletonType"/>
      <!-- SREP 67, version 1.6 -->
      <xs:element name="compute" type="computeType"/>
      <xs:element name="iterate" type="iterateType"/>
      <!-- SREPs 66 and 69, version 1.6 -->
      <xs:element name="program" type="programNodeType"/>
      <!-- SREP 74, version 1.6 -->
      <xs:element name="viewport3D" type="viewport3DType"/>
    </xs:choice>
  </xs:group>
  <!-- ===================================================== SREP 74: a 3D scene with its own camera, as a node -->
  <xs:complexType name="viewport3DType">
    <xs:annotation><xs:documentation>Renders its own 3D scene (its object3D and camera children, and the lights named by
  @lights) into a width x height picture drawn at its origin. Isolated from the document's 3D scene. SREP 74.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="object3D" type="object3DType"/>
      <xs:element name="camera" type="cameraType"/>
      <xs:element name="particles3D" type="particles3DType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the viewport's picture in pixels (required); one scene unit is one pixel, and content beyond the frame is clipped.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the viewport's picture in pixels (required); one scene unit is one pixel, and content beyond the frame is clipped.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="camera" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a camera child of the viewport that views its scene; when absent, the last active camera child is used, or an implicit camera that maps the z=0 plane pixel for pixel.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lights" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the document lights that light the viewport's scene; when absent, every light of the document applies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="paintType" default="#00000000">
      <xs:annotation><xs:documentation>Paint that fills the viewport's picture before its scene is drawn; the default is fully transparent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the viewport's picture over what lies below it (default normal).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the effects applied, in order, to the viewport's picture.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <!-- ===================================================== SREP 67: compute accumulation, density tonemap, iterate -->
  <xs:complexType name="computeType">
    <xs:annotation><xs:documentation>Runs the WGSL compute shader @src for @invocations invocations; sr_accumulate adds
    integer amounts into a width x height histogram, which tonemap turns into this node's picture. SREP 67.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="param" type="paramValueType"/>
      <xs:element name="tonemap" type="densityTonemapType"/>
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Local WGSL compute-shader file that defines the point function the engine runs once per invocation, accumulating into a histogram (required).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>Expected SHA-256 of the shader file; if the file's hash differs, the node reports an error and is not drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width of the histogram and of the node's picture, in cells (one cell per pixel); required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height of the histogram and of the node's picture, in cells (one cell per pixel); required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="invocations" use="required">
      <xs:annotation><xs:documentation>Number of times the shader's point function runs each frame, with indices 0 to invocations-1 (required, at most 4294967295).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4294967295"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="channels" default="1">
      <xs:annotation><xs:documentation>Number of histogram planes: 1 for density only (coloured by the tonemap ramp), 4 for density plus red, green and blue colour sums (default 1).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:enumeration value="1"/><xs:enumeration value="4"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fractionBits" default="0">
      <xs:annotation><xs:documentation>Fixed-point fraction bits (0 to 24, default 0) used to quantise fractional amounts added by the shader; a count is divided by 2^fractionBits when drawn.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="24"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed mixed with the project seed to give the shader's random seed words (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the node's picture over what lies below it (default normal).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="densityTonemapType">
    <xs:attribute name="scale" default="log">
      <xs:annotation><xs:documentation>How density maps to brightness: log (default) compresses large counts logarithmically, linear scales them in proportion to the reference density.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="log"/><xs:enumeration value="linear"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="gain" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier on density inside the logarithm of the log scale (default 1); larger values brighten low densities. Not used by linear scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gamma" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Exponent applied as 1/gamma to the normalised density before colouring (default 1); above 1 brightens mid-tones.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reference" default="max">
      <xs:annotation><xs:documentation>"max" (the largest density in the frame) or a positive number: the density that maps to 1.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:union memberTypes="positiveDecimal"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="max"/></xs:restriction></xs:simpleType></xs:union></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ramp" type="xs:string" default="#000000FF #FFFFFFFF">
      <xs:annotation><xs:documentation>Space-separated #RRGGBB[AA] colours placed at equal steps from low to high density and interpolated between (default black to white); used only with one channel.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" default="opaque">
      <xs:annotation><xs:documentation>Whether the picture is opaque (default) or its alpha is scaled by the normalised density, so empty cells are transparent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="opaque"/><xs:enumeration value="density"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="iterateType">
    <xs:annotation><xs:documentation>Each frame, the stateful nodes inside start from their zero state and advance @steps
    steps (fewer with until="converged") before the frame is drawn. For stills; SREP 68 is the animated form.</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="nodeChoice"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="steps" use="required">
      <xs:annotation><xs:documentation>Number of steps each stateful node inside advances from its zero state before every frame is drawn (required); the ceiling when until is converged.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="10000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="until" default="steps">
      <xs:annotation><xs:documentation>steps (default) runs exactly steps steps; converged stops early once the state changes by no more than tolerance between two checks.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="steps"/><xs:enumeration value="converged"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tolerance" type="positiveDecimal" default="0.0001">
      <xs:annotation><xs:documentation>With until=converged, the largest per-channel change between two checks at or below which iteration stops (default 0.0001).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="checkEvery" type="xs:positiveInteger" default="100">
      <xs:annotation><xs:documentation>With until=converged, the number of steps between convergence checks (default 100, at most steps).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the iterate node's output over what lies below it (default normal).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="compositionType">
    <xs:group ref="nodeChoice" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:complexType name="symbolType">
    <xs:group ref="nodeChoice" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the symbol (required, unique); an instance, an include or an output overlay refers to the symbol by this value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="width" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Width in pixels of the symbol's frame; when absent, that of the document holding the instance, of the included document when included, and of the output when used as an overlay.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Height in pixels of the symbol's frame; when absent, that of the document holding the instance, of the included document when included, and of the output when used as an overlay.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="durationType">
      <xs:annotation><xs:documentation>Length in seconds of the symbol's own timeline when instantiated or included; when absent, the duration of the document that defines it (the host for an instance, the included file for an include). Ignored for an output overlay.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="paintType" default="#00000000">
      <xs:annotation><xs:documentation>Paint behind the symbol's content when it is used as an output overlay (default transparent); not drawn when the symbol is instantiated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="safeAreaForce" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        true exempts this node and everything it contains (for a symbol: every instance of it, and what it draws)
        from the safeArea enforce check (SA01); validate lists every node that carries it (SA02), so a deliberate
        placement outside the safe region is never silent.
      </xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="symbolsType">
    <xs:sequence><xs:element name="symbol" type="symbolType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== effects -->
  <xs:complexType name="effectType">
    <xs:annotation><xs:documentation>
      One element type for every effect; each type reads only the attributes it
      documents. Colour-grade family: color-grade (saturation/contrast/
      brightness, as 1.0), lift-gamma-gain (lift/gamma/gain "r,g,b"), cdl
      (slope/offset/power "r,g,b", saturation; ASC CDL), lut (@src .cube/.clf/
      .3dl, @space), curves (@curve "x,y x,y ..." per @channel), levels,
      white-balance (temperature/tint), exposure, hue-saturation, tonemap.
      shader: GLSL fragment at @src with param children as uniforms. It runs on a tile: the node's pixels, for a
      layer or shape without children, with a margin of 2 px plus the outward rounding of its box to whole pixels
      (up to 64 px past the frame); for any other node, the frame. sr_ContentRect (vec4: left, top, width, height
      of the node's content box in tile pixels from the tile's top-left, exact) and sr_PixelCoord (vec2: the
      fragment's centre relative to that corner) locate the content within it (SREP 72); the sr_ prefix is the
      engine's.
      selective-color: @hue (degrees) or @color (its hue) centres a window of width @tolerance; inside it @saturation
      scales and @brightness adds; @amount mixes the result with the original. @channel is not read.
      halftone: @size is the cell, @angle the screen's angle (default 0), @color the ink (default black) and
      @paint the ground between the dots (default white).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique identifier of the effect (required); nodes list it in their effects attribute to apply it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Which effect this is (required); it selects the effect and decides which of the other attributes are read.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <!-- 1.0 -->
        <xs:enumeration value="glow"/><xs:enumeration value="bloom"/>
        <xs:enumeration value="blur"/><xs:enumeration value="color-grade"/>
        <xs:enumeration value="vignette"/><xs:enumeration value="lens-flare"/>
        <xs:enumeration value="drop-shadow"/><xs:enumeration value="lighting"/>
        <!-- blur family -->
        <xs:enumeration value="directional-blur"/><xs:enumeration value="radial-blur"/>
        <xs:enumeration value="zoom-blur"/><xs:enumeration value="lens-blur"/>
        <xs:enumeration value="pixel-motion-blur"/><xs:enumeration value="tilt-shift"/>
        <!-- colour -->
        <xs:enumeration value="lift-gamma-gain"/><xs:enumeration value="cdl"/>
        <xs:enumeration value="lut"/><xs:enumeration value="curves"/>
        <xs:enumeration value="levels"/><xs:enumeration value="white-balance"/>
        <xs:enumeration value="exposure"/><xs:enumeration value="hue-saturation"/>
        <xs:enumeration value="tonemap"/><xs:enumeration value="tint"/>
        <xs:enumeration value="tritone"/><xs:enumeration value="gradient-map"/>
        <xs:enumeration value="grayscale"/><xs:enumeration value="sepia"/>
        <xs:enumeration value="invert"/><xs:enumeration value="posterize"/>
        <!-- SREP 67: serial image operations in integer arithmetic -->
        <xs:enumeration value="error-diffusion"/><xs:enumeration value="segmented-sort"/>
        <xs:enumeration value="threshold"/><xs:enumeration value="color-overlay"/>
        <xs:enumeration value="gradient-overlay"/><xs:enumeration value="selective-color"/>
        <!-- stylise and texture -->
        <xs:enumeration value="film-grain"/><xs:enumeration value="noise"/>
        <xs:enumeration value="chromatic-aberration"/><xs:enumeration value="sharpen"/>
        <xs:enumeration value="unsharp-mask"/><xs:enumeration value="halation"/>
        <xs:enumeration value="light-leak"/><xs:enumeration value="light-sweep"/>
        <xs:enumeration value="glitch"/><xs:enumeration value="rgb-split"/>
        <xs:enumeration value="scanlines"/><xs:enumeration value="vhs"/>
        <xs:enumeration value="halftone"/><xs:enumeration value="pixelate"/>
        <xs:enumeration value="mosaic"/><xs:enumeration value="emboss"/>
        <xs:enumeration value="bevel"/><xs:enumeration value="inner-shadow"/>
        <xs:enumeration value="inner-glow"/><xs:enumeration value="long-shadow"/>
        <xs:enumeration value="stroke"/><xs:enumeration value="outline"/>
        <xs:enumeration value="echo"/><xs:enumeration value="posterize-time"/>
        <xs:enumeration value="letterbox"/><xs:enumeration value="mirror"/>
        <xs:enumeration value="kaleidoscope"/><xs:enumeration value="tile"/>
        <!-- distort -->
        <xs:enumeration value="displacement-map"/><xs:enumeration value="turbulent-displace"/>
        <xs:enumeration value="wave-warp"/><xs:enumeration value="ripple"/>
        <xs:enumeration value="twirl"/><xs:enumeration value="spherize"/>
        <xs:enumeration value="bulge"/><xs:enumeration value="lens-distortion"/>
        <xs:enumeration value="heat-haze"/>
        <!-- keying and matting -->
        <xs:enumeration value="chroma-key"/><xs:enumeration value="luma-key"/>
        <xs:enumeration value="difference-key"/><xs:enumeration value="spill-suppress"/>
        <xs:enumeration value="matte-choke"/>
        <!-- generative and custom -->
        <xs:enumeration value="fill"/><xs:enumeration value="fractal-noise"/>
        <xs:enumeration value="god-rays"/><xs:enumeration value="shader"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When false the effect is skipped and the picture passes through unchanged (default true).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mix" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Blend between the unaffected picture (0) and the full effect result (1), a linear mix (default 1); echo, posterize-time and pixel-motion-blur do not apply it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="intensity" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Strength of the effect (default 1): brightness of the added glow for glow, bloom and halation, opacity of shadows, strength of flares, leaks and sweeps; for echo, the decay between copies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="effectRadiusType" default="4">
      <xs:annotation><xs:documentation>Size in node-local pixels (default 4): Gaussian blur radius for blur, glow and shadows; half-length of directional blur; reach of twirl, spherize and bulge (4 or less means half the shorter side); vignette clear radius.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="threshold" type="xs:double" default="0.7">
      <xs:annotation><xs:documentation>Luminance level, default 0.7: glow, bloom, halation and god rays pass highlights above it (with a soft knee near it), threshold splits black from white at it, luma-key keys around it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="saturation" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Colour saturation multiplier (default 1): 1 leaves colours as they are, 0 removes colour. Also read by cdl, and by selective-color inside its hue window; in noise, 0 makes the noise monochrome.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="contrast" type="xs:double" default="1">
      <xs:annotation><xs:documentation>color-grade only: contrast multiplier about mid-grey on display-encoded values (default 1, unchanged).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="brightness" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Brightness added to display-encoded values (default 0): in color-grade to the picture, in hue-saturation to the value channel, in selective-color inside the hue window.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType">
      <xs:annotation><xs:documentation>Colour the effect draws with; each type has its own default when absent (black for shadows, vignette and letterbox, white for glow and strokes, orange for halation and light leak). Halftone ink; selective-color hue centre.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="paint" type="paintType">
      <xs:annotation><xs:documentation>Second paint of the effect: the gradient for gradient-map and gradient-overlay, and for halftone the ground between the dots (default opaque white).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetX" type="effectOffsetType" default="8">
      <xs:annotation><xs:documentation>Horizontal offset in node-local pixels (default 8): where a drop shadow or inner shadow is displaced to, and the horizontal channel offset of rgb-split.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offsetY" type="effectOffsetType" default="8">
      <xs:annotation><xs:documentation>Vertical offset in node-local pixels (default 8): where a drop shadow or inner shadow is displaced to, and the vertical channel offset of rgb-split.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lights" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of lights whose positions and intensities light the picture in a lighting effect (up to four are used).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="falloff" default="smooth">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="quadratic"/>
        <xs:enumeration value="smooth"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="relief" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Depth of the surface relief (default 0): in emboss the sampling distance in pixels (at least 1), in lighting the height scale of the bump (at least 0.2).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angle" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Direction or rotation in degrees (default 0): of directional-blur, long-shadow and wave-warp; light direction of emboss, bevel and lighting (bevel and lighting take 0 as -45); halftone, mirror, gradient, twirl.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amount" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Main strength of the effect (default 1): a displacement in pixels for displacement, wave, ripple and chromatic-aberration effects; a 0-1 mix for tint, grayscale, sepia, invert and overlays; for matte-choke, positive erodes and negative dilates.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Meaning depends on the type: cell size in pixels for halftone, pixelate and mosaic; line width for stroke and outline; wavelength for wave-warp and ripple; length for long-shadow; aspect ratio for letterbox.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frequency" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Rate or scale (default 1): steps per second for posterize-time, wave cycles per second (times speed) for wave-warp, spatial frequency multiplier for fractal-noise.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Rate (default 1) at which time-varying effects advance: it multiplies elapsed seconds for fractal-noise, heat-haze, light-leak, light-sweep, ripple, turbulent-displace and wave-warp.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Random seed for effects that draw noise, such as film-grain, fractal-noise, glitch, light-leak and turbulent-displace; the pattern also depends on the project seed and the effect's id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerX" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal centre of the effect in node-local pixels; when absent the node's centre is used (lens-flare puts its source near the node's top-left instead). For radial, zoom, twirl, bulge, vignette and similar.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerY" type="xs:double">
      <xs:annotation><xs:documentation>Vertical centre of the effect in node-local pixels; when absent the node's centre is used (lens-flare puts its source near the node's top-left instead). For radial, zoom, twirl, bulge, vignette and similar.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="samples" type="xs:positiveInteger" default="16">
      <xs:annotation><xs:documentation>Number of samples (default 16): taps for directional, radial and zoom blur and god rays, copies for echo (2 to 16), samples for pixel-motion-blur; lens blur and tilt-shift derive their rings from it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lift" type="xs:string">
      <xs:annotation><xs:documentation>lift-gamma-gain: black-level lift, as one number or three comma-separated r,g,b values, applied to display-encoded values (default 0 for each channel).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gamma" type="xs:string">
      <xs:annotation><xs:documentation>Mid-tone gamma as one number or r,g,b values (default 1; higher brightens). Read by lift-gamma-gain, and by levels (first value only).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gain" type="xs:string">
      <xs:annotation><xs:documentation>lift-gamma-gain: highlight multiplier, as one number or three comma-separated r,g,b values, applied to display-encoded values (default 1 for each channel).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="slope" type="xs:string">
      <xs:annotation><xs:documentation>cdl: ASC CDL slope, a multiplier on display-encoded values given as one number or three r,g,b values (default 1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:string">
      <xs:annotation><xs:documentation>cdl: ASC CDL offset added to display-encoded values, given as one number or three r,g,b values (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="power" type="xs:string">
      <xs:annotation><xs:documentation>cdl: ASC CDL power (exponent) applied to display-encoded values, given as one number or three r,g,b values (default 1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperature" type="xs:double" default="0">
      <xs:annotation><xs:documentation>white-balance: positive values warm the picture (more red, less blue), negative cool it; the scale is about -100 to 100 (default 0, neutral).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tint" type="xs:double" default="0">
      <xs:annotation><xs:documentation>white-balance: shifts between green and magenta on a scale of about -100 to 100; positive values reduce green (toward magenta), 0 is neutral (default).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="exposure" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Exposure change in stops (default 0): the picture is multiplied by 2 to the power of the value, in exposure and before the tone mapper in tonemap.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="hue" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Hue in degrees (default 0): hue-saturation rotates all hues by it; selective-color centres its hue window on it unless color is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="channel" default="rgb">
      <xs:annotation><xs:documentation>Channel an effect works on (default rgb): curves and levels adjust red, green, blue or all; curves and invert also take luma; alpha acts as rgb in curves, levels and invert; noise is monochrome unless rgb.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="rgb"/><xs:enumeration value="red"/><xs:enumeration value="green"/>
        <xs:enumeration value="blue"/><xs:enumeration value="alpha"/><xs:enumeration value="luma"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="curve" type="xs:string">
      <xs:annotation><xs:documentation>curves: control points as space-separated x,y pairs (input and output in 0-1 on display-encoded values), at least two, joined by a smooth spline.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inputBlack" type="xs:double" default="0">
      <xs:annotation><xs:documentation>levels: input value (0-1 on display-encoded values) mapped to black; values below it clip (default 0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inputWhite" type="xs:double" default="1">
      <xs:annotation><xs:documentation>levels: input value (0-1 on display-encoded values) mapped to white; values above it clip (default 1).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outputBlack" type="xs:double" default="0">
      <xs:annotation><xs:documentation>levels: output value that black input maps to (default 0), which lifts the blacks.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="outputWhite" type="xs:double" default="1">
      <xs:annotation><xs:documentation>levels: output value that white input maps to (default 1), which lowers the whites.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="levels" type="xs:positiveInteger" default="8">
      <xs:annotation><xs:documentation>Count of discrete steps or sides (default 8): colour levels per channel for posterize (at least 2), blade count of the lens-blur and tilt-shift aperture (below 3 is round), segments for kaleidoscope.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyColor" type="colorType">
      <xs:annotation><xs:documentation>Colour to remove for chroma-key, or whose spill is suppressed in spill-suppress (default green).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tolerance" type="unitDecimal" default="0.2">
      <xs:annotation><xs:documentation>0-1 (default 0.2): chroma-key and difference-key make pixels closer than this distance to the key transparent; in selective-color, the width of the hue window as a fraction of the hue circle.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="softness" type="unitDecimal" default="0.1">
      <xs:annotation><xs:documentation>0-1 (default 0.1): soft edge width: the ramp beyond the tolerance in chroma-key and difference-key, around the threshold in luma-key, the vignette falloff; matte-choke blurs its edge only from about 0.25 (at full size).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spill" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>chroma-key and spill-suppress: how strongly the key colour's spill is removed from the remaining pixels, 0 to 1 (default 0.5).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Second input: displacement map, gradient-map paint source, difference-key plate.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>File an effect loads: the .cube, .clf or .3dl look-up table for lut, or the GLSL fragment shader for shader; both types need it (lut without it is an error, shader passes the picture through).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="space" type="colorSpaceType">
      <xs:annotation><xs:documentation>Colour space of the file data: for lut, the space the table expects and returns (default the working space); for shader, the space the shader receives and returns pixels in (default sRGB).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tonemapper" default="aces">
      <xs:annotation><xs:documentation>tonemap: which curve compresses high dynamic range to display range: aces (default), agx, filmic, reinhard, hable or pq-to-sdr.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="aces"/><xs:enumeration value="agx"/><xs:enumeration value="filmic"/>
        <xs:enumeration value="reinhard"/><xs:enumeration value="hable"/><xs:enumeration value="pq-to-sdr"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="position" default="outside">
      <xs:annotation><xs:documentation>Where the line sits relative to the shape's edge: outside (default), inside or center. Read by stroke and outline.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="outside"/><xs:enumeration value="inside"/><xs:enumeration value="center"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="compositeOriginal" default="behind">
      <xs:annotation><xs:documentation>drop-shadow only: behind (default) draws the shadow under the content, on-top over it, none shows the shadow alone.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="behind"/><xs:enumeration value="on-top"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <!-- SREP 67: error-diffusion and segmented-sort -->
    <xs:attribute name="kernel" default="floyd-steinberg">
      <xs:annotation><xs:documentation>error-diffusion: dithering kernel (floyd-steinberg default, atkinson, jarvis-judice-ninke, stucki, burkes, sierra) that spreads each pixel's quantisation error to its neighbours.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="floyd-steinberg"/><xs:enumeration value="atkinson"/><xs:enumeration value="jarvis-judice-ninke"/>
        <xs:enumeration value="stucki"/><xs:enumeration value="burkes"/><xs:enumeration value="sierra"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="palette" type="xs:string">
      <xs:annotation><xs:documentation>error-diffusion: space-separated #RRGGBB[AA] colours the picture is reduced to (default black and white); any AA part is ignored and the picture's own alpha is kept.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="serpentine" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>error-diffusion: when true, odd rows are scanned right to left and the kernel is mirrored (default false, every row left to right).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" default="horizontal">
      <xs:annotation><xs:documentation>segmented-sort: horizontal (default) sorts each row, vertical sorts each column.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="horizontal"/><xs:enumeration value="vertical"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="order" default="ascending">
      <xs:annotation><xs:documentation>segmented-sort: ascending (default) or descending key order within each segment.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="ascending"/><xs:enumeration value="descending"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sortKey" default="luma">
      <xs:annotation><xs:documentation>segmented-sort: the value pixels are sorted by: luma (default), red, green or blue.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="luma"/><xs:enumeration value="red"/><xs:enumeration value="green"/><xs:enumeration value="blue"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="low" type="unitDecimal" default="0">
      <xs:annotation><xs:documentation>segmented-sort: lower bound (0-1, default 0) of the sort key; a segment is a run of pixels whose key lies between low and high, and pixels outside stay in place.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="high" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>segmented-sort: upper bound (0-1, default 1) of the sort key; a segment is a run of pixels whose key lies between low and high. Must be at least low.</xs:documentation></xs:annotation>
    </xs:attribute>
    <!-- SREP 68: steps of persistent shader passes -->
    <xs:attribute name="stepsPerFrame" default="1">
      <xs:annotation><xs:documentation>type="shader" with PERSISTENT passes: steps (evaluations of all passes) per frame. SREP 68.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="10000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="prewarm" default="0">
      <xs:annotation><xs:documentation>Steps run before the node's first active frame, with the inputs of that frame. SREP 68.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="10000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="effectsType">
    <xs:sequence><xs:element name="effect" type="effectType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== lights -->
  <xs:complexType name="lightType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of light: ambient, directional, point, spot, rect-area, disk-area, sphere-area or dome. A dome lights from an environment image or a gradient sky; with neither it lights uniformly like an ambient light.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="ambient"/><xs:enumeration value="directional"/>
        <xs:enumeration value="point"/><xs:enumeration value="spot"/>
        <xs:enumeration value="rect-area"/><xs:enumeration value="disk-area"/>
        <xs:enumeration value="sphere-area"/><xs:enumeration value="dome"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour of the light, default white; a colorTemperature tint multiplies it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorTemperature" type="kelvinType">
      <xs:annotation><xs:documentation>Colour temperature in kelvin that tints the light with the matching blackbody colour, multiplied with the colour; absent means no tint. A lighting effect ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="intensity" type="lightIntensityType" default="1">
      <xs:annotation><xs:documentation>Brightness multiplier of the light; defaults to 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="exposure" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Brightness adjustment in stops: the intensity is multiplied by 2 to the power of this value; defaults to 0. A lighting effect ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="range" type="positiveDecimal">
      <xs:annotation><xs:documentation>Distance in scene units at which a point, spot or area light fades to zero; absent or 0 means no cutoff. A lighting effect instead reads it in node pixels, with absent meaning half the frame height.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="falloff" type="positiveDecimal" default="2">
      <xs:annotation><xs:documentation>Exponent of the distance attenuation of point, spot and area lights: intensity falls as 1 over (distance/100) to this power; defaults to 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spotAngle" type="spotAngleType" default="45">
      <xs:annotation><xs:documentation>Full opening angle of a spot light's cone in degrees; defaults to 45.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerConeAngle" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Full angle in degrees of the spot cone's fully lit core, with a smooth edge out to the spot angle; absent means 80 percent of the spot angle.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="castShadow" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the light casts shadows; defaults to false. It has no effect on ambient and dome lights.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowSoftness" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Width of the shadow edge blur, in shadow-map texels, with a minimum effective value of 1; defaults to 0. Only lights with castShadow true use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowBias" type="xs:double" default="0.0005"/>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal position of the light in scene units; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical position of the light in scene units; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Depth position of the light in scene units; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="yaw" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the light about the vertical axis in degrees; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pitch" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the light about the horizontal axis in degrees; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="roll" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the light about its own pointing axis in degrees; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal">
      <xs:annotation><xs:documentation>Width of a rect-area light in scene units (absent means 50). A disk-area light takes its radius from half of it only when radius is absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal">
      <xs:annotation><xs:documentation>Height of a rect-area light in scene units; absent means the same as the width.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal">
      <xs:annotation><xs:documentation>Radius of a disk-area or sphere-area light in scene units; absent means half the width for a disk and 10 otherwise.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ies" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path to an IES photometric profile that shapes the light's angular distribution; an unreadable profile is reported as an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="environment" type="xs:anyURI">
      <xs:annotation><xs:documentation>type="dome": equirectangular HDRI used for image-based lighting and reflections.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="environmentVisible" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether a dome light's environment or sky is drawn as the background; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="affectsDiffuse" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the light contributes to diffuse shading; defaults to true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="affectsSpecular" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the light contributes to specular highlights; defaults to true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shadowMapSize" default="2048">
      <xs:annotation><xs:documentation>Side of the square shadow map in texels, 16 to 8192, default 2048; shadow-casting lights share one map size, the largest requested, and it may be reduced to fit a memory budget.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger">
        <xs:minInclusive value="16"/><xs:maxInclusive value="8192"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <!-- Screen-space contact shadows for detail the
         shadow map cannot resolve -->
    <xs:attribute name="contactShadows" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether screen-space contact shadows add fine shadow detail the shadow map cannot resolve; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="contactShadowLength" type="positiveDecimal" default="20">
      <xs:annotation><xs:documentation>Distance in scene units that contact shadows search from each surface toward the light; defaults to 20. Used only when contactShadows is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <!-- SREP 71: a procedural sky (type="dome" only) -->
    <xs:attribute name="sky" default="none">
      <xs:annotation><xs:documentation>On a dome light, selects a procedural gradient sky instead of an environment image; none is the default. Only dome lights may set it, and a sky excludes an environment image.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="none"/><xs:enumeration value="gradient"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="skyZenith" type="colorType" default="#3A6EA5FF">
      <xs:annotation><xs:documentation>Colour of the procedural sky straight overhead; defaults to a mid blue.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skyHorizon" type="colorType" default="#C8D8E8FF">
      <xs:annotation><xs:documentation>Colour of the procedural sky at the horizon; defaults to a pale blue-grey.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skyGround" type="colorType" default="#4A4038FF">
      <xs:annotation><xs:documentation>Colour of the procedural sky below the horizon; defaults to a dark brown.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="skyExponent" type="positiveDecimal" default="0.5"/>
    <xs:attribute name="sunAzimuth" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Compass direction of the sun in the procedural sky in degrees; 0 faces +z and positive values turn toward +x; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunElevation" type="xs:double" default="45">
      <xs:annotation><xs:documentation>Height of the sun above the horizon in the procedural sky in degrees; defaults to 45.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunSize" type="nonNegativeDecimal" default="0.53">
      <xs:annotation><xs:documentation>Angular diameter of the sun disc in degrees; 0 removes the sun; defaults to 0.53.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunColor" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour of the sun disc in the procedural sky; defaults to white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sunIntensity" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Brightness multiplier of the sun disc in the procedural sky; 0, the default, shows no sun.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="lightsType">
    <xs:sequence><xs:element name="light" type="lightType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== physics -->
  <xs:complexType name="forceFieldType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of field: directional, radial, vortex, turbulence, drag, wind or attractor-path. Directional pushes with a constant acceleration, radial pulls toward or pushes from a centre, vortex swirls around it, and drag slows motion.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="directional"/><xs:enumeration value="radial"/>
        <xs:enumeration value="vortex"/><xs:enumeration value="turbulence"/>
        <xs:enumeration value="drag"/><xs:enumeration value="wind"/>
        <xs:enumeration value="attractor-path"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal position in pixels of the centre of a radial or vortex field; a turbulence field uses it only to centre its radius, when one is set; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical position in pixels of the centre of a radial or vortex field; a turbulence field uses it only to centre its radius, when one is set; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Depth of a radial field's centre in pixels (scene z), for 3D bodies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal acceleration of a directional or wind field in metres per second squared, positive toward +x; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Vertical acceleration of a directional or wind field in metres per second squared, positive up; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>m/s² toward the camera, for 3D bodies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strength" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Magnitude of a radial, vortex, turbulence, drag or attractor-path field; positive radial strength attracts toward the centre; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="falloff" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Exponent of the distance fade of radial, vortex and attractor-path fields, and of turbulence inside a radius: (1 - d/radius) to this power inside a radius, else 1/(d/100 px) to it; default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Reach in metres of a radial, vortex, turbulence or attractor-path field; beyond it the field has no effect. Absent or 0 means unlimited reach.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Size of the noise features of a turbulence field or of the gusts of a wind field; larger values give broader swirls and gusts; defaults to 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation><xs:documentation>SVG path data whose outline an attractor-path field pulls toward; the nearest point on the path attracts.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong">
      <xs:annotation><xs:documentation>Seed of the noise of a turbulence or wind field; absent means a seed derived from the field's id, so the result stays stable.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds at which the field becomes active; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds at which the field stops acting; absent means it stays active.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="affects" default="all">
      <xs:annotation><xs:documentation>Which things the field acts on: all, only physics bodies, or only particles; defaults to all.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="all"/><xs:enumeration value="bodies"/><xs:enumeration value="particles"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="constraintType">
    <xs:annotation><xs:documentation>
      spring/distance/rope/hinge/slider/weld/motor join bodies a and b; pin ties
      body a to the world point x, y (b is not allowed) and is rigid unless
      stiffness is given. breakForce removes the constraint when exceeded.
      Between 3D bodies (object3D rigidBody) the anchor is x, y, z; hinge,
      motor and slider turn about or slide along axisX, axisY, axisZ (scene axes; z by default for hinges and
      motors, x for sliders); ball is a ball-and-socket joint.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of joint: spring, distance, rope, hinge, slider, weld, motor, ball or pin. Pin ties body a to a world point; ball is a ball-and-socket joint between 3D bodies.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="spring"/><xs:enumeration value="distance"/>
        <xs:enumeration value="pin"/><xs:enumeration value="rope"/>
        <xs:enumeration value="hinge"/><xs:enumeration value="slider"/>
        <xs:enumeration value="weld"/><xs:enumeration value="motor"/>
        <xs:enumeration value="ball"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="a" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the first body joined by the constraint (required).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="b" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the second body joined; required for every type except pin, and not allowed on a pin, which ties body a to the world point given by x and y.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double">
      <xs:annotation><xs:documentation>Horizontal world position in pixels of the joint anchor at the start; used only when y is also given, otherwise the anchor is the second body's centre, or the first body's for a pin.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double">
      <xs:annotation><xs:documentation>Vertical world position in pixels of the joint anchor at the start; used only when x is also given, otherwise the anchor is the second body's centre, or the first body's for a pin.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double">
      <xs:annotation><xs:documentation>Depth of the anchor in pixels between 3D bodies, used when x and y are given; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="axisX" type="xs:double">
      <xs:annotation><xs:documentation>X component of the axis a 3D hinge or motor turns about, or a slider moves along; when none of the three axis components is given, hinges and motors use z and sliders use x.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="axisY" type="xs:double">
      <xs:annotation><xs:documentation>Y component of the axis a 3D hinge or motor turns about, or a slider moves along; when none of the three axis components is given, hinges and motors use z and sliders use x.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="axisZ" type="xs:double">
      <xs:annotation><xs:documentation>Z component of the axis a 3D hinge or motor turns about, or a slider moves along; when none of the three axis components is given, hinges and motors use z and sliders use x.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="restLength" type="xs:double">
      <xs:annotation><xs:documentation>Rest length in pixels of a spring, distance or rope constraint; absent means the distance between the two bodies at the start.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stiffness" type="xs:double">
      <xs:annotation><xs:documentation>Stiffness of a spring, distance or pin constraint; absent gives mass-scaled defaults for springs and distance joints, and a rigid pin.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="damping" type="xs:double">
      <xs:annotation><xs:documentation>Damping of a spring or distance constraint, or of a pin that has a stiffness; absent gives a mass-scaled default. A pin without stiffness is rigid and ignores it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minAngle" type="xs:double">
      <xs:annotation><xs:documentation>Lower limit of a hinge or motor in degrees, or of travel along a slider in pixels; applies only when maxAngle is also given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxAngle" type="xs:double">
      <xs:annotation><xs:documentation>Upper limit of a hinge or motor in degrees, or of travel along a slider in pixels; applies only when minAngle is also given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="axisAngle" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Direction in degrees of a slider's travel axis in the 2D plane; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motorSpeed" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Target rotation speed of a motor constraint in degrees per second; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxForce" type="nonNegativeDecimal"/>
    <xs:attribute name="breakForce" type="nonNegativeDecimal"/>
  </xs:complexType>
  <xs:complexType name="physicsType">
    <xs:annotation><xs:documentation>
      softBody: validation also rejects a body whose stable integration needs
      more than 4096 substeps per fixedStep. The physics world is metres, +y up;
      pixelsPerMeter maps it to screen pixels (+y down).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="forceField" type="forceFieldType"/>
      <xs:element name="constraint" type="constraintType"/>
    </xs:choice>
    <xs:attribute name="fixedStep" type="positiveDecimal" default="0.008333333333333333">
      <xs:annotation><xs:documentation>Length in seconds of one simulation step; defaults to 1/120.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal gravity in metres per second squared, positive toward +x; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityY" type="xs:double" default="-9.80665">
      <xs:annotation><xs:documentation>Vertical gravity in metres per second squared, positive up; defaults to -9.80665, standard gravity pulling down.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>m/s² toward the camera, for 3D bodies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pixelsPerMeter" type="positiveDecimal" default="100">
      <xs:annotation><xs:documentation>Number of screen pixels in one metre of the simulated world; defaults to 100.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="solverIterations" type="xs:positiveInteger" default="8">
      <xs:annotation><xs:documentation>Number of constraint-solver iterations per step; more is more accurate and slower; defaults to 8.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds at which the simulation begins; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bounds" default="none">
      <xs:annotation><xs:documentation>Invisible world boundaries: none (default), frame for walls around the whole frame, or floor for a floor along its bottom.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="frame"/><xs:enumeration value="floor"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path to a precomputed physics recording used instead of simulating. A missing file or a mismatching older-format file falls back to simulating; a damaged or non-matching current-format file is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cacheSha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 of the cache file. A different hash is an error for a current-format cache; for an older-format cache it is reported and the simulation runs instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixInternalEdges" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        For 3D bodies: fix the contacts that the edges between the triangles of a mesh make. A body that meets
        a flat mesh gets the mesh's normal whatever its tessellation (without it the normal of the triangle
        edge or corner the body met, which tilts by several degrees and kicks a sliding body sideways), and
        a crater from an impact on such a mesh has its axis and speed from the surface either way. The meshes
        are taken as two-sided. It changes the motion of every body that slides or lands on a mesh, so it
        is off by default, which is the behaviour there always was.
      </xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== tracking data -->
  <xs:complexType name="trackDataType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the tracking data; track constraints and tracked attachments name it as their target.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Path of the tracking file to read; only local files are supported, and a file that cannot be read or parsed is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="point"/><xs:enumeration value="planar"/>
        <xs:enumeration value="camera"/><xs:enumeration value="mask"/>
        <xs:enumeration value="face"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="format" default="json">
      <xs:annotation><xs:documentation>File format of the tracking data: json (default), csv, nuke, after-effects, mocha or fbx.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="json"/><xs:enumeration value="csv"/><xs:enumeration value="nuke"/>
        <xs:enumeration value="after-effects"/><xs:enumeration value="mocha"/><xs:enumeration value="fbx"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="footage" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the footage asset the data was tracked on; when a layer plays it, track points map from its pixels into the frame through that layer and follow its source time, otherwise they are used as given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Seconds added to the time at which the tracking data is sampled, shifting the track against the footage; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type"/>
  </xs:complexType>
  <xs:complexType name="trackingType">
    <xs:sequence><xs:element name="trackData" type="trackDataType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== audio -->
  <xs:simpleType name="audioSecondsType">
    <xs:restriction base="xs:double"><xs:maxInclusive value="1e7"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="eqBandType">
    <xs:attribute name="kind" default="peak">
      <xs:annotation><xs:documentation>Filter shape of the band: peak (default), low-shelf, high-shelf, highpass, lowpass or notch.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="peak"/><xs:enumeration value="low-shelf"/><xs:enumeration value="high-shelf"/>
        <xs:enumeration value="highpass"/><xs:enumeration value="lowpass"/><xs:enumeration value="notch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="frequency" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Centre or corner frequency of the band in hertz (required).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gain" type="decibelType" default="0">
      <xs:annotation><xs:documentation>Boost or cut of a peak or shelf band in decibels; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="q" type="positiveDecimal" default="0.707">
      <xs:annotation><xs:documentation>Quality factor of the band, the narrowness of its response; defaults to 0.707.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="audioEffectType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="band" type="eqBandType"/>
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of effect: eq, highpass, lowpass, compressor, limiter, gate, de-esser, reverb, delay, chorus, pitch-shift, noise-reduction, stereo-width, gain, distortion or telephone.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="eq"/><xs:enumeration value="highpass"/><xs:enumeration value="lowpass"/>
        <xs:enumeration value="compressor"/><xs:enumeration value="limiter"/><xs:enumeration value="gate"/>
        <xs:enumeration value="de-esser"/><xs:enumeration value="reverb"/><xs:enumeration value="delay"/>
        <xs:enumeration value="chorus"/><xs:enumeration value="pitch-shift"/><xs:enumeration value="noise-reduction"/>
        <xs:enumeration value="stereo-width"/><xs:enumeration value="gain"/><xs:enumeration value="distortion"/>
        <xs:enumeration value="telephone"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the effect is applied; a disabled effect passes the sound through unchanged; defaults to true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mix" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Wet/dry balance of the effect from 0 (original only) to 1 (processed only); defaults to 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="frequency" type="positiveDecimal">
      <xs:annotation><xs:documentation>Frequency in hertz: the cut-off of highpass and lowpass (defaults 80 and 8000), the centre of a de-esser (6000) and of a single-band eq, and the modulation rate of a chorus (0.8).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gain" type="decibelType" default="0">
      <xs:annotation><xs:documentation>Gain in decibels: the make-up gain of a compressor or gate, the level change of a gain effect, and the boost of a single-band eq; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="threshold" type="decibelType" default="-18">
      <xs:annotation><xs:documentation>Level in decibels above which a compressor reduces gain, below which a gate attenuates, or at which a limiter caps the peaks; defaults to -18.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ratio" type="positiveDecimal" default="4">
      <xs:annotation><xs:documentation>Compression ratio of a compressor, or attenuation strength of a gate below its threshold; defaults to 4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="attack" type="nonNegativeDecimal" default="0.01">
      <xs:annotation><xs:documentation>Time constant in seconds (default 0.01) of the gain moving toward more reduction in a compressor, and toward open in a gate.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="release" type="nonNegativeDecimal" default="0.1">
      <xs:annotation><xs:documentation>Time constant in seconds (default 0.1) of the gain recovering in a compressor, and of a gate closing.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="knee" type="nonNegativeDecimal" default="3">
      <xs:annotation><xs:documentation>Width in decibels of the soft transition around a compressor's threshold; 0 gives a hard knee; defaults to 3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="time" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Delay time in seconds of a delay effect; defaults to 0.25.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="feedback" type="unitDecimal" default="0.3">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of the delayed signal fed back into a delay effect; defaults to 0.3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="roomSize" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Size of a reverb's room from 0 to 1; larger rooms ring longer; defaults to 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Stereo width: for a stereo-width effect 0 is mono and 1 the original width; for a reverb it sets how much the two reverb channels differ; defaults to 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="semitones" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Pitch shift in semitones for a pitch-shift effect, positive up; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amount" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Strength from 0 to 1 of a chorus depth, noise-reduction, distortion drive, telephone drive or reverb damping; defaults to 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sidechain" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a track or bus whose signal drives the detector of a compressor or gate instead of its own input.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:attributeGroup name="duckingAttributes">
    <xs:annotation><xs:documentation>
      Automatic ducking: while any track or bus in duckUnder is above
      duckThreshold, this track's gain falls by duckAmount dB with the given
      attack/release. Replaces hand-drawn volume keyframes under voice-over.
    </xs:documentation></xs:annotation>
    <xs:attribute name="duckUnder" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the tracks or buses that trigger ducking: while any of them is above the threshold, this node's level is lowered.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duckAmount" type="decibelType" default="-12">
      <xs:annotation><xs:documentation>Gain change in decibels applied while ducking, normally negative (a positive value is treated as 0); defaults to -12.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duckThreshold" type="decibelType" default="-40">
      <xs:annotation><xs:documentation>Level in decibels the triggering signals must exceed to start ducking; defaults to -40.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duckAttack" type="nonNegativeDecimal" default="0.15">
      <xs:annotation><xs:documentation>Time constant in seconds (default 0.15) with which the ducking gain falls once triggered.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duckRelease" type="nonNegativeDecimal" default="0.4">
      <xs:annotation><xs:documentation>Time constant in seconds (default 0.4) with which the gain recovers after the triggering signal drops below the threshold.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:simpleType name="audioRoleType">
    <xs:annotation><xs:documentation>What an audio track carries.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="dialogue"/><xs:enumeration value="voiceover"/>
      <xs:enumeration value="music"/><xs:enumeration value="effects"/>
      <xs:enumeration value="ambience"/><xs:enumeration value="audio-description"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="audioRoleListType">
    <xs:list itemType="audioRoleType"/>
  </xs:simpleType>
  <xs:complexType name="audioTrackType">
    <xs:annotation><xs:documentation>volume, pan and gain animate with nested animation elements (audio automation).</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the audio track; outputs select it by id, and ducking and sidechains name it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="asset" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the audio, video or generated-media asset the track plays (required), which must be a local file; a video asset plays its audio stream.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="audioSecondsType" default="0">
      <xs:annotation><xs:documentation>Time in seconds at which the track begins, on the composition timeline (on the output's own timeline for a track inside an output); defaults to 0, and a start marker adds to it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="startMarker" type="xs:NCName">
      <xs:annotation><xs:documentation>Name of a timeline marker; the track starts at that marker's time plus start. For a track inside an output, a marker outside the rendered span is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipIn" type="audioSecondsType" default="0">
      <xs:annotation><xs:documentation>Time in seconds into the source at which playback starts; defaults to 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="clipOut" type="audioSecondsType">
      <xs:annotation><xs:documentation>Time in seconds into the source at which playback stops; absent plays to the end of the source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="loop" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Number of extra times the clip repeats after its first play; defaults to 0. With fitToDuration the clip instead repeats until the end of the composition and loop is not used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="volume" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Linear level multiplier of the track from 0 (silent) to 1 (full); defaults to 1, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gain" type="decibelType" default="0">
      <xs:annotation><xs:documentation>Level change of the track in decibels, applied on top of volume; defaults to 0, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pan" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Stereo position from -1 (full left) to 1 (full right); values outside that range are limited to it; defaults to 0, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fadeIn" type="audioSecondsType" default="0">
      <xs:annotation><xs:documentation>Length in seconds of the fade-in at the start of the track; defaults to 0, no fade.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fadeOut" type="audioSecondsType" default="0">
      <xs:annotation><xs:documentation>Length in seconds of the fade-out at the end of the track; defaults to 0, no fade.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fadeCurve" default="linear">
      <xs:annotation><xs:documentation>Shape of the fades: linear (default), equal-power, logarithmic, exponential or s-curve.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="equal-power"/>
        <xs:enumeration value="logarithmic"/><xs:enumeration value="exponential"/>
        <xs:enumeration value="s-curve"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Playback speed multiplier of the track, where 1 is normal; 2 plays twice as fast; defaults to 1. Only the magnitude is used (use reverse to play backwards), with a floor of 0.001.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="preservePitch" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether a speed change keeps the original pitch (true, default) or changes it with the speed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reverse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the clip plays backwards; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mute" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the track is silenced; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="role" type="audioRoleType" default="other">
      <xs:annotation><xs:documentation>What the track carries (dialogue, voiceover, music, effects, ambience, audio-description or other), which outputs can use to select tracks; defaults to other.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType"/>
    <xs:attribute name="bus" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the bus the track is routed to; absent routes it straight to the master.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fitToDuration" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Music edit: loop/trim the asset at bar boundaries (asset @bpm) so it ends exactly at the project end.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="duckingAttributes"/>
  </xs:complexType>
  <xs:complexType name="busType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Identifier of the bus; tracks and other buses name it as their destination, and ducking and sidechains can use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="volume" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Linear level multiplier of the bus from 0 to 1; defaults to 1, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gain" type="decibelType" default="0">
      <xs:annotation><xs:documentation>Level change of the bus in decibels, applied on top of volume; defaults to 0, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pan" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Stereo position of the bus from -1 (full left) to 1 (full right), limited to that range; defaults to 0, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="output" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the bus this bus feeds; absent sends it to the master.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mute" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the bus is silenced; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="duckingAttributes"/>
  </xs:complexType>
  <xs:complexType name="masterType">
    <xs:annotation><xs:documentation>
      Master bus. normalize="integrated" measures ITU-R BS.1770 integrated
      loudness of the full mix and applies static gain to reach @loudness LUFS,
      then the true-peak limiter caps at @truePeak dBTP.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="volume" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Linear level multiplier of the whole mix from 0 to 1, applied after the master effects; defaults to 1, and it can be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalize" default="none">
      <xs:annotation><xs:documentation>Loudness normalisation of the mix: none (default), integrated for one static gain reaching the target loudness, or dynamic for slowly riding gain that follows short-term loudness.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="integrated"/><xs:enumeration value="dynamic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="loudness" type="lufsType" default="-14">
      <xs:annotation><xs:documentation>Target loudness in LUFS for integrated or dynamic normalisation; defaults to -14.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="truePeak" type="decibelType" default="-1">
      <xs:annotation><xs:documentation>Ceiling in dBTP of the true-peak limiter, which runs only when limiter is true or normalize is not none; defaults to -1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="limiter" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether the true-peak limiter runs even without normalisation; it always runs when normalisation is on; defaults to false.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dither" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether TPDF dither is added when the mix is written directly as a 16- or 24-bit audio-only WAV file; defaults to true. Other outputs do not use it.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="audioMixType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="audioTrack" type="audioTrackType"/>
      <xs:element name="bus" type="busType"/>
      <xs:element name="master" type="masterType"/>
    </xs:choice>
    <xs:attribute name="sampleRate" type="xs:positiveInteger" default="48000">
      <xs:annotation><xs:documentation>Sample rate of the mixed audio in hertz; 48000 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="channels" type="xs:positiveInteger" default="2">
      <xs:annotation><xs:documentation>Channel count of the mix, used when channelLayout is auto (1 mono, 6 as 5.1, 8 as 7.1, 12 as 7.1.4, 16 as third-order ambisonic, anything else stereo).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="channelLayout" default="auto">
      <xs:annotation><xs:documentation>Speaker layout of the mix: mono, stereo, 5.1, 7.1, 7.1.4 or first/third-order ambisonic; auto derives it from channels.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="auto"/><xs:enumeration value="mono"/><xs:enumeration value="stereo"/>
        <xs:enumeration value="5.1"/><xs:enumeration value="7.1"/><xs:enumeration value="7.1.4"/>
        <xs:enumeration value="ambisonic-1"/><xs:enumeration value="ambisonic-3"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bitDepth" default="24">
      <xs:annotation><xs:documentation>Bit depth of PCM audio-only exports: 16, 24 or 32 (32-bit float); 24 when absent. Video outputs and mp3 or m4a files do not use it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger">
        <xs:enumeration value="16"/><xs:enumeration value="24"/><xs:enumeration value="32"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== captions -->
  <xs:complexType name="wordType">
    <xs:attribute name="start" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds at which the word begins to be spoken; the caption presets use it to time the per-word effect.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds at which the word stops being spoken.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string" use="required">
      <xs:annotation><xs:documentation>The word's text; a cue without its own text is built by joining its words with spaces.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emphasis" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="cueType">
    <xs:sequence><xs:element name="word" type="wordType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="start" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds at which the cue appears; cues are sorted by start before paging.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Time in seconds at which the cue disappears.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation><xs:documentation>The caption text, written to sidecar files and burned in when the cue has no word children (otherwise the words are drawn); when absent it is built from the words joined with spaces.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speaker" type="xs:string">
      <xs:annotation><xs:documentation>Name of the speaker; written as a voice tag in WebVTT sidecar files.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a textStyle that styles this cue, overriding the caption track's style.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="position" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="captionTrackType">
    <xs:annotation><xs:documentation>
      Captions from inline cues, a subtitle file (@src), or a transcription of
      audio track @transcribe. Transcriptions are read from @cache (verified by
      @cacheSha256) so renders stay deterministic; a resolve step, run before rendering, writes
      the cache from the track as it plays in the mix, in composition time. mode=burn draws them into the
      picture using @preset and @style; sidecar writes a file next to each output.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="cue" type="cueType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the track; outputs name it in burnCaptions or captions, and it appears in the sidecar file name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType" use="required">
      <xs:annotation><xs:documentation>Language tag of the track; becomes part of the sidecar file name (stem.track.language.vtt or .srt).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="kind" default="captions">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="captions"/><xs:enumeration value="subtitles"/>
        <xs:enumeration value="sdh"/><xs:enumeration value="forced"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of a local subtitle file that supplies the track's cues; remote URLs are rejected. A track takes exactly one source: cue children, src or transcribe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format">
      <xs:annotation><xs:documentation>Subtitle format of src; when absent it is taken from the file extension (srt if there is none). The sidecar file is SRT only when this is explicitly srt, otherwise WebVTT.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="srt"/><xs:enumeration value="vtt"/><xs:enumeration value="ass"/>
        <xs:enumeration value="ttml"/><xs:enumeration value="itt"/><xs:enumeration value="scc"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="readingSpeed" type="positiveDecimal">
      <xs:annotation><xs:documentation>
        Characters per second this track may reach; overrides accessibility/@readingSpeed.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transcribe" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the audio track whose speech the cues are transcribed from, read from cache; exactly one of cue children, src and transcribe is allowed. Inside an output it names one of that output's own tracks.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of the local transcription file that supplies the cues of a transcribed track; required with transcribe.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cacheSha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 of the transcription cache, which a transcribed track must declare so renders stay deterministic; the resolve step rewrites it when the cache changes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="provider" type="xs:string" default="whisper">
      <xs:annotation><xs:documentation>
        The transcriber the resolve step runs to fill @cache: whisper (the Whisper speech
        recognition models), or the name of any provider program. Rendering only reads the cache.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="model" type="xs:string" default="base">
      <xs:annotation><xs:documentation>The transcriber's model (whisper: tiny, base, small, medium, large-v3, with .en for English-only; or a model file).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt" type="xs:string">
      <xs:annotation><xs:documentation>Text that primes the transcriber (names, spellings, vocabulary).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineBreaks" default="greedy">
      <xs:annotation><xs:documentation>greedy treats source newlines as spaces (legacy). source ends a line at each
      cue newline; maxCharsPerLine, maxWordsPerLine and maxLines still apply. Blank source lines do not add empty caption
      rows; one-word still pages each word.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="greedy"/><xs:enumeration value="source"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mode" default="burn">
      <xs:annotation><xs:documentation>Where the captions go by default: burn draws them into the picture, sidecar writes a subtitle file next to each output, both does both; burn when absent. An output's captions and burnCaptions can override it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="burn"/><xs:enumeration value="sidecar"/><xs:enumeration value="both"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="preset" default="classic">
      <xs:annotation><xs:documentation>Animation style of burned captions (karaoke, pop, typewriter, boxed-line and others); none draws plain text, and classic is used when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="classic"/><xs:enumeration value="boxed-line"/>
        <xs:enumeration value="boxed-word"/><xs:enumeration value="one-word"/>
        <xs:enumeration value="karaoke"/><xs:enumeration value="highlight"/>
        <xs:enumeration value="pop"/><xs:enumeration value="fade"/>
        <xs:enumeration value="bounce"/><xs:enumeration value="slide"/>
        <xs:enumeration value="typewriter"/><xs:enumeration value="enlarge"/>
        <xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="style" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the textStyle used to draw the track's captions; a cue's own style overrides it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="activeStyle" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a textStyle whose fill colour paints the current word; when set, activeColor is not used, and a style with no fill leaves the word in the track's own colour.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="activeColor" type="paintType">
      <xs:annotation><xs:documentation>Colour that lights the current word in the word presets (karaoke keeps already-spoken words lit; boxed-word paints its box); golden yellow (#FFD400) when absent. Not used when activeStyle is set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxWordsPerLine" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Maximum number of words on one caption line; unlimited when absent. The one-word preset does not use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxCharsPerLine" type="xs:positiveInteger" default="32">
      <xs:annotation><xs:documentation>Maximum characters on one caption line before it wraps; 32 when absent. The one-word preset does not use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxLines" type="xs:positiveInteger" default="2">
      <xs:annotation><xs:documentation>Maximum number of lines shown at once; a cue that needs more is split into successive pages. 2 when absent. The one-word preset does not use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="lengthType" default="50%">
      <xs:annotation><xs:documentation>Horizontal centre of the caption block, as a length (pixels, percent of frame width, vw or vh); 50% when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="lengthType" default="75%">
      <xs:annotation><xs:documentation>Vertical position of the caption block's top edge, as a length (percent is of frame height); 75% when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveLengthType" default="85%">
      <xs:annotation><xs:documentation>Width of the caption block as a length (percent of frame width); 85% when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="safeArea" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the safeArea this track's burned captions are checked against; otherwise the safe area in force for the render applies (the selected layout's, else the project's).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:int" default="1000000"/>
    <xs:attribute name="profanityFilter" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, common profanity in the cues is masked after its first letter with asterisks; false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="captionsType">
    <xs:sequence><xs:element name="captionTrack" type="captionTrackType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== markers -->
  <xs:complexType name="markerType">
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Name by which keys and outputs refer to the marker's time (startMarker, endMarker, marker); unnamed markers cannot be referenced.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="time" type="xs:double" use="required">
      <xs:annotation><xs:documentation>Position of the marker on the composition timeline, in seconds.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="kind" default="cue">
      <xs:annotation><xs:documentation>Marker type; markers of kind chapter become chapters in an output with segments when its container holds them (mp4, mov, mkv, webm or m4a). The other kinds are annotations only.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="cue"/><xs:enumeration value="chapter"/><xs:enumeration value="section"/>
        <xs:enumeration value="beat"/><xs:enumeration value="comment"/><xs:enumeration value="todo"/>
        <xs:enumeration value="cta"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation><xs:documentation>Display text; for a chapter marker it is the chapter title, falling back to the marker id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType"/>
  </xs:complexType>
  <xs:complexType name="beatGridType">
    <xs:annotation><xs:documentation>Musical grid for cutting on the beat; expressions read beat() and keys can snap with @marker to generated ids beat.N and bar.N.</xs:documentation></xs:annotation>
    <xs:attribute name="bpm" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Tempo in beats per minute; beat.N markers fall at offset + N times 60/bpm seconds, and beat() follows the same grid unless the grid's source supplies detected beats.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds of beat 0 (and bar 0); 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="beatsPerBar" type="xs:positiveInteger" default="4">
      <xs:annotation><xs:documentation>Number of beats in a bar, which spaces the generated bar.N markers; 4 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the audio track whose detected beats drive the beat() expression instead of the fixed bpm grid (bpm is used as the tempo hint).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="markersType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="marker" type="markerType"/>
      <xs:element name="beatGrid" type="beatGridType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== parameters and variants -->
  <xs:complexType name="paramType">
    <xs:annotation><xs:documentation>
      Template input. Values reach the document through {{id}} in text,
      param('id') in expressions and conditions, bind elements, and
      link source="param:id". Values come from @default, a variant, a data row
      or the command line (--param id=value).
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name of the template parameter, used in {{id}}, param('id') and by bind, set and --param.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation><xs:documentation>Kind of value the parameter holds (string, number, boolean, color, asset, enum, list, time); supplied values are parsed and checked against it. A time may be seconds or a timecode.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="string"/><xs:enumeration value="number"/><xs:enumeration value="boolean"/>
        <xs:enumeration value="color"/><xs:enumeration value="asset"/><xs:enumeration value="enum"/>
        <xs:enumeration value="list"/><xs:enumeration value="time"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="default" type="xs:string">
      <xs:annotation><xs:documentation>Value used when no variant, data row or command-line value supplies one.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="required" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, rendering fails if no value reaches the parameter; false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:double">
      <xs:annotation><xs:documentation>Lowest accepted value of a number or time parameter; a lower value is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:double">
      <xs:annotation><xs:documentation>Highest accepted value of a number or time parameter; a higher value is an error.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxLength" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Maximum number of characters of a string or enum parameter value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pattern" type="xs:string">
      <xs:annotation><xs:documentation>Regular expression a string or enum value must match in full.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="options" type="xs:string">
      <xs:annotation><xs:documentation>Comma-separated list of the values an enum parameter accepts; any value is accepted if the list is empty.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="bindType">
    <xs:attribute name="param" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the parameter whose resolved value is written into the target.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="target" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the element that receives the parameter's value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="property" type="xs:NMTOKEN" use="required">
      <xs:annotation><xs:documentation>Name of the target element's attribute that is set to the parameter's value.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="map" type="xs:string">
      <xs:annotation><xs:documentation>Optional value map "in1=out1;in2=out2" applied before assignment.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="dataSourceType">
    <xs:annotation><xs:documentation>Rows for repeat/@over and for batch rendering (one output set per row).</xs:documentation></xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:ID" use="required">
          <xs:annotation><xs:documentation>Name of the data source; its rows are exposed as a parameter of the same name (for repeat/@over) and batch rendering selects a source by it.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="src" type="xs:anyURI">
          <xs:annotation><xs:documentation>Path of a local file holding the rows; when absent the rows are the element's own text. Remote URLs are not fetched.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="format" default="json">
          <xs:annotation><xs:documentation>Row format: json (an array of records, or an object with a rows array), csv or tsv (first line is the header); json when absent.</xs:documentation></xs:annotation>
          <xs:simpleType><xs:restriction base="xs:string">
            <xs:enumeration value="json"/><xs:enumeration value="csv"/><xs:enumeration value="tsv"/>
          </xs:restriction></xs:simpleType>
        </xs:attribute>
        <xs:attribute name="sha256" type="sha256Type">
          <xs:annotation><xs:documentation>SHA-256 of the file named by src; a mismatch is an error (A02).</xs:documentation></xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="setType">
    <xs:attribute name="param" type="xs:IDREF" use="required">
      <xs:annotation><xs:documentation>Id of the parameter whose value the variant sets.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Value the variant gives the parameter, overriding its default.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="variantType">
    <xs:annotation><xs:documentation>A named parameter set (A/B test cell, language, market).</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="set" type="setType"/>
      <xs:element name="override" type="overrideType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which a render selects the variant, applying its set and override children.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="parametersType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="param" type="paramType"/>
      <xs:element name="bind" type="bindType"/>
      <xs:element name="data" type="dataSourceType"/>
      <xs:element name="variant" type="variantType"/>
      <xs:element name="program" type="programDataType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== layouts and safe areas -->
  <xs:complexType name="safeAreaType">
    <xs:annotation><xs:documentation>
      Regions the platform UI covers. Presets carry the renderer's maintained
      insets for that placement; explicit top/right/bottom/left (fractions of
      the frame) override them. enforce=warn|error checks that text, captions
      and nodes tagged "cta" or "logo" stay inside the safe region.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which the project, a layout or a caption track refers to the safe area.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="preset" default="custom">
      <xs:annotation><xs:documentation>Starting insets for a platform or broadcast placement (title-safe, action-safe, a social-video preset); explicit top, right, bottom and left override them. custom (default) has none and needs all four.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="custom"/><xs:enumeration value="title-safe"/><xs:enumeration value="action-safe"/>
        <xs:enumeration value="instagram-reels"/><xs:enumeration value="instagram-stories"/>
        <xs:enumeration value="instagram-feed"/><xs:enumeration value="facebook-reels"/>
        <xs:enumeration value="tiktok"/><xs:enumeration value="youtube-shorts"/>
        <xs:enumeration value="snapchat"/><xs:enumeration value="pinterest-idea"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="top" type="unitDecimal">
      <xs:annotation><xs:documentation>Inset of the safe region from the top edge, as a fraction of the frame height; overrides the preset's value. Required when preset is custom or absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="right" type="unitDecimal">
      <xs:annotation><xs:documentation>Inset of the safe region from the right edge, as a fraction of the frame width; overrides the preset's value. Required when preset is custom or absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom" type="unitDecimal">
      <xs:annotation><xs:documentation>Inset of the safe region from the bottom edge, as a fraction of the frame height; overrides the preset's value. Required when preset is custom or absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="left" type="unitDecimal">
      <xs:annotation><xs:documentation>Inset of the safe region from the left edge, as a fraction of the frame width; overrides the preset's value. Required when preset is custom or absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="enforce" default="warn">
      <xs:annotation><xs:documentation>What happens when text, burned captions or nodes tagged cta or logo cross the safe region: off ignores it, warn reports a finding, error fails the run. warn when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="safeAreasType">
    <xs:sequence><xs:element name="safeArea" type="safeAreaType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="layoutType">
    <xs:annotation><xs:documentation>
      An alternative frame (e.g. 9:16, 4:5, 1:1, 16:9). Relative lengths and
      align* attributes reflow automatically; override children handle the rest.
      An output selects it with @layout.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="override" type="overrideType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which an output or render option selects the layout.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels of the layout's frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels of the layout's frame.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="aspect" type="aspectType"/>
    <xs:attribute name="safeArea" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the safeArea that applies when this layout is selected, in place of the project's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="reframe" default="reflow">
      <xs:annotation><xs:documentation>How the composition fills the layout frame: reflow re-lays it out at that size; crop, fit and fit-blur render it at the project size, then crop it, fit it centred, or fit it over a blurred copy. reflow when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="reflow"/><xs:enumeration value="crop"/><xs:enumeration value="fit"/>
        <xs:enumeration value="fit-blur"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="focusX" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Horizontal anchor (0 left to 1 right) of the crop or fit-blur reframe; 0.5 when absent. A segment's own focusX replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusY" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Vertical anchor (0 top to 1 bottom) of the crop or fit-blur reframe; 0.5 when absent. A segment's own focusY replaces it.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="layoutsType">
    <xs:sequence><xs:element name="layout" type="layoutType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== colour management -->
  <xs:complexType name="lookType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which colorManagement/@looks lists the look; with an OpenColorIO config, a look with no LUT or CDL values names a look of that config by this id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of a local LUT file applied as the look; remote files are not supported. When absent the look is built from slope, offset, power and saturation.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="space" type="colorSpaceType" default="acescct">
      <xs:annotation><xs:documentation>Colour space in which the LUT file is applied; acescct when absent. Used only for LUT looks.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="slope" type="xs:string">
      <xs:annotation><xs:documentation>ASC CDL slope: one number applied to all channels, or red, green and blue separated by commas or spaces; 1 when absent. Used only when the look has no LUT (src).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:string">
      <xs:annotation><xs:documentation>ASC CDL offset: one number for all channels, or red, green and blue separated by commas or spaces; 0 when absent. Used only when the look has no LUT (src).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="power" type="xs:string">
      <xs:annotation><xs:documentation>ASC CDL power (gamma): one number for all channels, or red, green and blue separated by commas or spaces; 1 when absent. Used only when the look has no LUT (src).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="saturation" type="xs:double" default="1">
      <xs:annotation><xs:documentation>ASC CDL saturation multiplier; 1 leaves colour unchanged. Used only when the look has no LUT.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mix" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Strength of the look from 0 (frame unchanged) to 1 (full look); 1 when absent. Not applied to a look that names a look of an OpenColorIO config.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="colorManagementType">
    <xs:annotation><xs:documentation>
      Scene-referred pipeline: inputs decode by asset colorSpace+transfer into
      @workingSpace, @looks (LUTs or ASC CDL) apply in order, then the
      display/view transform and tone mapping produce each output's colorSpace
      and transfer. @ocioConfig delegates all of this to an OpenColorIO v2
      config, where @workingSpace, @display, @view and look ids name OCIO objects.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="look" type="lookType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="ocioConfig" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of a local OpenColorIO configuration, or an ocio:// built-in one, whose display and view transform replaces the built-in tone mapper; a failure falls back to the built-in pipeline.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="workingSpace" type="colorSpaceType" default="linear-srgb">
      <xs:annotation><xs:documentation>Colour space in which the frame is composited; takes precedence over project/@workingColorSpace when this element exists. linear-srgb when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="looks" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the look children applied in order to the finished frame, before exposure and tone mapping; a look that names a look of an OpenColorIO config is applied with the display transform, after exposure.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="display" type="xs:string" default="srgb">
      <xs:annotation><xs:documentation>Name of the OpenColorIO display used for the final transform; srgb when absent. Read only with ocioConfig.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="view" type="xs:string" default="standard">
      <xs:annotation><xs:documentation>Name of the OpenColorIO view used for the final transform; standard when absent. Read only with ocioConfig.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toneMapping" default="none">
      <xs:annotation><xs:documentation>Operator that compresses bright values for display: aces, aces2 (the same curve as aces), agx, filmic or reinhard; none by default. Not applied when an OpenColorIO config was applied.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="aces"/><xs:enumeration value="aces2"/>
        <xs:enumeration value="agx"/><xs:enumeration value="filmic"/><xs:enumeration value="reinhard"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="exposure" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Exposure adjustment in stops (each +1 doubles the light), applied after the looks; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitDepth" default="16f">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="8"/><xs:enumeration value="16"/><xs:enumeration value="16f"/><xs:enumeration value="32f"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== metadata and accessibility -->
  <xs:complexType name="metaType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="accessibilityType">
    <xs:annotation><xs:documentation>
      flashCheck runs a photosensitive-seizure analysis (general and red flashes
      above 3 per second over the ITU-R BT.1702 / WCAG 2.3.1 area threshold).
      contrastCheck verifies burned-in text and captions against their
      background at @minContrast.
    </xs:documentation></xs:annotation>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="audioDescription" type="xs:IDREF"/>
    <xs:attribute name="requireCaptions" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, delivering an output that has no caption track at all fails; false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="flashCheck" default="warn">
      <xs:annotation><xs:documentation>Photosensitive-seizure flash analysis of rendered frames: off, warn (report) or error (fail). The check runs only when an accessibility element exists; the schema default is warn.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="contrastCheck" default="off">
      <xs:annotation><xs:documentation>Checks burned-in text and captions against their background at minContrast: off (default), warn or error.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="minContrast" type="positiveDecimal" default="4.5">
      <xs:annotation><xs:documentation>Lowest contrast ratio (such as 4.5 for 4.5:1) text may have against its background before contrastCheck reports it; 4.5 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="legibilityCheck" default="off">
      <xs:annotation><xs:documentation>Checks caption and text display time, plus reading speed and drawn size when readingSpeed and minTextSize are set: off (default), warn or error.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="readingSpeed" type="positiveDecimal">
      <xs:annotation><xs:documentation>Fastest acceptable reading speed in characters per second for captions and text; a caption track's own readingSpeed overrides it and applies even when this is absent. No speed check without either.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minDisplayTime" type="nonNegativeDecimal" default="0.8333">
      <xs:annotation><xs:documentation>Shortest time in seconds a caption or text should stay visible, checked when legibilityCheck is warn or error; 0.8333 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minTextSize" type="lengthType">
      <xs:annotation><xs:documentation>Smallest acceptable drawn size of text layers (captions are not measured), as a length resolved against the output frame; a percentage is of its height. No size check when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="metadataType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="meta" type="metaType"/>
      <xs:element name="accessibility" type="accessibilityType"/>
    </xs:choice>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation><xs:documentation>Title of the work, written into the output file's metadata when the output's embedMetadata is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="author" type="xs:string">
      <xs:annotation><xs:documentation>Author of the work, written as the artist tag of the output file when embedMetadata is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="description" type="xs:string">
      <xs:annotation><xs:documentation>Description of the work, written as the comment tag of the output file when embedMetadata is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="keywords" type="xs:string">
      <xs:annotation><xs:documentation>Keywords of the work, written to the output file's metadata when embedMetadata is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="copyright" type="xs:string">
      <xs:annotation><xs:documentation>Copyright notice, written to the output file's metadata when embedMetadata is on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="revision" type="xs:string"/>
    <xs:attribute name="created" type="xs:dateTime"/>
    <xs:attribute name="modified" type="xs:dateTime"/>
    <xs:attribute name="generator" type="xs:string"/>
    <xs:attribute name="language" type="languageTagType"/>
  </xs:complexType>

  <!-- ===================================================== 360 -->
  <xs:complexType name="scene360Type">
    <xs:attribute name="layout" default="equirectangular">
      <xs:annotation><xs:documentation>Projection of the 360 frame: equirectangular, cubemap, eac (equi-angular cubemap) or fisheye-180; equirectangular when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="equirectangular"/><xs:enumeration value="cubemap"/>
        <xs:enumeration value="eac"/><xs:enumeration value="fisheye-180"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" default="3840">
      <xs:annotation><xs:documentation>Width in pixels of the 360 frame (clamped to 16-16384); 3840 when absent. Outputs without their own size render at it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" default="1920">
      <xs:annotation><xs:documentation>Height in pixels of the 360 frame (clamped to 16-16384); 1920 when absent. Outputs without their own size render at it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="viewportCamera" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the camera the 360 view is rendered from; the scene's current camera is used when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stereo" default="mono">
      <xs:annotation><xs:documentation>Stereoscopic packing: mono renders one view, top-bottom or left-right stacks left and right eye views into the frame. mono when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="mono"/><xs:enumeration value="top-bottom"/><xs:enumeration value="left-right"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="interpupillary" type="positiveDecimal" default="0.064">
      <xs:annotation><xs:documentation>Distance between the two eyes of a stereo frame; multiplied by 100 to give the eye separation in scene units. 0.064 when absent; unused for mono.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== project -->
  <xs:complexType name="projectType">
    <xs:attribute name="width" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Width in pixels of the composition frame; an output is delivered at it unless the output gives its own width, selects a layout, or the document has a scene360.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger" use="required">
      <xs:annotation><xs:documentation>Height in pixels of the composition frame; an output is delivered at it unless the output gives its own height, selects a layout, or the document has a scene360.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType" use="required">
      <xs:annotation><xs:documentation>Frame rate in frames per second, an integer or a fraction such as 30000/1001.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="durationType" use="required">
      <xs:annotation><xs:documentation>Length of the composition in seconds; content outside 0 to duration is never drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Document-wide seed for procedural randomness; random elements without their own seed derive theirs from it, so renders are reproducible. 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="linearLight" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Default blending space: when true, nodes composite on linear-light values, when false on encoded values; a node's edgeBlend can override it. true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="workingColorSpace" type="colorSpaceType" default="srgb">
      <xs:annotation><xs:documentation>Colour space in which the frame is composited; srgb when absent. Any colorManagement element replaces it with its own workingSpace (linear-srgb by default).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background" type="paintType" default="#000000FF">
      <xs:annotation><xs:documentation>Paint drawn behind the whole composition; opaque black when absent. A visible gradient-sky dome light replaces it when no 3D node is drawn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" default="standard">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="standard"/><xs:enumeration value="equirectangular"/>
        <xs:enumeration value="viewport"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="antialias3d" default="1">
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="precision" default="f16">
      <xs:annotation><xs:documentation>Working textures (offscreens, effect passes, persistent buffers, the frame): f16 or f32 per channel. SREP 72.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="f16"/><xs:enumeration value="f32"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="supersample" default="1">
      <xs:annotation><xs:documentation>n > 1 renders the frame at n x width by n x height, every length scaled by n, and filters
      it down with supersampleFilter: output pixel i is the weighted mean of the samples, sample k centred at (k + 0.5)/n
      output pixels, the weights renormalised at the frame's edges, in the working space before output encoding, and
      clamped to [0, max(1, M)], M the largest sample of non-zero weight. SREPs 72 and 89.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="supersampleFilter" default="box">
      <xs:annotation><xs:documentation>box: the mean of the n x n samples inside the pixel; lanczos3: the separable kernel
      sinc(x) sinc(x/3) for |x| &lt; 3 output pixels. Read only when supersample > 1. SREP 72.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="box"/><xs:enumeration value="lanczos3"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Whether nodes are motion-blurred by default; a node's own motionBlur on/off, or its nearest ancestor's, overrides it. false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="shutterAngle" default="180">
      <xs:annotation><xs:documentation>Shutter opening in degrees of the frame interval (180 exposes half a frame; 0 disables blur); a node's own shutterAngle overrides it. 180 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="0"/><xs:maxInclusive value="720"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shutterPhase" type="xs:double" default="-90">
      <xs:annotation><xs:documentation>Offset of the shutter opening from the frame time, in degrees of the frame interval; negative values start before the frame. -90 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlurSamples" default="16">
      <xs:annotation><xs:documentation>Number of time samples averaged for motion blur (1 to 256), further limited by the quality tier; 16 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="256"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="adaptiveMotionBlur" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true, a node that barely moves across the shutter is not blurred, which saves work; when false such a node is still sampled, except still groups and adjustment layers, which never are. true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="timecodeStart" type="timecodeType"/>
    <xs:attribute name="pixelAspect" type="positiveDecimal" default="1"/>
    <xs:attribute name="safeArea" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the safeArea checked for text, captions and nodes tagged cta or logo; the selected layout's safeArea replaces it, as does a caption track's own for that track's captions.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="quality" default="final">
      <xs:annotation><xs:documentation>Render quality tier: final as authored; preview at full size with at most 4 motion-blur samples; draft at half size with fewer samples and no grain or noise. final when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="draft"/><xs:enumeration value="preview"/><xs:enumeration value="final"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fontPolicy" default="system">
      <xs:annotation><xs:documentation>system lets text use the host's fonts; pinned restricts text to the document's own font assets, which must be pinned by hash, so layout is reproducible. system when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="system"/><xs:enumeration value="pinned"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== outputs -->
  <xs:complexType name="stillType">
    <xs:attribute name="time" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds of the frame captured as a still (composition time, or output time when the output has segments); clamped to the timeline. 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="marker" type="xs:NCName">
      <xs:annotation><xs:documentation>Id of a marker (or generated beat.N and bar.N) whose time is captured instead of time.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>File the still is written to; a relative path is resolved against the output directory, which defaults to the document's folder.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" default="jpeg">
      <xs:annotation><xs:documentation>Image format of the still: jpeg, png, webp or avif; jpeg when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="jpeg"/><xs:enumeration value="png"/><xs:enumeration value="webp"/>
        <xs:enumeration value="avif"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Width in pixels the still is scaled to, keeping the aspect ratio; the output's size when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="quality" type="unitDecimal" default="0.9">
      <xs:annotation><xs:documentation>Compression quality from 0 (smallest) to 1 (best) for jpeg, webp and avif; 0.9 when absent. Ignored for png.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="destinationType">
    <xs:annotation><xs:documentation>Post-render delivery. Credentials are never stored in the document: @credentials names an environment profile.</xs:documentation></xs:annotation>
    <xs:attribute name="kind" use="required">
      <xs:annotation><xs:documentation>How the rendered files are delivered: file (copy), s3, gcs, azure-blob, http-put, sftp, or webhook, which is notified with the resulting locations.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="file"/><xs:enumeration value="s3"/><xs:enumeration value="gcs"/>
        <xs:enumeration value="azure-blob"/><xs:enumeration value="http-put"/><xs:enumeration value="sftp"/>
        <xs:enumeration value="webhook"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="uri" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Where files go: a directory for file; an s3:// or gs:// bucket and prefix; a base URL for azure-blob and sftp; a file URL or base URL for http-put; the endpoint for webhook.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="credentials" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>Name of a credentials profile read from SR_CREDENTIALS_&lt;PROFILE&gt;_&lt;NAME&gt; environment variables; no secrets are stored in the document.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="segmentType">
    <xs:annotation><xs:documentation>
      A span of the composition played by this output: from..to (seconds) or fromMarker..toMarker at speed,
      or a timeRemap child mapping segment time (key/@time, from 0) to composition time (key/@value) for ramps,
      freezes and reversals. The output plays its segments in document order. A transition child joins this
      segment to the next one. audio says how the span's sound is fitted to its duration: stretch keeps pitch,
      resample changes pitch with speed, mute is silence. focusX and focusY (animatable in segment time, by animate
      children) replace the layout's reframing focus for crop and fit-blur.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="timeRemap" type="timeRemapType"/>
      <xs:element name="transition" type="transitionType"/>
      <xs:element name="animate" type="animateType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Name of the segment, used in messages.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="from" type="xs:double">
      <xs:annotation><xs:documentation>Composition time in seconds where the segment starts playing; used with to, or replaced by a timeRemap child.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="to" type="xs:double">
      <xs:annotation><xs:documentation>Composition time in seconds where the segment stops; must be later than from.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromMarker" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the marker where the segment starts, used when from is absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="toMarker" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the marker where the segment ends, used when to is absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Playback speed multiplier of the span (2 plays it twice as fast, in half the time); 1 when absent. Not used when the segment has a timeRemap child.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audio" default="stretch">
      <xs:annotation><xs:documentation>How the span's sound fits its duration: stretch keeps pitch, resample changes pitch with speed, mute is silent. stretch when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="stretch"/><xs:enumeration value="resample"/><xs:enumeration value="mute"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="focusX" type="unitDecimal">
      <xs:annotation><xs:documentation>Horizontal anchor (0 left to 1 right) of the crop or fit-blur reframe for this segment, replacing the layout's focus.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusY" type="unitDecimal">
      <xs:annotation><xs:documentation>Vertical anchor (0 top to 1 bottom) of the crop or fit-blur reframe for this segment, replacing the layout's focus.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="outputType">
    <xs:annotation><xs:documentation>
      Several outputs render one scene into different placements. layout picks a
      layoutVariant frame; variant picks a parameter set; start/end render a
      range. Width/height default to the layout's, else the project's.
      Sequence codecs write numbered files at @path (printf pattern).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="poster" type="stillType"/>
      <xs:element name="thumbnail" type="stillType"/>
      <xs:element name="destination" type="destinationType"/>
      <xs:element name="segment" type="segmentType"/>
      <xs:element name="audioTrack" type="audioTrackType"/>
      <xs:element name="captionTrack" type="captionTrackType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>Name by which the command line selects this output; it also fills {id} in a report path given on the command line.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioTracks" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the audioTrack elements whose sound is mixed into this output; combined with audioRoles and audioBuses as a union, and all sources play when none of the three is given. Only outputs with segments use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioRoles" type="audioRoleListType">
      <xs:annotation><xs:documentation>Roles (such as dialogue or music) of the audio tracks whose sound is mixed into this output; combined with audioTracks and audioBuses as a union. Only outputs with segments use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioBuses" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the buses whose tracks are mixed into this output; combined with audioTracks and audioRoles as a union. Only outputs with segments use it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="overlay" type="xs:IDREF">
      <xs:annotation><xs:documentation>
        A symbol drawn over the output's picture in output time (series tags, calls to action, end cards).
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="joinFade" type="nonNegativeDecimal" default="0.01">
      <xs:annotation><xs:documentation>Length in seconds of the audio crossfade centred on a join between two segments that has no transition; never longer than either segment. 0.01 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="path" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>File the output is written to; a relative path is resolved against the output directory (default the document's folder). Sequence codecs need a printf pattern such as frame_%05d.png.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="codec" use="required">
      <xs:annotation><xs:documentation>Format the output is encoded in: a video codec (h264, h265, av1, vp9, ffv1, prores, dnxhr), an animated image (gif, apng, webp), an image sequence (png-sequence, jpeg-sequence, exr-sequence, tiff-sequence) or audio-only.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="h264"/><xs:enumeration value="h265"/><xs:enumeration value="ffv1"/>
        <xs:enumeration value="av1"/><xs:enumeration value="vp9"/><xs:enumeration value="prores"/>
        <xs:enumeration value="dnxhr"/><xs:enumeration value="gif"/><xs:enumeration value="apng"/>
        <xs:enumeration value="webp"/><xs:enumeration value="png-sequence"/>
        <xs:enumeration value="jpeg-sequence"/><xs:enumeration value="exr-sequence"/>
        <xs:enumeration value="tiff-sequence"/><xs:enumeration value="audio-only"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="container">
      <xs:annotation><xs:documentation>File container: mp4, mov, mkv, webm, mxf, wav, m4a or mp3; from the path's extension, else the codec's default. A container that cannot hold a video codec is rejected; wav, m4a and mp3 hold only audio-only.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="mp4"/><xs:enumeration value="mov"/><xs:enumeration value="mkv"/>
        <xs:enumeration value="webm"/><xs:enumeration value="mxf"/><xs:enumeration value="wav"/>
        <xs:enumeration value="m4a"/><xs:enumeration value="mp3"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Width in pixels of the delivered frame; defaults to the 360 frame, the layout's frame or the project's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Height in pixels of the delivered frame; defaults to the 360 frame, the layout's frame or the project's.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType">
      <xs:annotation><xs:documentation>Frame rate of the output, an integer or a fraction; the project's frame rate when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="layout" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the layout whose frame and reframing this output uses.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="variant" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the parameter variant applied when rendering this output.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds where the rendered range begins; 0 when absent. An output with segments cannot set a non-zero start; the range goes in a segment instead.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds where the rendered range ends; the end of the timeline when absent. Must be greater than start, and not allowed on an output with segments.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pixelFormat" type="xs:string" default="yuv420p">
      <xs:annotation><xs:documentation>Pixel format passed to h264, h265, av1, and to vp9 and ffv1 without alpha (yuv420p by default); for dnxhr and png/apng a 10, 12 or 16 in the name selects deep colour; other codecs choose their own.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="preset" type="xs:string" default="medium">
      <xs:annotation><xs:documentation>Encoder speed preset (such as medium or slow) used by h264, h265, av1 and vp9; medium when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="profile" type="xs:string">
      <xs:annotation><xs:documentation>Encoder profile name passed to the encoder (such as high); for dnxhr it selects the DNxHR profile, and prores uses proresProfile instead. The encoder's own choice when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="level" type="xs:string">
      <xs:annotation><xs:documentation>Encoder level passed to the encoder (such as 4.1); the encoder's own choice when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="proresProfile">
      <xs:annotation><xs:documentation>ProRes profile (proxy, lt, 422, hq, 4444, 4444xq); hq when absent, or 4444 with alpha. Read only for prores.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="proxy"/><xs:enumeration value="lt"/><xs:enumeration value="422"/>
        <xs:enumeration value="hq"/><xs:enumeration value="4444"/><xs:enumeration value="4444xq"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="crf" type="xs:nonNegativeInteger" default="18">
      <xs:annotation><xs:documentation>Constant-quality value of the lossy video encoders, lower meaning higher quality; 18 when absent. Most encoders use bitrate instead when one is set; some convert crf to their own quality scale.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bitrate" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Target video bitrate in bits per second; for most encoders it replaces the constant-quality crf. A maxFileSize overrides it with a bitrate derived from the file size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxBitrate" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Upper bitrate limit in bits per second, passed to the video encoder as its maximum rate. Not used for prores, dnxhr, ffv1 or image outputs, nor by some AV1 and hardware encoders.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bufferSize" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Rate-control buffer size in bits, passed to the video encoder as its buffer size. Not used for prores, dnxhr, ffv1 or image outputs, nor by some AV1 and hardware encoders.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="twoPass" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, encodes in two passes; the first gathers statistics for rate control, which only software h264, h265 and vp9 encoders and most av1 encoders use. A maxFileSize also forces two passes; false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyframeInterval" type="positiveDecimal" default="2">
      <xs:annotation><xs:documentation>Distance between keyframes in seconds (times the frame rate, at least 1 frame, gives the GOP length); 2 when absent. Used by h264, h265, av1 and vp9; prores, dnxhr, ffv1 and image outputs ignore it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bFrames" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Maximum consecutive B-frames; applied to h264 and h265 only, the encoder's own choice when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="faststart" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true, MP4, MOV and M4A files are written with their index at the front so playback can start before the download ends; true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the output keeps transparency; only prores, vp9, ffv1, png, exr, tiff, apng, webp and gif outputs can carry it, and any other codec is rejected. false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioCodec" type="xs:string" default="aac">
      <xs:annotation><xs:documentation>Audio codec for the audio stream (aac by default); a webm container uses opus in place of aac. An audio-only output reads it only for the m4a container.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audioBitrate" type="xs:positiveInteger" default="192000">
      <xs:annotation><xs:documentation>Bitrate of the compressed audio stream in bits per second; 192000 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="audio" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the output carries the scene's audio; with false a video file has no audio track, and an audio-only output is then an error. true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorSpace" type="colorSpaceType" default="srgb">
      <xs:annotation><xs:documentation>Colour space (primaries) the frames are converted to; srgb when absent. Exr sequences use linear-srgb in its place.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="transfer" type="transferType" default="auto">
      <xs:annotation><xs:documentation>Transfer function (gamma curve) of the encoded frames; auto picks it from the colour space. Exr sequences are always linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorRange" default="limited">
      <xs:annotation><xs:documentation>Whether encoded YUV values use the limited (studio) or full range; limited when absent. Image outputs are always full range.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="limited"/><xs:enumeration value="full"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="maxCLL" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Maximum content light level in nits written as HDR metadata by the x265 and SVT-AV1 encoders.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxFALL" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Maximum frame-average light level in nits written as HDR metadata by x265, or by SVT-AV1 only when maxCLL is also set.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="masteringDisplay" type="xs:string">
      <xs:annotation><xs:documentation>Mastering display colour volume as the x265 or SVT-AV1 encoder expects it, written as HDR metadata.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sphericalMetadata" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true, MP4 and MOV outputs of a scene360 scene get spherical-video metadata so players treat them as 360; true when absent. Written for equirectangular and cubemap layouts only.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="captions" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of caption tracks written as sidecar subtitle files next to this output, in addition to every track whose mode is not burn.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="burnCaptions" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the one caption track burned into this output's picture; without it, every track whose mode is not sidecar is burned.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="loopCount" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>GIF/APNG/WebP loop count; 0 = infinite.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxFileSize" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Bytes; the encoder picks a bitrate that fits (platform upload limits).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="embedMetadata" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When true, the metadata element's title, author, description, copyright and keywords are written into the file; true when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="representation" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>Preferred asset representation name for this output (e.g. "proxy" for drafts).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="report" type="xs:anyURI">
      <xs:annotation><xs:documentation>
        Where to write this output's render report (scene-render-report/1), relative to the document.
      </xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== root -->
  <xs:element name="scene">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="project" type="projectType"/>
        <xs:element name="metadata" type="metadataType" minOccurs="0"/>
        <xs:element name="parameters" type="parametersType" minOccurs="0"/>
        <xs:element name="styles" type="stylesType" minOccurs="0"/>
        <xs:element name="colorManagement" type="colorManagementType" minOccurs="0"/>
        <xs:element name="output" type="outputType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="layouts" type="layoutsType" minOccurs="0"/>
        <xs:element name="safeAreas" type="safeAreasType" minOccurs="0"/>
        <xs:element name="assets" type="assetsType" minOccurs="0"/>
        <xs:element name="paints" type="paintsType" minOccurs="0"/>
        <xs:element name="materials" type="materialsType" minOccurs="0"/>
        <xs:element name="symbols" type="symbolsType" minOccurs="0"/>
        <xs:element name="scene360" type="scene360Type" minOccurs="0"/>
        <xs:element name="markers" type="markersType" minOccurs="0"/>
        <xs:element name="tracking" type="trackingType" minOccurs="0"/>
        <xs:element name="composition" type="compositionType"/>
        <xs:element name="lights" type="lightsType" minOccurs="0"/>
        <xs:element name="effects" type="effectsType" minOccurs="0"/>
        <xs:element name="physics" type="physicsType" minOccurs="0"/>
        <xs:element name="audioMix" type="audioMixType" minOccurs="0"/>
        <xs:element name="captions" type="captionsType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version" use="required">
        <xs:annotation><xs:documentation>Schema version the document is written against (1.0 to 1.7); some constructs introduced later, such as programs and viewport3D (1.6), are rejected when the declared version is older.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="1.0"/><xs:enumeration value="1.1"/><xs:enumeration value="1.2"/><xs:enumeration value="1.3"/><xs:enumeration value="1.4"/><xs:enumeration value="1.5"/><xs:enumeration value="1.6"/><xs:enumeration value="1.7"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- ===================================================== volumetric and large-scale cinematic effects (SREP 40, scene version 1.3) -->
  <xs:simpleType name="volumeChannelType">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_.\-]{1,64}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="volumeSequencePatternType">
    <xs:restriction base="xs:string"><xs:pattern value=".*(%[0-9]*d|#+).*"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="volumeSourceType"><xs:union memberTypes="xs:anyURI volumeSequencePatternType"/></xs:simpleType>
  <xs:simpleType name="volumeFrameIndexType"><xs:restriction base="xs:integer"><xs:minInclusive value="-2147483648"/><xs:maxInclusive value="2147483647"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="volumeMissingFrameType"><xs:restriction base="xs:string"><xs:enumeration value="error"/><xs:enumeration value="hold"/><xs:enumeration value="transparent"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="volumeInterpolationType">
    <xs:annotation><xs:documentation>Version 1.3. Hold freezes a frame; linear blends scalar fields in asset-world coordinates. Advect requires all three velocityGrid components (VOL9): signed asset-world vectors in scene units/second, with matching component transforms per frame. Frozen endpoint midpoint traces precede density/kelvin blending. Numbered caches use object-local seconds; SRVSEQ uses composition seconds. Clamped or identical held endpoints freeze. Grid transforms locate samples without transforming velocity vectors. Assets and their channel references are immutable during rendering; channel names identify owned cache fields, not paths.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:enumeration value="hold"/><xs:enumeration value="linear"/><xs:enumeration value="advect"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="meshSequenceInterpolationType"><xs:restriction base="xs:string"><xs:enumeration value="hold"/><xs:enumeration value="linear"/></xs:restriction></xs:simpleType>
  <xs:attributeGroup name="pyroShape">
    <xs:attribute name="shape" default="sphere">
      <xs:annotation><xs:documentation>Region a smoke source or impulse covers: a sphere (default), a box (width, height and depth required), or a mesh asset named by mesh. Not allowed with crater.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="sphere"/><xs:enumeration value="box"/><xs:enumeration value="mesh"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Radius of a sphere shape, in the smoke volume's own units, before scaleX, scaleY and scaleZ are applied; 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal">
      <xs:annotation><xs:documentation>Extent of a box shape along its own x axis, before rotation and scaling, centred on the shape's position; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal">
      <xs:annotation><xs:documentation>Extent of a box shape along its own y axis, before rotation and scaling, centred on the shape's position; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="positiveDecimal">
      <xs:annotation><xs:documentation>Extent of a box shape along its own z axis, before rotation and scaling, centred on the shape's position; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the shape's origin (the centre of a sphere or box) along the volume's x axis, in the volume's own units; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the shape's origin (the centre of a sphere or box) along the volume's y axis, in the volume's own units; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the shape's origin (the centre of a sphere or box) along the volume's z axis, in the volume's own units; 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the shape about the volume's z axis, in degrees; 0 when absent. Applied after the x and y rotations, about the shape's own origin. Not allowed together with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the shape about the volume's x axis, in degrees; 0 when absent. Applied first, before the y and z rotations. Not allowed together with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the shape about the volume's y axis, in degrees; 0 when absent. Applied after the x rotation and before the z rotation. Not allowed together with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the shape along its own x axis, applied before rotation; 1 when absent. Must not be 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the shape along its own y axis, applied before rotation; 1 when absent. Must not be 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleZ" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the shape along its own z axis, applied before rotation; 1 when absent. Must not be 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mesh" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the mesh asset used as the shape; required when shape is mesh and not allowed otherwise.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:attributeGroup name="pyroCrater">
    <xs:annotation><xs:documentation>
      A source or impulse that the impact of a crater causes. `crater` names a crater that grows from an impact
      (`crater@source`); the smoke is derived from that impact and nothing is authored about when, where or how much:
      the source is a sphere of the crater's radius at the impact point, active from the impact over the crater's
      formation time (an impulse: at the impact), so shape, position, timing, density, temperature and expansion are
      not given. The dust is `dustFraction` of the volume thrown out of the crater, injected as a volume fraction of
      solids, spread over the cells the sphere covers that are not solid (so `medium@extinction` is extinction per unit volume fraction in these sources). The heat is
      `heatFraction` of (1/2) m U^2 sin(theta)^(3/2) for the body's mass m, speed U and angle theta from the surface;
      it warms the dust by heat / (dust mass x `specificHeat`, J/(kg K)), at most `maxTemperature` kelvin, and the
      expansion follows from the heating as an ideal gas at constant pressure. The literature gives no value for the
      share of the energy that goes into a plume: the defaults are the engine's, with no published value. A body
      that arrives slowly, in physical units, heats its dust very little. All quantities are in SI through
      `physics/@pixelsPerMeter`. `velocityX`, `velocityY` and `velocityZ` of an impulse and `velocityRateX`, `velocityRateY`
      and `velocityRateZ` of a source stay authorable with `crater`: the push is added to the cloud of the impact (in the
      volume's axes) and is not derived from it.
    </xs:documentation></xs:annotation>
    <xs:attribute name="crater" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a crater whose impact causes this source or impulse; the smoke then comes from the impact, so the shape, timing, density, temperature and expansion attributes are not used. Velocity attributes still apply.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="heatFraction">
      <xs:annotation><xs:documentation>Share (0 to 1) of the impact's shock energy that heats the dust; 0.1 when absent. Only allowed with crater.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="nonNegativeDecimal"><xs:maxInclusive value="1"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="dustFraction">
      <xs:annotation><xs:documentation>Share (above 0, at most 1) of the crater's ejected volume that becomes dust in the smoke; 0.01 when absent. Only allowed with crater.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="positiveDecimal"><xs:maxInclusive value="1"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="specificHeat" type="positiveDecimal">
      <xs:annotation><xs:documentation>Specific heat of the dust in joules per kilogram kelvin, which sets how far the impact heat warms it; 1000 when absent. Only allowed with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxTemperature">
      <xs:annotation><xs:documentation>Highest temperature rise of the dust in kelvin; 5000 when absent. Only allowed with crater.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="positiveDecimal"><xs:maxInclusive value="50000"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="volumeAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which an object3D's volume attribute refers to this volume.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="volumeSourceType" use="required">
      <xs:annotation><xs:documentation>Path of a local volume cache file (or of the manifest for srvseq), or a numbered pattern (such as frame_%04d.srvol or frame_####.srvol) for a sequence, which also needs first and last.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 of the cache file, or of the manifest of an srvseq bake (required there); a mismatch is an error. Not allowed on a numbered sequence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" default="srvol">
      <xs:annotation><xs:documentation>File format of the cache: srvol or openvdb (each a single file or a numbered sequence), or srvseq (a baked sequence with a manifest); srvol when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="srvol"/><xs:enumeration value="srvseq"/><xs:enumeration value="openvdb"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="densityGrid" type="volumeChannelType" default="density">
      <xs:annotation><xs:documentation>Name of the cache channel read as density; density when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperatureGrid" type="volumeChannelType">
      <xs:annotation><xs:documentation>Name of the cache channel holding temperature in kelvin, which blackbody emission reads and which a medium with blackbody requires; the channel must exist in every frame and have no negative samples.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityGridX" type="volumeChannelType">
      <xs:annotation><xs:documentation>Name of the channel with the x component of the velocity, in the cache's own world units per second (before the object's transform), that interpolation advect follows. Required with advect, else not allowed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityGridY" type="volumeChannelType">
      <xs:annotation><xs:documentation>Name of the channel with the y component of the velocity, in the cache's own world units per second (before the object's transform), that interpolation advect follows. Required with advect, else not allowed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityGridZ" type="volumeChannelType">
      <xs:annotation><xs:documentation>Name of the channel with the z component of the velocity, in the cache's own world units per second (before the object's transform), that interpolation advect follows. Required with advect, else not allowed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="first" type="volumeFrameIndexType">
      <xs:annotation><xs:documentation>Frame number of the first file of a numbered sequence; requires last (not before first, under 1,000,000 frames after it) and a numbered src pattern. Not allowed with the srvseq format.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="last" type="volumeFrameIndexType">
      <xs:annotation><xs:documentation>Frame number of the last file of a numbered sequence; not below first, and the run holds at most 1,000,000 frames.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType">
      <xs:annotation><xs:documentation>Frame rate of the numbered sequence; the project's frame rate when absent. Only for sequences.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interpolation" type="volumeInterpolationType" default="hold">
      <xs:annotation><xs:documentation>How a time between two sequence frames is sampled: hold keeps the earlier frame, linear blends both, advect moves the fields along the velocity channels. hold when absent; a single cache file accepts only hold.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="missingFrame" type="volumeMissingFrameType" default="error">
      <xs:annotation><xs:documentation>What a missing frame file becomes: error fails the render, hold uses the nearest earlier frame (an error if none exists), transparent is an empty frame. error when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMinX" type="xs:double">
      <xs:annotation><xs:documentation>Lower x limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; all six bounds must be given together.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMinY" type="xs:double">
      <xs:annotation><xs:documentation>Lower y limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; all six bounds must be given together.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMinZ" type="xs:double">
      <xs:annotation><xs:documentation>Lower z limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; all six bounds must be given together.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMaxX" type="xs:double">
      <xs:annotation><xs:documentation>Upper x limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; must exceed boundsMinX.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMaxY" type="xs:double">
      <xs:annotation><xs:documentation>Upper y limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; must exceed boundsMinY.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundsMaxZ" type="xs:double">
      <xs:annotation><xs:documentation>Upper z limit of a box, in the cache's own coordinates before the object's transform, outside which the volume is not rendered; must exceed boundsMinZ.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="voxelAssetType">
    <xs:annotation><xs:documentation>
      Version 1.3 or later (VOX1). A model of cells, each with a palette index 1 to 255: either a file (`src`, `format` vox, MagicaVoxel, or srvol, the
      engine's volume cache with the indices as exact values of the grid `voxelGrid`) or a closed mesh asset cut into cells (`fromMesh` and
      `cellSize`, the cells whose centres are inside the mesh, on a lattice of multiples of the cell size, by the test that the smoke's colliders use,
      with the mesh in the frame it is drawn in: scene units, an imported asset in metres being 100 to the metre, and scene axes, so `cellSize`
      is in scene units), exactly one of the two (VOX2, VOX3). A `vox` file with a scene graph is the whole scene, the models
      placed as the graph says, unless `model` names one (its number from 0), which is then unplaced. MagicaVoxel's axes (z up) are turned into the
      scene's (y down, z forward) by a proper rotation. `maxCells` and `maxMemoryMiB` bound what is built, before it is allocated, and over
      either is an error that names the number, never a model cut short. The engine's defaults are 4194304 cells, 128 MiB and the grid
      `voxels`; they are not XSD defaults so that the attributes that belong to one source can be refused on the other (VOX2).
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which an object3D's voxels attribute refers to this model.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI">
      <xs:annotation><xs:documentation>Path of a local .vox or .srvol file holding the cells; give exactly one of src and fromMesh.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format">
      <xs:annotation><xs:documentation>File format of src: vox (MagicaVoxel) or srvol (a volume cache); taken from the file extension when absent. Only allowed with src.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="vox"/><xs:enumeration value="srvol"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="model" type="xs:nonNegativeInteger">
      <xs:annotation><xs:documentation>Number (from 0) of the one model of a .vox file to use, unplaced; without it a file with a scene graph is used as the whole placed scene, and a file with several models and no graph needs it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fromMesh" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a closed mesh asset to cut into cells: the cells whose centres lie inside the mesh, on a lattice of multiples of cellSize.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cellSize" type="positiveDecimal">
      <xs:annotation><xs:documentation>Edge length of a cell in scene units, on the mesh as drawn (an imported mesh in metres is 100 per metre); required with fromMesh, not allowed with src. Also the default cell size of an object using the asset.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="voxelGrid" type="volumeChannelType">
      <xs:annotation><xs:documentation>Name of the channel of an srvol cache read as the palette indices; voxels when absent. Only for an srvol src.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxCells">
      <xs:annotation><xs:documentation>Most cells the model may have; a larger one is an error. 4,194,304 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="67108864"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="maxMemoryMiB">
      <xs:annotation><xs:documentation>Limit in MiB on the size of the source file and on the cells built from it; exceeding either is an error. 128 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="meshSequenceAssetType">
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Name by which an object refers to this mesh sequence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="volumeSourceType" use="required">
      <xs:annotation><xs:documentation>Numbered pattern of the local mesh files, one per frame (such as shape_%04d.obj or shape_####.obj).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format">
      <xs:annotation><xs:documentation>Mesh file format of the frames (gltf, glb, obj, ply, usd family or fbx); taken from the file extension when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="gltf"/><xs:enumeration value="glb"/><xs:enumeration value="obj"/><xs:enumeration value="ply"/>
      <xs:enumeration value="usd"/><xs:enumeration value="usda"/><xs:enumeration value="usdc"/><xs:enumeration value="usdz"/><xs:enumeration value="fbx"/>
    </xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="first" type="volumeFrameIndexType" use="required">
      <xs:annotation><xs:documentation>Frame number of the first file in the sequence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="last" type="volumeFrameIndexType" use="required">
      <xs:annotation><xs:documentation>Frame number of the last file in the sequence; not below first, and the run holds at most 1,000,000 frames.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fps" type="fpsType" use="required">
      <xs:annotation><xs:documentation>Frame rate of the sequence: frames per second of the object's own animation time (scaled by animationSpeed, shifted by animationOffset).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interpolation" type="meshSequenceInterpolationType" default="hold">
      <xs:annotation><xs:documentation>How a time between two frames is sampled: hold keeps the earlier frame, linear blends both, which must have the same topology and materials (else an error). hold when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="missingFrame" type="volumeMissingFrameType" default="error">
      <xs:annotation><xs:documentation>What a missing frame file becomes: error fails the render, hold uses the nearest earlier frame (an error if none exists), transparent shows nothing for that frame. error when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Most memory in MiB one frame may take, as a file and decoded; a linear blend of two frames needs about three times one frame. Over it is an error. 256 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attributeGroup ref="assetProvenance"/>
  </xs:complexType>
  <xs:complexType name="mediumType">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="animationElements"/></xs:choice>
    <xs:attribute name="densityScale" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier applied to every density sample of the volume; 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="extinction" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Extinction coefficient per scene unit at unit density: how strongly the medium attenuates light passing through; 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="albedo" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Colour of the light the medium scatters rather than absorbs (white scatters all, black absorbs all); white when absent. No light is scattered when scatterBounces is 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="anisotropy" default="0">
      <xs:annotation><xs:documentation>Direction of scattering from -0.99 (backward) through 0 (even) to 0.99 (forward); 0 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double"><xs:minInclusive value="-0.99"/><xs:maxInclusive value="0.99"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="emissionColor" type="colorType" default="#000000FF">
      <xs:annotation><xs:documentation>Colour of the light the medium emits itself, scaled by emissionScale, so nothing is emitted while emissionScale is 0; black when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissionScale" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Brightness of the emission per scene unit at unit density; with blackbody it scales the thermal colour. 0 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="blackbody" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>When true, the temperature channel of the volume makes it glow with blackbody colour; requires temperatureGrid on the volume asset unless the object holds a smoke simulation. false when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperatureScale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Multiplier applied to the temperature samples (in kelvin) before the blackbody colour is worked out; the scaled values must stay within 0 to 50000. 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stepSize" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Largest ray-marching step through the medium, in scene units; smaller steps are more accurate and slower. 1 when absent.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxSteps" default="2048">
      <xs:annotation><xs:documentation>Step budget for one ray through the medium (1 to 65536); a medium that needs more steps at its stepSize is an error. 2048 when absent.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="65536"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="lighting" default="exact">
      <xs:annotation><xs:documentation>Version 1.3. How the medium's in-scattering is lit by the path tracer: exact marches a shadow ray from every sample; grid reads transmittance and surface visibility from per-light grids built once per frame (see the cinematic impact SREP). The lightGrid* attributes apply only with grid (VOL10).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="exact"/><xs:enumeration value="grid"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lightGridCell" default="1">
      <xs:annotation><xs:documentation>With lighting grid, the number of voxels between nodes of the light grids (1 to 64); 1 when absent. Grid-lit media in one frame share one lattice with the finest spacing any of them asks.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="64"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="lightGridDomeDirections" default="64">
      <xs:annotation><xs:documentation>With lighting grid, the number of fixed dome directions used for sky light (8 to 512); 64 when absent. Grid-lit media in one frame use the largest value any of them asks.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:minInclusive value="8"/><xs:maxInclusive value="512"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="lightGridMemoryMiB" default="128">
      <xs:annotation><xs:documentation>With lighting grid, the most memory in MiB the light grids may take (1 to 4096); 128 when absent. Grids needing more are an error, and grid-lit media in one frame share the smallest limit asked.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="scatterBounces" default="1">
      <xs:annotation><xs:documentation>Version 1.3. The most collisions a path may have in the medium before the light reaches the camera, counting the one that is lit directly: 1 is single scattering (what the medium does without the attribute), 0 is a medium that does not scatter (absorption and emission only), and more add the light that has been scattered more than once, estimated by the path tracer by a random walk.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="32"/></xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="particles3DType">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="animationElements"/><xs:element name="transformConstraint" type="transformConstraintType"/><xs:element name="burst" type="burst3DType"/></xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the element; other elements refer to it by this id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation><xs:documentation>Optional human-readable label for the element; elements are referenced by id, not by name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the X axis of its parent's frame (or the scene), in scene units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the Y axis of its parent's frame (or the scene), in scene units; scene y points down.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the Z axis of its parent's frame (or the scene), in scene units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the Z axis, in degrees; combined with rotationY and rotationX.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the X axis, in degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the Y axis, in degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the element appears; also the zero of the element's own time. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds, on the parent's timeline, at which the element disappears; absent, it stays until its parent ends.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="condition" type="expressionString">
      <xs:annotation><xs:documentation>Expression that must be true for the element to be present; while it is false the element is not drawn and emits no particles.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parent" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the element whose frame this one is placed in; its position, rotation and scale are then relative to that element.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parentJoint" type="xs:string">
      <xs:annotation><xs:documentation>With a @parent (or a transformConstraint of type="parent") that is an object3D drawing an imported model: the name of a node of that model. The element is placed in that node's frame as the model's clips pose it, instead of in the object's own frame. The first node of that name in the model's node order is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the X axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the Y axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleZ" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the Z axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When false the element is not drawn; the default true draws it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the particles from 0 (invisible) to 1 (opaque), multiplied with the parent's and with the particle's own fade.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="triStateType" default="inherit">
      <xs:annotation><xs:documentation>Motion blur: on, off, or inherit (default) the nearest parent's setting, else the project's. Consecutive 3D elements sharing a parent are drawn as one pass, blurred by the first one's setting.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="castShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the element casts shadows; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="receiveShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the element receives shadows cast by other objects; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="useForceFields" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the scene's force fields act on the particles; false turns them all off. Default true, using every field unless forceFields lists some.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rate" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Number of particles born per second by continuous emission; 0 emits none. It is sampled at the start of each simulation step and may be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissionStart" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Time in seconds after the element's start at which continuous emission and bursts may begin; timed bursts must not be earlier (bursts from a crater follow their impact). Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lifetimeVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's lifetime is the lifetime plus or minus a random amount up to this many seconds; it must be smaller than lifetime. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Launch speed along the emission direction, per second in the element's own units (its scale applies), added to the initial velocity, for particles born from rate or a timed burst. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speedVariance" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each rate or burst particle's launch speed varies randomly by up to plus or minus this amount; it must not exceed speed. Crater ejecta keep the velocities the impact gives them. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Linear air-drag coefficient per second: velocity decays as exp(-drag*t) in the absence of other forces. 0 means no drag.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collisionRadius" type="nonNegativeDecimal" default="0.5">
      <xs:annotation><xs:documentation>Radius, in scene units, of the sphere used to test particle collisions, scaled by each particle's random scale; it does not change the drawn size.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="friction" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Friction at a bounce: the sliding speed along the surface drops by friction times (1 + bounce) times the speed into the surface, down to zero. 0 is frictionless.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="trail" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>For streak particles, the least length of the streak in scene units while the particle moves; the streak is stretched along its velocity. Ignored by other shapes.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emissionEnd" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Time in seconds after the element's start at which emission stops; absent, emission continues for the element's life. Must not be before emissionStart.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dt" type="positiveDecimal" default=".016666666666666666">
      <xs:annotation><xs:documentation>Length in seconds of the fixed step the particles are simulated and replayed in; the emission rate is held from the start of each step. Default 1/60.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lifetime" type="positiveDecimal" default="2">
      <xs:annotation><xs:documentation>Base lifetime of each particle in seconds, offset at random by up to lifetimeVariance; a particle is removed at the latest when its age reaches its lifetime, and size and colour curves run over that age. Default 2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterWidth" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Width of the emission box along the emitter's X axis, in the element's own units, so scaleX stretches it; used when emitterShape is box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterHeight" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Height of the emission box along the emitter's Y axis, in the element's own units, so scaleY stretches it; used when emitterShape is box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterDepth" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Depth of the emission box along the emitter's Z axis, in the element's own units, so scaleZ stretches it; used when emitterShape is box.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterRadius" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Radius of the emission sphere in the element's own units, so the element's scale stretches it; particles are born uniformly through its volume. Used when emitterShape is sphere.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Size of each particle at birth, in scene units at scale 1: the diameter of a sphere, the edge of a billboard or the thickness of a streak; the element's scale and the particle's random scale multiply it. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="collisionTolerance" type="positiveDecimal" default="0.001">
      <xs:annotation><xs:documentation>Largest distance, in scene units, that a particle's curved path may stray from the straight chord tested for collisions before the step is subdivided; also the gap kept at resting contact. Default 0.001.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added at birth to each particle born from rate or a timed burst, along the emitter's X axis, per second in the element's own units (scaleX applies).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added at birth to each particle born from rate or a timed burst, along the emitter's Y axis, per second in the element's own units (scaleY applies).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added at birth to each particle born from rate or a timed burst, along the emitter's Z axis, per second in the element's own units (scaleZ applies).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant acceleration applied to every particle along the world X axis, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant acceleration applied to every particle along the world Y axis, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant acceleration applied to every particle along the world Z axis, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation0X" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation of each particle about the X axis at birth, in degrees; the three combine as Rz*Ry*Rx in the emitter's frame (the world frame for crater ejecta).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation0Y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation of each particle about the Y axis at birth, in degrees; the three combine as Rz*Ry*Rx in the emitter's frame (the world frame for crater ejecta).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation0Z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial rotation of each particle about the Z axis at birth, in degrees; the three combine as Rz*Ry*Rx in the emitter's frame (the world frame for crater ejecta).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationVarianceX" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's initial X rotation varies randomly by up to plus or minus this many degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationVarianceY" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's initial Y rotation varies randomly by up to plus or minus this many degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationVarianceZ" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's initial Z rotation varies randomly by up to plus or minus this many degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Spin of each particle about the world X axis, in degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Spin of each particle about the world Y axis, in degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Spin of each particle about the world Z axis, in degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityVarianceX" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's X spin varies randomly by up to plus or minus this many degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityVarianceY" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's Y spin varies randomly by up to plus or minus this many degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angularVelocityVarianceZ" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Each particle's Z spin varies randomly by up to plus or minus this many degrees per second.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inheritedVelocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added along the world X axis, in scene units per second, to each particle born from rate or a timed burst, for example to carry the emitter's own motion.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inheritedVelocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added along the world Y axis, in scene units per second, to each particle born from rate or a timed burst, for example to carry the emitter's own motion.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="inheritedVelocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added along the world Z axis, in scene units per second, to each particle born from rate or a timed burst, for example to carry the emitter's own motion.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="directionX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>X component of the launch direction of rate and burst particles, in the emitter's axes; the vector need not be unit length but must not be all zero. Crater ejecta ignore it. Default (0,-1,0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="directionY" type="xs:double" default="-1">
      <xs:annotation><xs:documentation>Y component of the launch direction of rate and burst particles, in the emitter's axes; the vector need not be unit length but must not be all zero. Crater ejecta ignore it. Default (0,-1,0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="directionZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Z component of the launch direction of rate and burst particles, in the emitter's axes; the vector need not be unit length but must not be all zero. Crater ejecta ignore it. Default (0,-1,0).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spread" default="0">
      <xs:annotation><xs:documentation>Full opening angle in degrees of the cone around the emission direction into which rate and burst particles are launched, uniform over solid angle: 0 is straight, 360 all directions. Crater ejecta ignore it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="nonNegativeDecimal"><xs:maxInclusive value="360"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="scaleVariance" default="0">
      <xs:annotation><xs:documentation>Each particle's birth scale is random between 1 minus and 1 plus this value (below 1), scaling both its drawn size and its collision radius.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="nonNegativeDecimal"><xs:maxExclusive value="1"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="bounce" type="unitDecimal" default="0.5">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of the speed normal to a surface that a particle keeps, reversed, when it hits; 0 keeps none of it and 1 is a perfect bounce. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed for the random draws that vary the particles (positions, directions, lifetimes, rotations); the same seed gives the same particles. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxParticles" default="10000">
      <xs:annotation><xs:documentation>Most particles alive at once (1 to 1,000,000); rate and burst births beyond it are dropped and counted, crater births beyond it are an error. Default 10000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxEvents" default="16384">
      <xs:annotation><xs:documentation>Most birth events (rate, burst and crater births) one simulation step may produce; exceeding it is an error. Default 16384.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Memory budget in MiB for the particle state and drawing; a configuration or frame that would need more is an error. Default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="checkpointMemoryMiB" default="64">
      <xs:annotation><xs:documentation>Memory in MiB for the saved simulation states that let later or earlier frames be reached without replaying from the start. Default 64.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="meshMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Memory budget in MiB for the emitter mesh geometry, and the same budget again for the colliders' geometry. Default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxWork" default="100000000">
      <xs:annotation><xs:documentation>Cap on the simulation work (births, motion segments and collision refinements) one frame request may spend; exceeding it is an error.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="segments" default="12">
      <xs:annotation><xs:documentation>Number of segments used to build the sphere or streak shape of each particle (at least 3); billboard and mesh shapes ignore it. Default 12.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="256"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="emitterMesh" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the mesh asset whose surface particles are born on, uniformly by area; required when emitterShape is mesh and not allowed otherwise.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mesh" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the triangle mesh asset (not splats) drawn for each particle; required when shape is mesh and not allowed otherwise.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="material" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material applied to the particle shapes; absent, a plain grey material is used (a mesh shape keeps the mesh's own materials).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprite" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the image asset used as the texture of billboard particles; allowed only with shape billboard.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceFields" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the force fields that accelerate the particles; absent, every force field of the scene acts on them (unless useForceFields is false).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colliders" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the surface objects (primitive shapes, meshes, text, extrude or clay solids) that particles bounce off; at most 4096 distinct ones. They may move, but their shape parameters must not be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gas" type="xs:IDREF">
      <xs:annotation><xs:documentation>
        The object3D whose native pyro volume drags the particles along. Absent (the default) is the behaviour there
        always was. The acceleration of a particle gains `drag` times the gas's velocity at its place and time, so
        with the emitter's `drag` k the particle obeys p'' = k (u - v) plus gravity and fields: it is dragged by the gas
        inside the volume's domain and by still air outside it, with the same coefficient (the gas fades to rest across
        one cell outside the domain, so there is no jump at its boundary); a `drag` of zero gives no coupling. The place
        is taken to the volume's axes by the inverse of its world matrix at that time and the velocity back by its
        linear part. In time the gas is the linear interpolation of the two smoke steps around the instant; the
        particles run before the smoke in the frame and ask it, in order, for the steps they need, so that it is simulated
        once for each of its steps, and a smoke that fails fails the particles with its message. The velocity fields of the steps in use are charged to the volume's `maxMemoryMiB`
        and exceeding it is an error. The particles do not push the gas, and the coupling is linear in the relative
        velocity: for 0.34 m rocks of 2100 kg/m3 in air at 50 m/s the quadratic drag is a rate of about 0.03 per second,
        so it moves dust-sized particles and not ejecta. The volume must be on the composition clock.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="emitterShape" default="point">
      <xs:annotation><xs:documentation>Region in which rate and burst particles are born: point (default), box or sphere (both filled, uniformly), or mesh (the surface of emitterMesh). Crater ejecta are placed by the impact instead.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="point"/><xs:enumeration value="box"/><xs:enumeration value="sphere"/><xs:enumeration value="mesh"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="shape" default="sphere">
      <xs:annotation><xs:documentation>What is drawn for each particle: sphere (default), billboard (a camera-facing quad), streak (stretched along its velocity) or mesh (the mesh asset named by mesh, which is then required).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="sphere"/><xs:enumeration value="billboard"/><xs:enumeration value="streak"/><xs:enumeration value="mesh"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="sizeEnd" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Size at the end of a particle's life, in the units of size; the size moves from size to this value along sizeCurve. Absent, the size stays constant.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" default="#FFFFFFFF">
      <xs:annotation><xs:documentation>Particle colour at birth, blending toward colorEnd over each particle's life along colorCurve; multiplied with the material's base colour including its alpha. Default opaque white.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorEnd" type="colorType">
      <xs:annotation><xs:documentation>Tint at the end of a particle's life; the colour moves from color to this value along colorCurve. Absent, the colour stays constant.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacityEnd" type="unitDecimal">
      <xs:annotation><xs:documentation>Factor applied to the element's opacity at the end of a particle's life, reached along colorCurve; 0 fades the particle out, 1 (default) leaves the opacity unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sizeCurve" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Easing curve that maps a particle's age (0 at birth, 1 at death) to the blend from size to sizeEnd. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colorCurve" type="curveType" default="linear">
      <xs:annotation><xs:documentation>Easing curve that maps a particle's age (0 at birth, 1 at death) to the blend of color, opacityEnd and colorEnd. Default linear.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="burst3DType">
    <xs:annotation><xs:documentation>
      A burst of a 3D emitter at an instant (`time`, `count`, `repeat`, `interval`), or what the impact of a crater
      throws out of it: `crater` names a crater that grows from an impact (`crater@source`), `count` is then the
      number of particles that stand for the ejecta (for the crater of an object of cells, whose particles are the cells that the cut throws with the cut's own
      velocities, there is no count, no `angle` and no `angleSpread`: CRT16 and CRT17), and when, where, how fast and how heavy each one is are derived
      (the instant, `repeat` and `interval` are not given). Each particle is born at the instant it is launched, at its
      launch distance from the impact point, with its own velocity and mass; the mass is kept in the particle (the
      render size still comes from `size`) and the particles together hold 80% of the crater's mass. Launch speed
      and mass follow the ejecta scaling of Housen and Holsapple (2011) as the engine reads it, which has not been
      checked against the paper; the launch angle, its spread, the launch time and the lopsidedness of an oblique
      impact are the engine's own. `angle` is the launch angle above the tangent plane of the contact and
      `angleSpread` the half-width of the uniform spread around it, in degrees; both stay within 0 to 90 together.
      The ejecta of regolith and ice have no table row and are an error. Positions and velocities are in scene units
      through `physics/@pixelsPerMeter`, and gravity, drag and colliders are those of the emitter. The crater's
      pose is that of its owner at the impact. More particles than `maxParticles` is an error, not a truncation.
    </xs:documentation></xs:annotation>
    <xs:attribute name="time" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds after the element's start at which the burst fires; not earlier than emissionStart, and a firing at or after emissionEnd does not happen. Not given for a burst from a crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="count" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Number of particles born at each firing; required, except for a burst from the crater of an object of cells, whose particles are the cells the cut throws. For another crater burst, the number standing for the ejecta.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="repeat" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>Number of further firings after the first, spaced by interval. Default 0 (fires once). Not given for a burst from a crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interval" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Seconds between repeated firings of the burst; needed when repeat is above 0. Default 1. Not given for a burst from a crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="crater" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a crater that grows from an impact; the burst then throws out its ejecta, with times, speeds and masses derived from the impact, so time, repeat and interval may not be given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="angle"><xs:annotation><xs:documentation>The launch angle above the tangent plane, degrees; the engine's default is 45. It is not an XSD default, so that it can be refused on a burst that is not from a crater (P3D9).</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="nonNegativeDecimal"><xs:maxInclusive value="90"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="angleSpread"><xs:annotation><xs:documentation>The half-width of the uniform spread of the launch angle, degrees; the engine's default is 15, with the same reason as `angle`. The angle and its spread stay between 0 and 90 together (P3D10).</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="nonNegativeDecimal"><xs:maxInclusive value="90"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="oceanType">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="animationElements"/><xs:element name="transformConstraint" type="transformConstraintType"/><xs:element name="waterImpulse" type="waterImpulseType"/><xs:element name="wave" type="oceanWaveType"/><xs:element name="whitewater" type="whitewaterType"/></xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the element; other elements refer to it by this id.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation><xs:documentation>Optional human-readable label for the element; elements are referenced by id, not by name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the X axis of its parent's frame (or the scene), in scene units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the Y axis of its parent's frame (or the scene), in scene units; scene y points down.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the element along the Z axis of its parent's frame (or the scene), in scene units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotation" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the Z axis, in degrees; combined with rotationY and rotationX.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the X axis, in degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotationY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Rotation of the element about the Y axis, in degrees.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds on the parent's timeline that is zero of the element's own time; it appears then, or earlier while a transition into it runs. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds on the parent's timeline at which the element disappears, or later while a transition out of it runs; absent, it stays until its parent ends.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="condition" type="expressionString">
      <xs:annotation><xs:documentation>Expression that must be true for the element to be present; while it is false the element is neither drawn nor simulated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="parent" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the element whose frame this one is placed in; its position, rotation and scale are then relative to that element.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleX" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the X axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleY" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the Y axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scaleZ" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scale of the element along the Z axis of its own frame; 1 leaves it unchanged.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>When false the element is not drawn; the default true draws it.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="unitDecimal" default="1">
      <xs:annotation><xs:documentation>Opacity of the ocean and its whitewater from 0 (invisible) to 1 (opaque), multiplied with the opacity of the enclosing element.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="triStateType" default="inherit">
      <xs:annotation><xs:documentation>Motion blur for this element: on, off, or inherit (default) to take the nearest parent's setting, else the project's. 3D elements drawn together in one pass are blurred by the first one's setting.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="castShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the element casts shadows; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="receiveShadow" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the element receives shadows cast by other objects; default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal" default="64">
      <xs:annotation><xs:documentation>Size of the water domain along X in scene units, centred on the element; width divided by cellSize must be a whole number of cells. Default 64.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="positiveDecimal" default="64">
      <xs:annotation><xs:documentation>Size of the water domain along Z in scene units, centred on the element; depth divided by cellSize must be a whole number of cells. Default 64.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cellSize" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Edge length of one grid cell of the water simulation, in scene units; it must divide width and depth into whole numbers of cells, and a wave is at least two cells long. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="waterLevel" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Y coordinate of the water's rest surface in the element's own axes, in scene units; the water lies below it, at greater y, down to the sea floor. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottomDepth" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Depth of the flat sea floor below waterLevel (at greater y), in scene units, when no bathymetry is given; it also sets the default speed of a wave that gives none. Default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravity" type="positiveDecimal" default="9.81">
      <xs:annotation><xs:documentation>Gravitational acceleration used by the water: waves travel at the square root of gravity times depth. Default 9.81.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="damping" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Exponential decay rate per second of the water's horizontal velocity; 0 (default) is undamped.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dt" type="positiveDecimal" default=".016666666666666666">
      <xs:annotation><xs:documentation>Length in seconds of the water simulation's canonical step, at which it is replayed and sampled; at least 0.000001. Default 1/60.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dryTolerance" type="positiveDecimal" default="0.0000000001">
      <xs:annotation><xs:documentation>Water depth below which a cell counts as dry: its momentum is zeroed. Default 1e-10, in scene units.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="initialVelocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial horizontal water velocity along X in every wet cell at time zero, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="initialVelocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Initial horizontal water velocity along Z in every wet cell at time zero, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bathymetryScale" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Factor applied to the sea-floor y values (larger y is deeper) read from the bathymetry asset, before bathymetryOffset is added. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bathymetryOffset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Value added, in scene units, to the scaled sea-floor y values (larger y is deeper) read from the bathymetry asset. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed for the random starting phase of waves that give no phase; the same seed gives the same sea. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Memory budget in MiB for the water grid; a grid of more than 4 million cells or needing more memory than this is an error. Default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="checkpointMemoryMiB" default="64">
      <xs:annotation><xs:documentation>Memory in MiB for the saved water states that let a frame be reached without replaying from the start. Default 64.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="meshMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Memory budget in MiB for the bathymetry's geometry or decoded image and for the colliders' geometry. Default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="surfaceMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Memory budget in MiB shared by the drawn water surface mesh, its foam coverage and the whitewater tracer meshes. Default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxWork" default="100000000">
      <xs:annotation><xs:documentation>Cap on the simulation work one frame request may spend, counted per cell and step; exceeding it is an error. Default 100000000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="boundary" default="closed">
      <xs:annotation><xs:documentation>What happens at the edges of the domain: closed reflects the water (default), open extends the edge state outward with zero gradient and does not absorb waves, periodic wraps the domain around.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="closed"/><xs:enumeration value="open"/><xs:enumeration value="periodic"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="bathymetryEncoding" default="red">
      <xs:annotation><xs:documentation>How an image asset gives sea-floor y values: red (default) takes the red channel as 0 to 1 for 8- and 16-bit images; terrarium and mapbox decode tile elevation and negate it, so higher ground has smaller y.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="red"/><xs:enumeration value="terrarium"/><xs:enumeration value="mapbox"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="order" default="1">
      <xs:annotation><xs:documentation>Accuracy of the water solver: 1 (default) is first order and fast, 2 is second order and sharper at higher cost.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="1"/><xs:enumeration value="2"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="material" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material used to draw the water surface; absent, a built-in water appearance is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bathymetry" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the mesh or image asset that gives the sea-floor y values (larger y is deeper); a mesh must cover every cell centre. Absent, the floor is flat at bottomDepth below waterLevel.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colliders" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the objects that move the water: a plane or mesh with a crater deforms the sea floor, and a closed body (box, sphere, cylinder and the like) displaces the water it occupies. At most 4096.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="splash" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        The particles3D emitters whose particles fall into this ocean: each must throw out the ejecta of a crater (a
        `burst` with `crater`), whose particles have a mass (OCN13). Absent (the default) is the behaviour there always was.
        A particle of a listed emitter whose centre crosses the ocean's rest level (`waterLevel`) downward inside its
        domain is removed there, and what it brings is given to the water in the canonical step of the crossing, summed
        by cell: the volume of the particle (its mass over the density of the crater's target) is taken out of the
        cell's water and given equally to its eight neighbours, never more than 90 % of the cell's water, and its
        horizontal momentum, divided by the density of the water, is added to the cell's. The water volume and the
        horizontal momentum that is applied are conserved; the vertical momentum and the energy of the particle are not
        (the shallow-water model has no vertical momentum), and a particle that has fallen in is gone, it does not sink.
        The surface is the water's rest level, not the swell, and the ocean is taken at its pose when the emitter
        starts. The deposit does not go through the depth filter of `bedResponse`. An emitter belongs to one ocean.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bodyCoupling" default="none">
      <xs:annotation><xs:documentation>
        What the water does to the rigid bodies in `colliders`. `none` (the default) is the existing behaviour: a body
        displaces the water and nothing acts on the body. `buoyancy` loads each rigid body with the weight of the water it
        displaces (water density 1000 kg/m3, the ocean's gravity), upward through the centroid of the submerged volume
        so that a tilted body is turned by it, and with a quadratic form drag on its vertical motion, scaled by
        `bodyDrag`. A body floats if it is lighter than the water it displaces. The submerged part is measured against
        the free surface under the body: the plane that the ocean fits, in the canonical step before the last one it has
        completed, through the surface of the wet columns of the body's footprint (the water the body displaces stands
        above the rest level while it is there, and the plane says so), and against the rest level, `waterLevel`, while
        there is none; the body's own motion therefore moves the water it floats on, and the water carries the energy of
        a bobbing body away, so a body with no drag settles. `full` adds the horizontal momentum the body gave the water in
        that step, taken back as a force along the body's centre over one canonical step, so that the body and the water
        keep their momentum together (to what is in flight, one step late); roll is not damped, there is no added mass,
        and a body rides the rest level when the ocean has no water under it. The load is held for one rigid step and
        evaluated halfway through it. A body so light that the waterline's stiffness times the step reaches 1.8 is an
        error (lower `physics/@fixedStep` or raise the mass), not a damped motion. The rigid body must be a sphere, box,
        cylinder, cone, capsule or closed mesh. The ocean and the bodies form a group (see the contract text): the ocean
        is stepped before the rigid world, and the document cannot be baked into a physics cache.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="none"/><xs:enumeration value="buoyancy"/><xs:enumeration value="full"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bedResponse" default="depthFiltered">
      <xs:annotation><xs:documentation>
        How the free surface answers what the objects in `colliders` do to the water: the bed that a crater moves and
        the volume a body occupies. `depthFiltered` (the default) attenuates it by the depth of the water: a
        displacement much narrower than the depth does little to the surface, as in linear water-wave theory, where an
        instantaneous displacement of wavenumber k is carried to the surface by 1/cosh(k h) for the bed (Kajiura 1963;
        read here only as quoted by the tsunami literature) and by cosh(k z0)/cosh(k h) for a volume at height z0 above the bed
        (derived by the engine). The displaced volume is conserved. `hydrostatic` lifts the whole column by the
        displacement, which is the long-wave answer, right when the displacement is much wider than the depth: the
        behaviour of the first version, kept for comparison. With `depthFiltered` the horizontal momentum that a
        body gives the water is also not the relaxation toward its velocity but the form drag of the body through
        it, (1/2) C_d A |U - u| (U - u) per unit density (C_d is `bodyDrag`, U the body's velocity, u the mean
        velocity of the water under it, A the area its wet part presents to that flow), spread as the lift of the
        body is and never past its velocity. It has no effect without `colliders`.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="depthFiltered"/><xs:enumeration value="hydrostatic"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="density" type="positiveDecimal" default="1000">
      <xs:annotation><xs:documentation>
        Density of the water, kilograms per cubic metre (default 1000, fresh water; sea water is about 1025). It is the density of the
        weight of the water a body displaces (`bodyCoupling`), of the force the water gives back to it (the momentum the solver
        exchanges is per unit density), of what the ejecta that fall into the ocean bring (`splash`: their momentum is divided by it),
        and of the target of the cavity of a body that enters (`waterImpulse`). Without the attribute the water is 1000 kg/m3, as it was.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bodyDrag" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>
        Coefficient of form drag of a body in the water. With `bodyCoupling` it is the coefficient of the vertical motion:
        the force is -(1/2) rho C_d A |v| v with A the area the submerged part presents from above, limited to what
        stops the body within a step. With `bedResponse="depthFiltered"` it is also that of the horizontal exchange
        with the water, the same law along the motion of the body relative to the water. Default 1.0, the engine's: not an XSD default, so that
        the attribute can be refused on an ocean without `colliders` (OCN9). It is an engine parameter, not a value from the impact literature; 0 gives
        undamped bobbing.
      </xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="waterImpulseType">
    <xs:annotation><xs:documentation>
      An impulse at an instant (`time`, `x`, `z`, `radius`, `amplitude`, `velocityX`, `velocityZ`, `type`), or the cavity
      that a body makes of the water it enters: `source` names a dynamic rigidBody object that the ocean lists in
      `colliders`, and nothing is authored about when, where or how big (none of the others may be given, and a body has
      at most one). The entry is the first time the lowest point of the body crosses the ocean's rest level (`waterLevel`)
      downward, found step by step from the body's poses, with the body moving down at that instant; a body that starts
      in the water, or never reaches it, makes no cavity. The cavity is the transient crater of the scaling law of
      Holsapple (1993) for water as a target, with the body's mass and density, the speed it enters at (the component
      normal to the surface, from the displacement of its centre over the canonical step) and the ocean's gravity; the
      law's volume and depth give the disc that is emptied (a bowl profile of the law's depth at its centre holding the law's volume), the water going to the ring around it
      (`waterImpulse type="displace"` with a negative amplitude, conserving all the water). The cavity forms over the
      law's formation time (0.8 times the square root of its volume's cube root over gravity), in a part for every
      canonical step that grows smoothly from nothing to the whole (the shape of the growth is the engine's choice,
      the law gives only the time); a ring or a disc narrower than four cells is widened, keeping the volume. The cavity is limited by the water layer: it takes at most 90% of the
      water of its disc, and of any column in it, so it never exposes the bed and is never an error for lack of water; a
      body that reaches the bed excavates the bed's crater (`crater@source`) instead. The body goes on raising the
      columns it occupies, as before; the cavity is displacement in addition. Hydrostatic: no jet, no crown of
      spray, no air; the law is that of a crater in water, not a validated model of water entry. The event is made at
      the first entry only, for the owner's pose at that instant, and an entry outside the ocean makes nothing.
    </xs:documentation></xs:annotation>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of a dynamic rigid body, without a crater, listed in the ocean's colliders; the impulse is the cavity it makes when its lowest point first crosses the rest level downward. No other attribute may be given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="time" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Time in seconds on the ocean's clock at which the impulse is applied. Not given with source. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>X position of the impulse's centre in the ocean's own axes, in scene units. Not given with source. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Z position of the impulse's centre in the ocean's own axes, in scene units. Not given with source. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Outer radius of the impulse in scene units: the velocity and add-water falloff reach it, and the central disc of displace is half of it. It must cover at least one cell centre. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amplitude" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Strength at the centre: for displace, the change in depth there (positive raises, negative lowers, water moved to or from a ring around); for add-water, the depth added, not negative. Not given with source. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal velocity along X added to the water within radius of the centre, strongest at the centre, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Horizontal velocity along Z added to the water within radius of the centre, strongest at the centre, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" default="displace">
      <xs:annotation><xs:documentation>displace (default) moves water between a central disc and a surrounding ring, conserving volume; add-water adds depth with a smooth falloff to the edge. Not given with source.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="displace"/><xs:enumeration value="add-water"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="whitewaterType">
    <xs:annotation><xs:documentation>Cinematic read-only water tracers. Births at ocean dt endpoints follow excess surface slope or Froude number. Foam follows water; spray is ballistic with drag and becomes foam on landing. Own budgets and full-u64 seed; at most one child per ocean.</xs:documentation></xs:annotation>
    <xs:attribute name="emissionRate" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Expected tracers born per cell per second for each unit by which the larger of surface slope and flow Froude number exceeds threshold. Default 10.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="threshold" type="nonNegativeDecimal" default="0.5">
      <xs:annotation><xs:documentation>Value of the larger of surface slope and horizontal Froude number below which no whitewater is born. Default 0.5.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Time in seconds on the ocean's clock at which whitewater births begin. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lifetime" type="positiveDecimal" default="3">
      <xs:annotation><xs:documentation>Longest time a foam or spray tracer lives, in seconds; one is removed sooner if it leaves the domain through an open boundary or moves where every nearby cell is dry. Default 3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprayFraction" type="unitDecimal" default="0.4">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of new tracers that are spray (launched upward and falling back) rather than foam (riding the surface). Default 0.4.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="launchSpeed" type="nonNegativeDecimal" default="3">
      <xs:annotation><xs:documentation>Upward launch speed of newly born spray tracers, in scene units per second. Default 3.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="drag" type="nonNegativeDecimal" default="0.1">
      <xs:annotation><xs:documentation>Rate per second at which air drag slows spray in flight. Default 0.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="0.05">
      <xs:annotation><xs:documentation>Drawn radius of each foam or spray tracer in scene units at birth; it shrinks linearly to zero over the tracer's lifetime. Default 0.05.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed for the random choices of where tracers are born and whether they are foam or spray; the same seed gives the same whitewater. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Time in seconds on the ocean's clock at which whitewater births stop, not before start; absent, they continue.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxParticles" default="10000">
      <xs:annotation><xs:documentation>Most tracers alive at once; a birth that would exceed it is an error rather than being dropped. Default 10000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="64">
      <xs:annotation><xs:documentation>Memory budget in MiB for the whitewater tracers and the water samples and bed copy they use; a configuration needing more is an error. Default 64.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxWork" default="100000000">
      <xs:annotation><xs:documentation>Cap on the work one whitewater frame request may spend; a request that exceeds it is an error. Default 100000000.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="1000000000000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="checkpointMemoryMiB" default="64">
      <xs:annotation><xs:documentation>Memory in MiB for saved whitewater states used to reach earlier frames; 0 keeps none, so every backward seek replays from time zero. Default 64.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="foamMaterial" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material used to draw the foam tracers; absent, a built-in white material is used. Not used when foamMode is albedo.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sprayMaterial" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material used to draw the spray tracers; absent, a built-in translucent water material is used.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="foamMode" default="particles">
      <xs:annotation><xs:documentation>particles draws each foam tracer as a triangle batch (foamMaterial). albedo draws no foam triangles: the foam tracers become a per-vertex coverage of the ocean surface (a kernel of foamRadius, fading with age) that is the share of the surface's area the foam covers: where it covers, the surface is a diffuse white of albedo foamAlbedo and roughness foamRoughness that lets no light through, and the light that gets through the rest keeps the water's tint; foamMaterial is then unused. Spray is drawn in both modes. The mix is the path tracer's: with the raster renderer the frame reports an error instead of drawing no foam, and the water's material must have the opaque alpha mode.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="particles"/><xs:enumeration value="albedo"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="foamRadius" type="positiveDecimal">
      <xs:annotation><xs:documentation>Radius in scene units of the coverage one foam tracer gives the surface in albedo mode; absent, one cell of the ocean; at most 64 cells of the ocean (OCN14). Ignored in particles mode.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="foamAlbedo" type="unitDecimal" default="0.9">
      <xs:annotation><xs:documentation>Diffuse albedo of fully covered water in albedo mode.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="foamRoughness" type="unitDecimal" default="0.8">
      <xs:annotation><xs:documentation>Roughness of fully covered water in albedo mode.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="oceanWaveType">
    <xs:attribute name="wavelength" type="positiveDecimal" default="16">
      <xs:annotation><xs:documentation>Distance between wave crests, in scene units; at least two cells. Default 16.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="amplitude" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Amplitude of the wave in scene units, limited at each point to half the local water depth; the mean rise over the wet cells is removed. Default 1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Direction the wave travels, in degrees measured from the +X axis toward +Z. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="phase" type="xs:double">
      <xs:annotation><xs:documentation>Starting phase of the wave in degrees; absent, a phase drawn at random from the ocean's seed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="speed" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Phase speed of the wave in scene units per second; 0 gives a stationary swell. Absent, the square root of the ocean's gravity attribute times bottomDepth (default 10).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pyroSourceType">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="animationElements"/></xs:choice>
    <xs:attributeGroup ref="pyroShape"/>
    <xs:attributeGroup ref="pyroCrater"/>
    <xs:attribute name="start" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Time in seconds on the smoke volume's clock at which the source starts emitting. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="xs:double">
      <xs:annotation><xs:documentation>Time in seconds on the smoke volume's clock at which the source stops; absent, it emits for the rest of the simulation. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="densityRate" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Smoke density added per second inside the source's shape while it is active. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperatureRate" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Temperature added per second, in kelvin, inside the source's shape while it is active. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityRateX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added per second along the volume's X axis inside the source's shape while it is active, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityRateY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added per second along the volume's Y axis inside the source's shape while it is active, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityRateZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added per second along the volume's Z axis inside the source's shape while it is active, in scene units per second squared.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="expansion" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Target local divergence of the air inside the shape while the source is active, in 1 per second; positive makes it swell. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pyroImpulseType">
    <xs:attributeGroup ref="pyroShape"/>
    <xs:attributeGroup ref="pyroCrater"/>
    <xs:attribute name="time" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Time in seconds on the smoke volume's clock at which the impulse is applied, once, in the simulation step that contains it. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="density" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Smoke density added once in each cell inside the impulse's shape. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="temperature" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Temperature added once, in kelvin, in each cell inside the impulse's shape. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added once along the volume's X axis inside the impulse's shape, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added once along the volume's Y axis inside the impulse's shape, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocityZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Velocity added once along the volume's Z axis inside the impulse's shape, in scene units per second. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="expansion" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Dimensionless divergence released once in each cell inside the shape, as a target divergence of this value divided by the step length in the step that contains the impulse. Default 0. Not given with crater.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="pyroBlastType">
    <xs:annotation><xs:documentation>
      A blast in the smoke (version 1.3): `energy` joules released at (x, y, z) in the pyro's own axes at `time` seconds, into air of
      `ambientDensity` kg/m^3 and `ambientPressure` Pa, a gas of `gamma`. The front is the Sedov-Taylor blast, R = xi (E t^2 / rho)^(1/5)
      metres, with the constant found from the self-similar solution, until it reaches 0.3 (E / p)^(1/3) metres (the end of the strong
      phase), where it stops; a metre is the scene's `pixelsPerMeter` (the physics element's, 100 if there is none) scene units. The
      solver is incompressible, so the shock is not carried: each step the air that the front swept in the step is displaced (the cells
      whose centres are in the sphere of the front's radius at the end of the step are given the divergence that makes their volume the
      volume swept), and the projection makes the potential flow outside. Nothing is heated and no smoke is made (a fireball is a
      pyroSource or a pyroImpulse that the author adds). A pyro with a blast needs boundary="open" (PYC5), and the blast's place is in
      the domain (PYC6). An energy of zero is a blast that does nothing. A pyro with no blast is the pyro it was.
    </xs:documentation></xs:annotation>
    <xs:attribute name="time" type="nonNegativeDecimal" use="required">
      <xs:annotation><xs:documentation>Time in seconds from the start of the simulation at which the blast is released.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="energy" type="nonNegativeDecimal" use="required">
      <xs:annotation><xs:documentation>Energy released by the blast, in joules.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the blast along the pyro volume's X axis, from the domain centre and in the units of the pyro's size; it must lie within half the size either side. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the blast along the pyro volume's Y axis, from the domain centre and in the units of the pyro's size; it must lie within half the size either side. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="z" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the blast along the pyro volume's Z axis, from the domain centre and in the units of the pyro's size; it must lie within half the size either side. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ambientDensity" type="positiveDecimal" default="1.2">
      <xs:annotation><xs:documentation>Density of the surrounding air in kilograms per cubic metre. Default 1.2.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ambientPressure" type="positiveDecimal" default="101325">
      <xs:annotation><xs:documentation>Pressure of the surrounding air in pascals. Default 101325.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gamma" default="1.4">
      <xs:annotation><xs:documentation>Heat-capacity ratio of the surrounding gas, between 1.1 and 3. Default 1.4.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="positiveDecimal"><xs:minInclusive value="1.1"/><xs:maxInclusive value="3"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="pyroType">
    <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:element name="pyroSource" type="pyroSourceType"/><xs:element name="pyroImpulse" type="pyroImpulseType"/><xs:element name="pyroBlast" type="pyroBlastType"/></xs:choice>
    <xs:attribute name="colliders" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of up to 4096 distinct objects that act as solid obstacles the smoke flows around: box, sphere, globe, plane, cylinder, cone, capsule, torus, mesh, text, extrude or clay. Their shape parameters may not be animated.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="colliderThickness" type="positiveDecimal">
      <xs:annotation><xs:documentation>Thickness in scene units of the solid slab used for a flat collider such as a plane. Default twice voxelSize.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceFields" type="xs:IDREFS">
      <xs:annotation><xs:documentation>Ids of the force fields that accelerate the smoke; a field that affects only bodies never does. Absent, every force field that affects particles acts on it (unless useForceFields is false).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="useForceFields" type="xs:boolean" default="true">
      <xs:annotation><xs:documentation>Whether the force fields that act on particles act on the smoke: all of the scene's, or those listed in forceFields; false turns them all off. Default true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Size of the simulation domain along X in scene units; it starts centred on the object (a following window then moves). Must be a whole multiple of voxelSize with 2 to 1024 cells.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Size of the simulation domain along Y in scene units; it starts centred on the object (a following window then moves). Must be a whole multiple of voxelSize with 2 to 1024 cells.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Size of the simulation domain along Z in scene units; it starts centred on the object (a following window then moves). Must be a whole multiple of voxelSize with 2 to 1024 cells.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="voxelSize" type="positiveDecimal" use="required">
      <xs:annotation><xs:documentation>Edge length of one cell of the smoke grid, in scene units; width, height and depth must each be a whole multiple of it, giving 2 to 1024 cells per axis. Smaller cells give finer detail at higher cost.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="dt" type="positiveDecimal" default=".016666666666666666">
      <xs:annotation><xs:documentation>Length in seconds of the smoke simulation's fixed step. Default 1/60.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="ambientTemperature" default="300">
      <xs:annotation><xs:documentation>Temperature of the surrounding air in kelvin, the baseline for buoyancy and cooling. Default 300.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="positiveDecimal"><xs:maxInclusive value="50000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="dissipation" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Exponential decay rate per second of the smoke density; 0 (default) never fades.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cooling" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Exponential decay rate per second of the temperature above ambient; 0 (default) never cools.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="buoyancy" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Acceleration along the volume's negative Y axis per kelvin of temperature above ambient (cooler smoke sinks); 0 (default) gives no lift.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="vorticity" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Strength of the vorticity-confinement force that keeps small swirls from smoothing away; 0 (default) is off.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="turbulence" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Amplitude of a seeded random acceleration applied throughout the smoke, in scene units per second squared. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed for the random turbulence; the same seed gives the same smoke. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressureTolerance" type="positiveDecimal" default="0.000001">
      <xs:annotation><xs:documentation>Largest root-mean-square divergence error, over the fluid cells and in 1 per second, left after the pressure solve; a step that leaves more is an error. Default 1e-6.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="boundary" default="closed">
      <xs:annotation><xs:documentation>closed (default) makes the domain faces solid walls; open lets air and smoke flow out through them.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="open"/><xs:enumeration value="closed"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="follow" type="xs:boolean">
      <xs:annotation><xs:documentation>
        A window that follows the plume (PYRO9: only with boundary="open"). The domain keeps the same number of cells and so
        the same memory and cost of a step, and moves by whole cells to keep the smoke away from its faces, which an open
        domain would otherwise cut it at; absent or false it stays where it is. Where the window may move is decided from the
        state alone (the smoke along each axis, kept followMargin cells, plus the cells the fastest air goes in a step, from
        each face), so the same at any time requested and from a checkpoint; it never leaves a slab that a source acting in
        the step covers, and it lets go of the density that followLoss allows and no more, counted by the solver. If the
        smoke does not fit in the window the window cannot follow it and it is cut as before: the remedy is a larger window.
        The domain is still centred on the object when the document begins; the moving window is in the object's own axes.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="followMargin" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>
        Cells the smoke is kept from every face of a window that follows it (PYRO10: only with follow; PYRO11: it leaves a
        cell between the faces of the window). The engine's default is 12, the distance from which the engine measured the
        top face of a plume to have no effect on it (W02); it is not an XSD default so that it can be refused without follow.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="followLoss" type="unitDecimal">
      <xs:annotation><xs:documentation>
        The share (0 to 1) of all the smoke that the window of a followed plume may let go of each side when it moves
        (PYRO10: only with follow). The engine's default is 0: only slabs that hold no smoke and no heat, and nothing is let
        go of; a plume has a thin numerical tail that is never exactly zero, so a window with a loss of zero follows only
        what leaves nothing behind. Not an XSD default so that it can be refused without follow. What is let go of is the
        solver's own count (the state's lost density), never silent.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pressureIterations" default="200">
      <xs:annotation><xs:documentation>Most iterations of the pressure solve per step, 1 to 10000; a solve that has not reached pressureTolerance in this many is an error. Default 200.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="10000"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="solver" default="jacobi">
      <xs:annotation><xs:documentation>Pressure solver: jacobi (default) or multigrid, whose iteration count stays roughly independent of resolution but whose results differ from jacobi in the last bits.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="jacobi"/><xs:enumeration value="multigrid"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="advection" default="semilagrangian">
      <xs:annotation><xs:documentation>Scheme that carries density, temperature and velocity: semilagrangian (default, stable but smoothing) or maccormack (keeps finer detail).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="semilagrangian"/><xs:enumeration value="maccormack"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Memory budget in MiB for the smoke state and step workspace; a configuration needing more is an error. Default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="checkpointMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Memory in MiB for the saved smoke states that let a frame be reached without replaying from the start. Default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="meshMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Memory budget in MiB for the geometry of mesh sources and of colliders, cratered ground included. Default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="fractureType">
    <xs:annotation><xs:documentation>
      Owned seeded closed-solid fracture. at is composition time, quantized to the first
      physics boundary at or after that time when the source object participates.
      Exactly one rigidBody supplies total mass, collision properties and inherited motion.
      Exterior materials and attributes come from the frozen source surface; cut faces use
      interiorMaterial, with planar UV repeats per scene unit given by interiorUvScale.
      impulseX/Y/Z are the total directed world-scene impulse in kg*scene-unit/second,
      distributed in proportion to piece mass. radialImpulse is a nonnegative total scalar
      impulse, distributed by piece mass along the source-centroid-to-piece directions.
      maxMemoryMiB bounds component geometry/reconstruction admission, not whole-process RSS.
      Fracture is cinematic partitioning, not a material stress/failure calculation.
      `source` names the dynamic rigid body that breaks it (FRX5): the fracture fires on the step after the first impact of
      that body on this one is noticed, above `minImpulse`, the total normal impulse of the pair in one step in
      kg*scene-unit/second (absent: twice the weight of the source in one step, as for a crater from an impact). Its
      time and its push are then derived, so `at`, `radialImpulse` and `impulseX`/`Y`/`Z` are not given (FRX6), and
      `minImpulse` and `energyFraction` belong to a fracture with `source` (FRX7). The pieces keep the velocity the
      body had after the contact, and a part of the kinetic energy of the impact relative to the pair, 1/2 mu v_n^2 (mu
      the reduced mass of the two bodies, v_n the closing speed), `energyFraction` of it (0 to 1; the engine's default
      is 0.3, with no published value, and not an XSD default so that it can be refused without `source`), becomes the
      pieces' push on each other, with no momentum added. The partition is the seeded one of the document and does not
      depend on where the impact was.
    </xs:documentation></xs:annotation>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the dynamic rigid body whose impact breaks this object: the fracture fires on the step after its first impact above minImpulse. With a source, at, radialImpulse and the impulse components are not given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="minImpulse" type="positiveDecimal">
      <xs:annotation><xs:documentation>Total normal impulse of the two bodies in one step, in kg*scene-unit/second, that an impact must exceed to break the object; absent, twice the source body's weight over one step. Only with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="energyFraction" type="unitDecimal">
      <xs:annotation><xs:documentation>Fraction from 0 to 1 of the impact's relative kinetic energy that becomes the pieces' push on each other; 0.3 when absent. Only with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="at" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Composition time in seconds at which the object breaks, moved to the first physics step boundary at or after it when the object takes part in physics. Default 0; not given with source or mode stress.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pieces" default="8">
      <xs:annotation><xs:documentation>Number of pieces, 1 to 4096, of the seeded random partition. Not given with a partition by planes or labels. Default 8.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed of the random partition; the same seed gives the same pieces. Not given with a partition by planes or labels. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interiorMaterial" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the material drawn on the faces that the cut exposes; the outside keeps the object's own surface. Required, except on an object of cells, where it is not allowed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="interiorUvScale" type="positiveDecimal" default="1">
      <xs:annotation><xs:documentation>Number of planar texture repeats per scene unit on the cut faces. Default 1; not allowed on an object of cells.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="partition">
      <xs:annotation><xs:documentation>
        On an object of cells (FRX9): how the body is cut into pieces, `voronoi` (the engine's value: `pieces` seeds drawn from `seed` in the box of the cells, each cell
        to the nearest), `planes` (the cells are the pieces' sides of the planes in `planes`) or `labels` (the cells that have one palette index are one part). A part that is not
        connected by faces is split into its components, so every piece is connected. `pieces` and `seed` belong to voronoi (FRX10). The pieces have the material of
        their cells, and a face that a cut exposes is drawn with the palette like any other: there is no interior material (FRX8).
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="voronoi"/><xs:enumeration value="planes"/><xs:enumeration value="labels"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="planes" type="xs:string">
      <xs:annotation><xs:documentation>
        With partition="planes" (FRX11): up to 63 planes, each four numbers `nx ny nz offset`, in object units (the object's own axes, before its scale, the
        origin at the corner of the cells): a cell is on the positive side of a plane if the dot product of the normal with the centre of the cell, `(key + 1/2) * cellSize`,
        is at least the offset. The normal is not unit and need not be, but it is not all zeros (a plane with no direction cuts nothing), and all the numbers are finite; it is taken to 2^-32 of its largest component.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="labels">
      <xs:annotation><xs:documentation>
        With partition="labels" (FRX12): `material`, the palette index of a cell is its label, so that a model breaks along its materials.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="material"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mode">
      <xs:annotation><xs:documentation>
        What breaks the body: `impact` (the engine's value, and the one of every fracture before this attribute: at a time, or by the impact of `source`) or `stress`
        (FRX13 to FRX15): the body of cells is one rigid body until the load on it makes more stress in a joint between two of its pieces than `strength`, and the
        joints that are over it break together, at the start of the next step. The loads are all of them (the weight, the fields, the contacts, and the one joint of
        the world that may hold the body), so there is no `source`, no time and no push (FRX15); the body is a dynamic body of cells (FRX14). Not an XSD default, so that
        `strength` can be refused without it. The model is a rigid one: no stress wave, no energy kept in the joints, a joint that is in a cycle takes the share of its plane's cut by
        its area and its distance from the centre of the cut, and the stress of a body at rest on its contacts is the one of the way the solver spread the pressure over them
        (a block on a floor is held at the corners of its foot, and reads the bending of a beam on two supports).
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="impact"/><xs:enumeration value="stress"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="strength" type="positiveDecimal">
      <xs:annotation><xs:documentation>
        With mode="stress" (FRX13), required: the principal tension, in pascals, at which a joint between two pieces breaks, from the normal and the bending stress of the
        load on the section of the joint added and the shear and the twist added (Rankine: a brittle joint). A push does not break a joint by itself.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="impulseX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Directed impulse along the scene X axis, in kg*scene-unit/second, given to the pieces in proportion to their mass. Not given with source or mode stress. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="impulseY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Directed impulse along the scene Y axis, in kg*scene-unit/second, given to the pieces in proportion to their mass. Not given with source or mode stress. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="impulseZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Directed impulse along the scene Z axis, in kg*scene-unit/second, given to the pieces in proportion to their mass. Not given with source or mode stress. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radialImpulse" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Outward push, not negative: each piece moves away from the centre of mass of the pieces at this impulse over the object's mass, less their mean velocity, so net momentum is kept. Not given with source or mode stress.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="256">
      <xs:annotation><xs:documentation>Memory budget in MiB for the geometry the cut of a mesh object builds, 1 to 4096; an object of cells does not use it. Default 256.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>

  <xs:complexType name="craterType">
    <xs:annotation><xs:documentation>
      Owned cinematic deformation in object-space scene units, after imported basis/node transforms.
      Let p be the clamped eased fraction of local time from start to end; dimensions grow with p.
      With outward unit n, h=dot(vertex-center,n), r=length(vertex-center-n*h), and B(x)=max(0,1-x*x)^2
      for abs(x)&lt;1 (zero otherwise), displace along n by
      p*(-depth*B(r/(radius*p))+rimHeight*B((r-radius*p)/(rimWidth*p)))*B(h/influenceDepth).
      At p=0 the map is identity. Normals use the inverse-transpose differential; tangents use the differential.
      influenceDepth defaults to twice max(radius,depth,rimHeight); it must be at least twice max(depth,rimHeight) (CRT4, for a crater
      without a `source`; the size of a crater from an impact is not in the document, so its envelope is checked when the crater is made).
      This compact axial envelope preserves orientation and leaves distant back surfaces unchanged.
      maxMemoryMiB bounds additional deformation vertex buffers and admits each rigid collision replacement
      by a conservative geometry-storage estimate; it does not bound source decoding, checkpoint retention or the entire scene.
      Static and kinematic rigid surfaces are rebuilt at fixed physics substeps. Dynamic rigid bodies are rejected.
      Particle collider references interpolate deformed world-space vertices over canonical particle dt intervals,
      with continuous sphere/triangle contacts and barycentric boundary velocities. Particle geometry admission
      also uses this memory allowance. Pyro collider references sample closed midpoint surfaces with
      barycentric material velocities evaluated at MAC faces, reserving retained and step-local geometry
      under both this allowance and the domain meshMemoryMiB. Crater planes retain a centred colliderThickness slab.

      A crater may instead grow from an impact: `source` names the dynamic rigidBody object that makes it. The crater
      begins at the first step in which that body, approaching the owner, pushes on it with more than twice its own
      weight in one step, and centres on the impulse-weighted contact point with its axis along the normal of the owner's
      surface at that point (centerX/Y/Z and normalX/Y/Z are then not read). The normal is the owner's own geometry: for
      a mesh the corner normals of the triangle the point is on, interpolated, so that the same surface in finer or
      coarser triangles gives the same axis; a sphere's radius direction; a box's face. The contact's normal only
      chooses the side, and is used as it is for shapes that give no normal (capsule, cylinder, cone, convex). Radius, depth, rimHeight, rimWidth, start and end are derived and
      so cannot be given; `curve` and `influenceDepth` and `maxMemoryMiB` keep their meaning. The crater is
      Holsapple's scaling law (Annu. Rev. Earth Planet. Sci. 21:333, doi 10.1146/annurev.ea.21.050193.002001, Eq. 18) with
      the constants of the author's calculator note, applied to the body's mass and density, the speed of its approach
      along that normal, `targetMaterial`, and gravity. The dependence of those constants on strength and
      porosity is poorly constrained by the source, so `targetDensity` and `strength` override the table. A crater grows in
      composition time from the impact over the law's formation time, and nothing is simulated before the impact.
      Units: `physics/@pixelsPerMeter` converts scene units to metres for everything the law reads and gives;
      `targetDensity` is kilograms per cubic metre, `strength` pascals, `gravity` metres per second squared (default:
      the magnitude of the physics gravity, an error if that is zero). One impact makes one crater: later contacts of the
      body neither start another nor change this one. A water layer over the owner is not treated: the crater is the
      seabed's. Below roughly 15 to 30 degrees from the surface real impacts ricochet; the law is still applied to the
      normal component, which keeps the size monotone in the angle, and no ricochet is modelled.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID">
      <xs:annotation><xs:documentation>
        Names the crater so that what its impact causes can refer to it: with `source`, the consequences of the
        impact (ejecta, smoke) name this crater instead of repeating its body and material.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Id of the dynamic rigid body whose first hard impact on this object makes the crater; its centre, axis, size and timing are then derived from the impact, so those attributes are not given.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="capture" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        With `source`: the body that makes the crater is arrested by it. From the impact until its velocity relative to
        the owner is zero, and only while its centre is inside the crater's rim radius (the law's, in the owner's frame
        at the point of impact), the body loses velocity at a constant rate of U^2 / (2 d), `U` the body's speed at the
        impact and `d` the crater's depth by the law, never more than stops it in the step, along minus its velocity
        relative to the owner; its spin loses the same share. All of its kinetic energy leaves the body, which is what
        the law spends digging the crater, and none can be added. It is a model of the engine, the mean force of a
        penetration of depth `d` (kinetic energy over depth), not a published law: the projectile neither breaks up
        nor buries itself, it stops and follows the floor of the pit. Without it (the default, the behaviour there
        always was) the body keeps what the contact leaves it, which for a glancing impact is a body that rolls out
        of the crater it made.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="targetMaterial">
      <xs:annotation><xs:documentation>Kind of ground an impact crater is dug in: water, drySand, drySoil, wetSoil, softRock, hardRock, regolith or ice. It sets the constants of the size law; required with source, and not given without it.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="water"/><xs:enumeration value="drySand"/><xs:enumeration value="drySoil"/>
        <xs:enumeration value="wetSoil"/><xs:enumeration value="softRock"/><xs:enumeration value="hardRock"/>
        <xs:enumeration value="regolith"/><xs:enumeration value="ice"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mantle" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>
        Only with `source` (CRT10). The ejecta that the law throws out (0.8 of the crater's volume) come down outside the rim as a mantle
        `t0 (R / r)^3` thick, `R` the rim crest's radius, which is part of the ground (the same deformation as the bowl and the rim) and
        is cut at twenty crest radii and scaled to hold exactly the ejecta's volume; the bowl is made to excavate exactly the law's volume.
        The ejecta particles that come to rest on it are removed (they have become the ground). Off, the ground is as it was.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bulking">
      <xs:annotation><xs:documentation>
        Only with `mantle="true"` (CRT10, CRT11). What is put back, the rim and the mantle together, is this many times the volume that the bowl
        excavates: broken rock takes more room than the rock did (1 to 1.3). Without it the rim keeps the height of the law and the bulking is what
        that asks for: the law's rim (0.326 of the volume for the authored rock in soft rock) and its 0.8 of ejecta, 1.126 there, a value
        derived from the law and inside the physical range. With 1 the rim holds 0.2 of the volume.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double"><xs:minInclusive value="1"/><xs:maxInclusive value="1.3"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="repose">
      <xs:annotation><xs:documentation>
        Only with `source` (CRT10), and not with `mantle="true"` (CRT12): the angle of repose of the debris, in degrees (10 to 60). The ejecta
        particles that come to rest on the ground are removed and their volume (mass over the target's density) is poured onto a
        height field of deposit over the final crater, which relaxes at this angle in a fixed order over sixteen neighbours, without making or losing
        volume; the deposit is added to the height of the ground in the crater's deformation. Absent (the default), the settled particles
        are not removed and nothing is added to the ground. The deposit is as faithful as the grid is fine: a pile of fewer than ten cells'
        radius is not within two degrees of the angle. The particles do not see the deposit, and nor does the rigid world or the ocean.
      </xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:double"><xs:minInclusive value="10"/><xs:maxInclusive value="60"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="targetDensity" type="positiveDecimal">
      <xs:annotation><xs:documentation>Density of the ground in kilograms per cubic metre for an impact crater; it replaces the value that targetMaterial gives. Given only with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="strength" type="nonNegativeDecimal">
      <xs:annotation><xs:documentation>Strength of the ground in pascals for an impact crater; it replaces the value that targetMaterial gives. Given only with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gravity" type="positiveDecimal">
      <xs:annotation><xs:documentation>Gravity in metres per second squared used by the crater-size law of an impact; absent, the magnitude of the physics gravity (an error if that is zero). Given only with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the crater's centre along the X axis of the object, in scene units. Default 0; not read with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the crater's centre along the Y axis of the object, in scene units. Default 0; not read with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="centerZ" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Position of the crater's centre along the Z axis of the object, in scene units. Default 0; not read with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalX" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Component along the X axis of the crater's outward direction, the axis it is dug along; the three components may not all be 0. Default 0 (the defaults together give -Z); not given with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalY" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Component along the Y axis of the crater's outward direction, the axis it is dug along; the three components may not all be 0. Default 0 (the defaults together give -Z); not given with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="normalZ" type="xs:double" default="-1">
      <xs:annotation><xs:documentation>Component along the Z axis of the crater's outward direction, the axis it is dug along; the three components may not all be 0. Default -1 (the defaults together give -Z); not given with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="radius" type="positiveDecimal" default="50">
      <xs:annotation><xs:documentation>Radius of the crater bowl in scene units at full growth; at least rimWidth. Default 50; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="depth" type="nonNegativeDecimal" default="10">
      <xs:annotation><xs:documentation>Depth of the bowl in scene units at full growth. Default 10; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rimHeight" type="nonNegativeDecimal" default="2">
      <xs:annotation><xs:documentation>Height of the raised rim in scene units at full growth. Default 2; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rimWidth" type="positiveDecimal" default="10">
      <xs:annotation><xs:documentation>Half-width of the raised rim in scene units at full growth: the rim is centred on the bowl's radius and extends this far on each side; at most radius. Default 10; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="influenceDepth" type="positiveDecimal">
      <xs:annotation><xs:documentation>Distance in scene units, along the axis on each side of the crater's centre plane, at which the deformation has faded out. Default twice the largest of radius, depth, rimHeight; at least twice max(depth, rimHeight).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="start" type="nonNegativeDecimal" default="0">
      <xs:annotation><xs:documentation>Local time in seconds at which the crater begins to grow; before it the surface is undeformed. Default 0; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="end" type="nonNegativeDecimal" default="1">
      <xs:annotation><xs:documentation>Local time in seconds at which the crater reaches full size; it must be later than start. Default 1; derived, so not given, with source.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="curve" default="ease-in-out">
      <xs:annotation><xs:documentation>Easing of the crater's growth: linear, ease-in, ease-out, ease-in-out (default) or step. It runs from start to end, or over the impact's own growth time with source; not given in an object of cells.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="linear"/><xs:enumeration value="ease-in"/><xs:enumeration value="ease-out"/><xs:enumeration value="ease-in-out"/><xs:enumeration value="step"/>
    </xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="maxMemoryMiB" default="128">
      <xs:annotation><xs:documentation>Memory budget in MiB for the deformation's extra vertex buffers and the collision geometry built from the deformed surface, including particle and smoke colliders; 1 to 4096. Default 128.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <!-- ===================================================== programs (SREPs 66 and 69, version 1.6) -->
  <xs:attributeGroup name="programAttributes">
    <xs:attribute name="src" type="xs:anyURI" use="required">
      <xs:annotation><xs:documentation>Location of the WebAssembly module to run; it must be a local file, and a remote URI is refused.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="sha256Type" use="required">
      <xs:annotation><xs:documentation>Lowercase hex SHA-256 of the module's bytes; the module is not run, and the render fails, if the file does not match.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0">
      <xs:annotation><xs:documentation>Seed, combined with the project seed, of the module's random number generator; the same seeds give the same output. Default 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fuel" default="1000000000">
      <xs:annotation><xs:documentation>Instructions a call of the module may execute (SREP 66, Determinism 4).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:unsignedLong">
        <xs:minInclusive value="1"/><xs:maxInclusive value="1000000000000"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="memoryLimit" default="64">
      <xs:annotation><xs:documentation>MiB of linear memory the module may hold (a multiple of 64 KiB pages: 16 pages per MiB).</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4096"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="outputSha256" type="sha256Type">
      <xs:annotation><xs:documentation>SHA-256 of the output that a build or data program returns; the render fails if the output hashes differently, which pins the result across hosts.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>
  <xs:complexType name="programNodeType">
    <xs:annotation><xs:documentation>
      Runs the WebAssembly module @src (SHA-256 @sha256) under the determinism rules of SREP 66. In build mode it runs
      once when the document is built and the scene-render nodes it returns are this node's children, drawn as a
      group. With mode="step" (SREP 69) it keeps state, advances stepsPerFrame steps per frame after prewarm steps,
      and draws the width x height RGBA picture its frame export returns.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="param" type="paramValueType"/>
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attributeGroup ref="programAttributes"/>
    <xs:attribute name="mode" default="build">
      <xs:annotation><xs:documentation>build (default) runs the module once when the document is built and draws the nodes it returns as a group; step keeps state across frames and draws a picture.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="build"/><xs:enumeration value="step"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Width in pixels of the picture a stepping program draws; required with mode step.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="height" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Height in pixels of the picture a stepping program draws; required with mode step.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="stepsPerFrame" default="1">
      <xs:annotation><xs:documentation>Number of steps a stepping program advances at each frame in which it is drawn; 1 to 10000. Default 1; only with mode step.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="10000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="prewarm" default="0">
      <xs:annotation><xs:documentation>Number of steps a stepping program runs before its first frame, up to 10000000. Default 0; only with mode step.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="10000000"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="blend" type="blendType" default="normal">
      <xs:annotation><xs:documentation>Blend mode used to composite the program's output, a group in build mode or the picture in step mode, onto what is below it. Default normal.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="programDataType">
    <xs:annotation><xs:documentation>Runs the module once; the JSON rows it returns are a data source for repeat/@over.</xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="param" type="paramValueType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation><xs:documentation>Unique name of the data source; a repeat refers to it by this id to iterate over the rows the module returns.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="programAttributes"/>
  </xs:complexType>

</xs:schema>
